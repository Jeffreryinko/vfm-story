[["k5534","마르쿠스 아우렐리우스",121,180,0,"eu",["IT"],0,"p","",176,9072,1,"","마르쿠스 아우렐리우스 안토니누스(라틴어: Marcus Aurelius Antoninus, 121년 4월 26일 - 180년 3월 17일)는 로마 제국의 제16대 황제(161 - 180년)이자 스토아",161],["k83198","냉장고",150,null,0,"xx",[],6,"e","~",144,4762,1,"","냉장고(冷藏庫,영어: refrigerator, 문화어: 랭장고)는 식품이나 약품 등을 저온에서 신선하게 저장 · 보관하는 상자 모양의 기계 장치다.",150],["k268845","갈레노스",129,300,0,"eu",["IT","TR"],0,"p","",135,1131,1,"","클라우디오스 갈레노스(라틴어: Claudius Galenus, 그리스어: Κλαύδιος Γαληνός, 129년 9월 1일 ~ 199년?)는 로마 제국 당시의 고대 그리스의 의학자이자 철학자이다.",169],["k112753","나가르주나",150,250,0,"sa",["IN"],7,"p","~",122,2661,1,"","나가르주나(산스크리트어: नागार्जुनः), 또는 용수(龍樹: 150년경 ~ 250년경?)는 중관(中觀 · Madhyamaka)을 주창한 인도의 불교 승려이다.",190],["k265240","루키아노스",120,180,0,"me",["TR"],9,"p","~",106,321,1,"","루키아노스(그리스어: Λουκιανός, 라틴어: Lucianus, 125년 ~ 180년 이후)는 로마 시대의 풍자 작가이다.",160],["k5836","셉티미우스 세베루스",146,211,0,"eu",["IT","LY"],0,"p","",93,1436,1,"","루키우스 셉티미우스 세베루스(Lucius Septimius Severus, 146년 4월 11일 - 211년 2월 4일)는 193년부터 211년까지의 로마 황제이다.",186],["k319646","아풀레이우스",125,170,0,"eu",["IT","TN","DZ"],6,"p","~",102,193,1,"","루키우스 아풀레이우스(Lucius Apuleius)는 고대 로마의 소설가이다.",165],["k5829","콤모두스",161,192,0,"eu",["IT"],0,"p","",85,4960,1,"","콤모두스(Commodus)는 서기 177년부터 192년까지 재위한 제17대 로마 황제이며, 처음에는 아버지 마르쿠스 아우렐리우스와 명목 상의 공동 황제로 있었고 180년부터는 단독 재위하였다.",192],["k42367","조조",155,220,0,"ea",["CN"],0,"p","",69,11611,1,"","조조(중국어: 曹操, 병음: Cáo Cāo 차오차오[*], 155년~220년 음력 1월 23일)는 중국 후한 말의 군웅, 정치인이다.",195],["k148614","이레네오",130,202,0,"eu",["IT","TR"],7,"p","~",78,1067,1,"","성 이레네오 또는 이레네우스(그리스어: Ειρηναίος Λουγδούνου 에이레나이오스[*], 추정 생존연대 130년 ~ 202년)는 로마 제국의 영토였던 갈리아 지방 루그두눔(오늘날의 프랑스 ",170],["k5834","디디우스 율리아누스",133,193,0,"eu",["IT"],0,"p","",79,862,1,"","디디우스 율리아누스(라틴어:Didius Julianus, 133년 1월 30일 ~ 193년 6월 1일)는 로마 제국의 열아홉 번째 황제이다.",173],["k5832","페르티낙스",126,193,0,"eu",["IT"],0,"p","",78,799,1,"","푸블리우스 헬비우스 페르티낙스(Publius Helvius Pertinax, 126년 8월 1일 - 193년 3월 28일)는 로마의 군사 지휘관 및 193년의 3개월 간 황좌를 차지한 로마의 황제이",166],["k189638","루키우스 베루스",130,169,0,"eu",["IT"],0,"p","",75,866,1,"","루키우스 아우렐리우스 베루스(라틴어: Lucius Aurelius Verus 루키우스 웨루스[*], 130년 12월 15일 ~ 169년 1월/2월)는 161년부터 169년까지 입양 형제 마르쿠스 아",169],["k31221","교황 히지노",136,142,0,"eu",["IT","GR"],7,"p","~",83,145,1,"","교황 히지노(라틴어: Hyginus, 이탈리아어: Igino)는 제9대 교황(재위: 136년/138년 - 140년/142년)이다.",176],["k288747","알렉산드리아의 클레멘스",150,215,0,"eu",["IT","GR"],7,"p","~",76,409,1,"","알렉산드리아의 클레멘스 (Clement;150 A.D.–c. 215 A.D)는 알렉산드리아 학파의 기독교 신학자(Christian theologian)였으며 유명한 알렉산드리아 교리문답 신학교(Ca",190],["k31220","교황 텔레스포로",125,130,0,"eu",["IT"],7,"p","~",83,87,1,"","교황 텔레스포로(라틴어: Telesphorus, 이탈리아어: Telesforo)는 제8대 교황(재위: 125년 - 137년)이다.",165],["k226290","디오 카시우스",150,235,0,"eu",["IT","TR"],0,"p","~",76,187,1,"","디오 카시우스(고대 그리스어: Δίων ὁ Κάσσιος, 155년에서 163년/164년사이~ 229년 이후), 혹은 카시우스 디오, 카시우스 디오 코케이아누스(Cassius Dio Cocceian",190],["k103762","참파",192,1832,0,"xx",[],0,"s","",65,1497,1,"","참파 왕국( - 王國, 참어: Campadesa, 산스크리트어: चम्पा, 베트남어: Chiêm Thành / 占城, 영어: Kingdom of Champa)은 베트남 중부 지방에 위치해 있던 말",192],["k31225","교황 소테르",200,null,0,"eu",["IT"],7,"p","~",80,73,1,"","교황 소테르(라틴어: Soterius, 이탈리아어: Sotero)는 제12대 교황(재위: 166년경 - 174년/175년)이다.",175],["k255104","고르디아누스 1세",159,238,0,"eu",["IT","TR"],0,"p","",69,115,1,"","고르디아누스 1세(라틴어: Gordianus I, 159년 ~ 238년 4월 12일)는 로마 제국의 스물 여섯 번째 공동 황제이다.",199],["k884965","파우사니아스 (지리학자)",110,180,0,"eu",["IT"],6,"p","~",66,195,1,"","파우사니아스 (/pɔːˈseɪniəs/; 고대 그리스어: Παυσανίας Pausanías)는 2세기 그리스의 여행자이자 지리학자로, 하드리아누스, 안토니누스 피우스, 마르쿠스 아우렐리우스와 동시",150],["k263152","황건적의 난",184,205,0,"ea",["CN"],7,"e","",40,2532,1,"","황건적의 난(Yellow Turban Rebellion)은 고대 중국 후한 말기에 일어난 농민 반란이다.",184],["k45935","고국천왕",200,null,0,"ea",["KR"],0,"p","~",23,3434,0,"","고국천왕(故國川王, 176년 이전~197년 5월, 재위: 179년 12월~197년 5월)은 고구려의 제9대 국왕이다.",197],["k4190312","페스켄니우스 니게르",135,194,0,"eu",["IT"],0,"p","~",52,95,1,"","가이우스 페스켄니우스 니게르 (Gaius Pescennius Niger, 135년경 ~ 194년)는 다섯 황제의 해 기간 중인 서기 193년부터 194년까지의 로마의 황위 주장자 중 한 명이다.",175],["k263034","아울루스 겔리우스",130,180,0,"eu",["IT"],1,"p","~",54,63,1,"","아울루스 겔리우스(Aulus Gellius, 125?-165?)는 고대 로마의 수필가이다.",170],["k73016","동탁",139,192,0,"ea",["CN"],0,"p","",31,4169,1,"","동탁(董卓, 139년 ~ 192년 5월 22일(음력 4월 23일))은 중국 후한 말의 군웅, 정치인이다.",179],["k4909","진구 황후",170,null,0,"ea",["JP"],8,"e","~",38,963,1,"","진구 황후(일본어: 神功皇后, じんぐうこうごう, 170년? ~ 269년? 6월 3일(음력 4월 17일))은 이름은 오키나가타라시노히메미코토(気長足姫尊, 息長足姬尊), 오시타라노미코토(大帯比売命)로 ",170],["k2681271","안토니누스 역병",165,180,0,"eu",["IT"],10,"e","",42,364,1,"","안토니누스 역병(영어: The Antonine Plague)은 165년에서 180년 사이에 발생한 전염병이다.",165],["k3226937","다섯 황제의 해",193,null,0,"eu",[],1,"e","",39,466,1,"","다섯 황제의 해(라틴어: Annus quinque imperatorum, Year of the Five Emperors)는 주후 193년-197년까지의 로마제국의 내전을 말한다.",193],["k100162","원소 (후한)",154,202,0,"ea",["CN"],0,"p","",32,1725,1,"","원소(袁紹, ? ~ 202년 6월 28일(음력 5월 21일))는 후한 말의 군웅이다.",194],["k3275117","소 파우스티나",125,175,0,"eu",["IT"],0,"p","",38,341,1,"","안니아 갈레리아 파우스티나 미노르 (Annia Galeria Faustina Minor, 서기 130년경 9월 21일 — 175/176년) 혹은 소 파우스티나(小 -)는 161년부터 사망 시기까지 ",165],["k2696201","가이우스 (법률가)",120,180,0,"eu",["IT"],9,"p","~",46,66,1,"","가이우스 (Gaius, AD 130–180)은 유명한 로마 법학자였다.",160],["k91544","손견",155,192,0,"ea",["CN"],0,"p","",27,2507,1,"","손견(孫堅, 156년? ~ 192년?)은 중국 후한 말의 군웅으로, 자는 문대(文臺)이며 양주(揚州) 오군(吳郡) 부춘현(富春縣) 사람이다.",192],["k2029924","안티오키아의 테오필로스",200,null,0,"xx",[],7,"p","~",46,46,1,"","안티오키아의 테오필로스 (그리스어: Θεόφιλος ὁ Ἀντιοχεύς)는 안티오키아 대주교이다.",183],["k188537","주아이 천황",149,200,0,"ea",["JP"],8,"p","",35,364,1,"","주아이 천황(일본어: 仲哀天皇, ? ~ 200년 음력 2월 6일))은 일본의 제14대 천황(재위: 192년 음력 1월 11일 ~ 200년 음력 2월 6일)으로 전하는 인물이다.",189],["k1331919","마르쿠스 아우렐리우스 기마상",173,null,0,"eu",["IT"],0,"e","~",33,531,1,"","마르쿠스 아우렐리우스 기마상(이탈리아어: Statua equestre di Marco Aurelio)은 이탈리아 로마의 캄피돌리오 언덕에 있는 기마상이다.",173],["k68290","후한 영제",156,189,0,"ea",["CN"],0,"p","",29,1094,0,"","한 효령황제 유굉(漢 孝靈皇帝 劉宏, 156년 ~ 189년, 재위 168년 ~ 189년)은 중국 후한의 제12대 황제이다.",189],["k100215","원술",155,199,0,"ea",["CN"],0,"p","",26,1728,1,"","원술(袁術, 155년 ~ 199년)은 중국 후한 말의 군웅으로 자는 공로(公路)이며 예주 여남군 여양현(汝陽縣) 사람이다.",195],["k99611","하후돈",155,220,0,"ea",["CN"],1,"p","",24,2167,1,"","하후돈(중국어: 夏侯惇, 병음: Xiàhóu Dūn 샤허우둔[*], ?~220년 6월 13일)은 중국 후한 말 조조 휘하의 장군 겸 정치인이다.",195],["k144866","볼로가세스 5세",130,208,0,"me",["TR"],0,"p","",41,81,1,"","파르티아의 볼로가세스 5세(재위: 191년 ~ 208년)는 파르티아 왕조의 아르메니아 카데트 계열의 구성원인 아르메니아의 볼로가세스 1세의 아들이다.",170],["k3292472","마르코만니 전쟁",166,180,0,"eu",["DE","IT"],1,"e","",36,194,1,"","마르코만니 전쟁(bellum Germanicum et Sarmaticum, \"게르만 및 사르마티아 전쟁\")은 서기 166년경부터 180년까지 지속된 연속된 전쟁이다.",166],["k1273520","마르쿠스 아우렐리우스 원주",193,null,0,"eu",["IT"],0,"e","",39,96,1,"","마르쿠스 아우렐리우스 원주(라틴어: Columna Centenaria Divorum Marci et Faustinae, 이탈리아어: Colonna di Marco Aurelio)는 이탈리아 로마 콜",193],["k117678","아폴로니아",150,249,0,"af",["EG"],7,"p","~",35,205,1,"","아폴로니아는 3세기 이집트의 알렉산드리아에서 활동한 그리스도인이며, 로마 황제 데키우스의 기독교 박해 기간 도중에 동정녀로서 순교하였다.",190],["k72799","초고왕",150,214,0,"ea",["KR"],0,"p","~",17,650,0,"","초고왕(肖古王, ? ~ 214년, 재위: 166년 ~ 214년)은 백제의 제5대 국왕이다.",190],["k690481","후한 환제",132,168,0,"ea",["CN"],0,"p","",30,532,0,"","한 위종 효환황제 유지(漢 威宗 孝桓皇帝 劉志, 132년 ~ 168년)는 후한의 11대 황제이다.",168],["k5423","지마 이사금",134,134,0,"ea",["KR"],0,"p","~",16,761,1,"","지마이사금(祗摩泥師今, ?~134년, 재위: 112년~134년)은 신라의 제6대 국왕이다.",174],["k3673522","프톨레마이오스의 세계 지도",150,null,0,"eu",["IT"],6,"e","",27,882,1,"","프톨레마이오스의 세계 지도는 서기 2세기 그리스-로마 시대에 제작된 세계 지도이다.",150],["k264094","아이밀리우스 파피니아누스",142,211,0,"eu",["IT","SY"],9,"p","",42,42,1,"","아이밀리우스 파피니아누스(Papinianus, Aemilius, 142년 ~ 212년)는 고대 로마의 법학자이다.",182],["k75965","황충",148,220,0,"ea",["CN"],1,"p","",20,2867,1,"","황충(중국어 정체자: 黃忠, 간체자: 黄忠, 병음: Huáng Zhōng 황중[*], ?~220년)은 중국 후한과 촉한의 군인으로 유비 휘하의 장군이다.",188],["k72798","구수왕",150,234,0,"ea",["KR"],0,"p","~",16,553,0,"","구수왕(仇首王, ? ~ 234년, 재위: 214년 ~ 234년)은 백제의 제6대 국왕이다.",190],["k3296921","루킬라",150,182,0,"eu",["IT"],4,"p","",29,450,1,"","안니아 아우렐리아 갈레리아 루킬라(라틴어: Annia Aurelia Galeria Lucilla, 148년 혹은 150년 3월 7일 – 182년) 혹은 루킬라는 로마 황제 마르쿠스 아우렐리우스와 황",182],["k185211","장각",200,null,0,"ea",["CN"],0,"p","~",24,1164,1,"","장각(張角, ? ~ 184년)은 중국 후한 말기의 종교 지도자로, 기주 거록군 사람이다.",184],["k2977530","가격 혁명",150,null,0,"xx",[],2,"e","~",27,638,0,"","가격 혁명(價格革命, 영어: Price Revolution, 스페인어: Revolución de los precios)은 15세기 하반기에서 17세기 상반기 사이에 서유럽의 물가가 폭등한 인플레이션",150],["k90898","계왕",150,346,0,"ea",["KR"],0,"p","~",14,768,0,"","계왕(契王, ? ~ 346년, 재위 : 344년 10월~346년 9월)은 백제의 제12대 국왕이다.",190],["k3302615","아비디우스 카시우스",130,175,0,"eu",["IT","SY"],0,"p","",38,75,0,"","가이우스 아비디우스 카시우스 (Gaius Avidius Cassius, 서기 130년경 – 175년 7월)는 시리아 출신의 로마 제국 장군이자 제위 찬탈자이다.",170],["k99574","후한 소제 (13대)",176,190,0,"ea",["CN"],0,"p","",27,597,0,"","한 소황제 유변(漢 少皇帝 劉辯, 176년 ~ 190년 3월 6일)은 후한의 제13대 황제이다.",190],["k3970590","유다 하나시",135,250,0,"me",["IL"],0,"p","",34,130,1,"","유다 하나시(히브리어: יְהוּדָה הַנָּשִׂיא, Yəhūḏā hanNāsīʾ  예후다 하나시) 또는 유다 1세는 줄여서 렙비 또는 랍비로 알려진 2세기의 랍비 (제5 세대 탄나) 및 '",175],["k5468","벌휴 이사금",150,196,0,"ea",["KR"],0,"p","~",13,717,0,"","벌휴이사금(伐休泥師今, ?~196년, 재위: 184년~196년)은 신라의 제9대 왕이며, 이사금의 칭호를 사용한 7번째 왕이다.",190],["k191413","채옹",133,192,0,"ea",["CN"],0,"p","",25,657,1,"","채옹(蔡邕, 133년 ~ 192년)은 후한 말기의 학자로, 자는 백개(伯喈)이며 연주 진류군 어현(圉縣) 사람이다.",173],["k3680480","브루티아 크리스피나",164,191,0,"eu",["IT"],8,"p","",35,92,1,"","브루티아 크리스피나 (Bruttia Crispina, 164년 – 191년)는 178년부터 191년까지 로마 황제 콤모두스의 배우자로서 재위했던 로마 황후이다.",191],["k132287","유표",142,208,0,"ea",["CN"],0,"p","",23,911,1,"","유표(劉表, 142년 ~ 208년 음력 8월)는 중국의 후한 말의 군웅, 관료로 자는 경승(景升)이며 연주 산양군 고평현(高平縣) 사람이다.",182],["k3306661","아일리우스 아리스티데스",117,189,0,"eu",["IT","TR"],9,"p","",34,98,1,"","푸블리우스 아일리우스 아리스티데스 테오도로스(그리스어: Αἴλιος Ἀριστείδης; 서기 117년–181년)는 그리스인 연설가이자 저술가로, 네로 재위부터 대략 서기 230년까지 번성했던 유명",157],["k3311014","볼로가세스 4세",150,191,0,"me",["IR"],1,"p","~",37,54,1,"","볼로가세스 5세(𐭅𐭋𐭂𐭔)는 147년부터 191년까지 재위한 파르티아 제국의 샤한샤이다.",190],["k6498","거등왕",150,259,0,"ea",["KR"],0,"p","~",11,647,0,"","거등왕(居登王, ? ~ 253년 9월 17일)은 금관가야의 제2대 국왕(재위: 199년 3월 13일 ~ 253년 9월 17일)이다.",190],["k2530784","장중경",150,219,0,"ea",["CN"],6,"p","",26,356,1,"","장중경(張仲景, 150년 ~ 219년)의  본명은 장기(張機)이며 조조, 유비, 화타와 동시대 사람으로 중국 후한 말기의 유명한 중의사이다.",190],["k73012","공융",153,208,0,"ea",["CN"],0,"p","",22,644,1,"","공융(孔融, 153년~208년 9월 26일(음력 8월 29일))은 중국 후한 말의 정치인으로 자는 문거(文擧)이며 예주 노국 사람이다.",193],["k73007","가후",147,223,0,"ea",["CN"],0,"p","",18,1209,1,"","가후(중국어 정체자: 賈詡, 간체자: 贾诩, 병음: Jiǎ Xǔ 자쉬[*], 147년~223년)는 중국 후한 말과 조위의 정치가로, 자는 문화(중국어: 文和, 병음: Wénhé 원허[*])이다.",187],["k165074","고순",200,null,0,"xx",[],1,"p","~",22,546,0,"","고순(高順, ? ~ 199년 2월 7일(198년 음력 12월))은 중국 후한 말의 무장이다.",199],["k188609","하진 (후한)",135,189,0,"ea",["CN"],0,"p","",20,619,0,"","하진(何進, ? ~ 189년 9월 22일(음력 8월 25일))은 중국 후한 황실의 친척으로, 자는 수고(遂高)이며 남양군 완현(宛縣) 사람이다.",175],["k73017","마등",156,212,0,"ea",["CN"],0,"p","",19,733,0,"","마등(馬騰, 2세기 ~ 212년)은 중국 후한 말의 군웅으로 자는 수성(壽成)이며 사례 우부풍 무릉현(茂陵縣) 사람이다.",196],["k189178","왕윤",137,192,0,"ea",["CN"],0,"p","",16,910,1,"","왕윤(王允, 137년 ~ 192년 7월 4일(음력 6월 7일))은 중국 후한 말의 정치가로, 자는 자사(子師)이며 병주 태원군 기현(祁縣) 사람이다.",177],["k175198","종요",151,230,0,"ea",["CN"],1,"p","",18,532,1,"","종요(鍾繇, 151년 ~ 230년)는 중국 후한 말 ~ 삼국시대 위나라의 정치인이자 서예가로 자는 원상(元常)이며 예주 영천군 장사현(長社縣) 사람이다.",191],["k120847","진궁",150,199,0,"ea",["CN"],0,"p","~",15,931,1,"","진궁(陳宮, ? ~ 199년 2월 7일(198년 음력 12월))은 중국 후한 말 조조 휘하의 정치인이다.",190],["k1053327","후한말",189,220,0,"ea",["CN"],10,"t","",16,762,0,"","후한말(後漢末)이란 고대 중국 역사에서 184년 ~ 220년까지의 시기를 의미한다.",189],["k60960","전위 (후한)",200,null,0,"ea",["CN"],1,"p","~",18,422,1,"","전위(典韋, ? ~ 197년)는 중국 후한 말 조조 휘하의 군인으로 연주 진류군 기오현(己吾縣) 사람이다.",197],["k132071","황개",145,222,0,"ea",["CN"],1,"p","",17,475,1,"","황개(黃蓋, ? ~ ?)는 중국 후한 말기의 군인으로, 자는 공복(公覆)이며 영릉군 천릉현(泉陵縣) 사람이다.",185],["k787235","영사황후",200,null,0,"ea",["CN"],8,"p","~",19,307,0,"","영사황후 하씨(靈思皇后 何氏, 155년 ~ 189년 9월 30일)는 후한 영제의 황후로 소제의 어머니이다.",189],["k282850","정현 (후한)",127,200,0,"ea",["CN"],9,"p","",18,344,0,"","정현(鄭玄, 127년 ~ 200년)은 중국 후한 말기의 학자로, 자는 강성(康成)이며 북해국 고밀현(高密縣) 사람이다.",167],["k366569","도원결의",184,null,0,"ea",["CN"],10,"e","~",12,1035,1,"","도원결의(桃園結義)는 후한 말 영제시대 황건적이 일어나 유주에서 의병을 모집하고 있었던 때에 유비, 관우, 장비가 장비의 집 뒤뜰에서 만나 의형제를 맺은 일을 말한다.",184],["k264992","좌원 전투",172,null,0,"ea",["KR"],1,"e","",7,263,0,"","좌원 전투(坐原大捷)는 고구려 신대왕 8년인 172년, 한나라의 침입에 맞서 명림답부의 지휘 아래 고구려가 대승을 거둔 전투이다.",172],["k177227","화웅",200,null,0,"xx",[],1,"p","~",16,468,0,"","화웅(華雄, ? ~ 191년 음력 2월)은 중국 후한 말의 무장으로 양인 전투에서 전사하였다.",191],["k296088","이각 (후한)",200,null,0,"ea",["CN"],0,"p","~",16,463,1,"","이각(李傕, ? ~ 198년)은 중국 후한 말기의 군인으로, 자는 치연(稚然)이며 북지군 사람이다.",197],["k284183","하비 전투",199,null,0,"ea",["CN"],1,"e","",14,604,0,"02-07","하비 전투(下邳 戰鬪)는 198년 서주의 하비를 목표로 조조와 여포가 싸운 전투로, 조조는 이 전투에서 승리하여 서주를 되찾고 여포는 처형된다.",199],["k141559","순유",157,214,0,"ea",["CN"],0,"p","",14,502,1,"","순유(荀攸, 157년 ~ 214년)는 중국 후한 말기의 관료로, 자는 공달(公達)이며 예주 영천군 영음현(潁陰縣) 사람이다.",197],["k100515","도겸 (삼국지)",132,194,0,"ea",["CN"],0,"p","",13,561,0,"","도겸(중국어 정체자: 陶謙, 간체자: 陶谦, 병음: Táo Qiān 타오첸[*], 132년~194년)은 중국 후한 말기의 관료로, 자는 공조(중국어: 恭祖, 병음: Gōngzǔ 궁쭈[*])이다.",172],["k238472","맹달",150,228,0,"ea",["CN"],0,"p","~",11,752,1,"","",190],["k300062","곽사",146,197,0,"ea",["CN"],0,"p","",14,422,1,"","곽사(郭汜, ? ~ 197년)은 중국 후한 말기의 군인으로, 양주 장액군 사람이다.",186],["k194653","노식",159,192,0,"ea",["CN"],9,"p","",13,502,0,"","노식(盧植, 123년 이전 ~ 192년)은 중국 후한 말의 관료이자 중랑장으로 자는 자간(子幹)이며 유주 탁군 탁현(涿縣) 사람이다.",192],["k70941","조앙 (자수)",177,197,0,"xx",[],1,"p","~",16,270,0,"","풍민왕 조앙(豊愍王 曹昻, 178년 이전 ~ 197년)은 후한 말기의 군인이자 조위의 추존 제후왕으로, 자는 자수(子脩)이며 패국 초현(譙縣) 사람이다.",197],["k99734","조숭",200,null,0,"ea",["CN"],0,"p","~",14,383,0,"","조위 태황제 조숭(曹魏太皇帝曹嵩, ?~193년)은 후한 말의 정치가로, 자는 거고(巨高)이며 예주(豫州) 패국(沛國) 초현(譙縣) 사람이다.",194],["k303299","정원 (후한)",200,null,0,"ea",["CN"],0,"p","~",17,206,1,"","정원(丁原, ? ~ 189년)은 후한 말기의 정치가로, 병주 자사를 역임했다.",189],["k162786","사섭",137,226,0,"ea",["CN"],0,"p","",14,364,1,"","사섭(士燮, 137년 ~ 226년 음력 11월) 또는 시 니엡(베트남어: Sĩ Nhiếp)은 중국 후한 말의 군웅으로, 자는 위언(威彦)이며 창오군 광신현(廣信縣) 사람이다.",177],["k115912","유언 (삼국지)",200,null,0,"ea",["CN"],0,"p","~",13,408,0,"","유언(劉焉, ? ~ 194년)은 중국 후한 말의 군웅으로 자는 군랑(君郞), 형주 강하군 경릉현(竟陵縣) 사람이다.",194],["k427596","양기",159,159,0,"ea",["CN"],0,"p","~",14,330,0,"","양기(梁冀, ? ~ 159년)는 후한 중기의 관료이자 외척으로, 자는 백탁(伯卓)이며, 안정군 오지현(烏枝縣) 사람이다.",199],["k330569","왕랑",152,228,0,"ea",["CN"],0,"p","",13,369,0,"","왕랑(王朗, 167년 ~ 228년)은 중국 후한 말기 ~ 조위의 정치가로, 자는 경흥(景興)이며 서주 동해국 담현(淡縣) 사람이다.",192],["k215830","진군",150,236,0,"ea",["CN"],0,"p","~",12,445,0,"","진군(陳羣, ? ~ 236년)은 중국 후한 말기 ~ 조위의 관료로, 자는 장문(長文)이며 예주 영천군 허현(許縣) 사람이다.",190],["k170822","이엄",150,234,0,"ea",["CN"],0,"p","~",10,613,0,"","",190],["k73006","장소 (동오)",156,236,0,"ea",["CN"],0,"p","",13,337,1,"","장소(張昭, 156년 ~ 236년)는 중국 삼국시대 오나라의 문관이다.",196],["k189396","한복 (삼국지)",149,191,0,"ea",["CN"],0,"p","",14,277,0,"","한복(韓馥, ? ~ ?)은 중국 후한 말의 정치인이다.",189],["k3694334","단석괴",141,181,0,"xx",[],0,"p","",12,372,0,"","단석괴(檀石槐, 136~181)는 중국 동한(東漢) 시기에 살았던 선비족(鮮卑族) 수령 중 한 명이다.",181],["k830253","동태후 (후한)",200,null,0,"ea",["CN"],8,"p","~",11,443,0,"","",189],["k193743","정욱 (조위)",141,220,0,"ea",["CN"],0,"p","",12,365,0,"","정욱(程昱, 141년 ~ 220년)은 중국 후한 말기 ~ 조위 초기의 관료로, 자는 중덕(仲德)이며 연주 동군 동아현(東阿縣) 사람이다.",181],["k574768","무선황후",159,230,0,"ea",["CN"],0,"p","",14,243,0,"","무선황후 변씨(武宣皇后 卞氏, 160년 ~ 230년)는 중국 후한 말기의 제후왕 조조의 정비로, 조조 사후 조위에서 태황태후까지 높여졌다.",199],["k474396","로카크셰마",147,200,0,"ea",["CN"],7,"p","",21,62,0,"","로카크셰마(산스크리트어: लोकक्षेम) 또는 지루가참(支婁迦讖)은 후한시대에 중국에 온 역경승의 하나이다.",187],["k306431","양의",150,235,0,"ea",["CN"],0,"p","~",11,404,1,"","",190],["k189253","유요 (삼국지)",156,197,0,"ea",["CN"],0,"p","",11,399,0,"","",196],["k3095958","마르키아 (콤모두스의 정부)",200,null,0,"eu",["IT"],0,"p","~",20,69,1,"","마르키아 아우렐리아 세이오니아 데메트리아스(Marcia Aurelia Ceionia Demetria)는 로마 제국의 17대 황제인 콤모두스의 정부였다.",193],["k3146195","임읍국",192,629,0,"sa",["VN"],0,"e","",11,371,1,"","",192],["k73008","간옹",150,null,0,"ea",["CN"],0,"p","~",10,441,1,"","",190],["k159296","예형",173,198,0,"xx",[],9,"p","",9,531,1,"","",198],["k525914","화흠",157,232,0,"ea",["CN"],0,"p","",11,351,0,"","",197],["k312023","포신",152,192,0,"ea",["CN"],0,"p","",13,228,0,"","포신(鮑信, 152년 ~ 192년)은 중국 후한 말기의 군벌로, 태산군 평양현(平陽縣) 사람이다.",192],["k132286","어부라",150,195,0,"ea",["CN"],10,"p","",13,225,0,"","어부라(於夫羅, 150년 ~ 195년)는 후한 시대의 남흉노의 선우이다.",190],["k238241","사마방",149,219,0,"ea",["CN"],0,"p","",9,419,0,"","",189],["k473002","동소",156,236,0,"ea",["CN"],0,"p","",12,227,0,"","동소(董昭, 156년 ~ 236년)은 중국 삼국시대 조위의 관료로, 자는 공인(公仁)이며 연주 제음군 정도현(定陶縣) 사람이다.",196],["k226600","엄안",153,234,0,"ea",["CN"],1,"p","",11,270,1,"","",193],["k1310060","조조의 서주 침공",193,194,0,"ea",["CN"],1,"e","",6,689,1,"","",193],["k546688","장억",150,255,0,"ea",["CN"],0,"p","~",11,260,1,"","",190],["k228528","손건",150,214,0,"ea",["CN"],0,"p","~",10,313,1,"","",190],["k200225","동윤",150,246,0,"ea",["CN"],0,"p","~",11,255,1,"","",190],["k3731423","타우로볼리움",159,null,0,"xx",[],7,"e","~",21,36,1,"","2세기에서 4세기 시기 로마 제국에서, 타우로볼리움(taurobolium)은 소를 제물로 바치는 행위를 포함한 의식들을 일컬으며, 2세기 중엽 이후로는 대지모신 숭배와 연관지어졌다.",159],["k3656084","유스도",113,null,0,"xx",[],7,"p","~",17,77,0,"","유스도 또는 유대인 이름이 유다인 예루살렘의 유스투스 1세 주교는 2세기 유대 기독교 지도자였으며 대부분의 기독교 전통에 따르면 예루살렘의 세 번째 주교였으며 주교직은 서기 107-113년경에 맡았",153],["k186889","문빙",150,null,0,"ea",["CN"],0,"p","~",10,287,0,"","",190],["k247541","희지재",150,null,0,"xx",[],0,"p","~",8,412,0,"","",190],["k194930","주준",149,195,0,"ea",["CN"],0,"p","",11,229,0,"","",189],["k3275669","로마-파르티아 전쟁 (161년-166년)",161,166,0,"me",["TR","IT"],1,"e","",17,71,0,"","로마-파르티아 전쟁 (161년-166년) (혹은 루키우스 베루스의 파르티아 전쟁)은 아르메니아와 상메소포타미아를 두고 로마 제국과 파르티아 제국 간에 일어났던 전쟁이다.",161],["k285555","장막 (삼국지)",155,195,0,"ea",["CN"],0,"p","",11,221,0,"","",195],["k482837","장량 (후한)",150,184,0,"xx",[],0,"p","~",11,219,0,"","",184],["k481268","장보 (후한)",200,null,0,"ea",["CN"],0,"p","~",15,100,1,"","장보(張寶,? ~ 184년)는 황건적의 수령 장각(張角)의 동생이자 장량(張梁)의 형이다.",184],["k132074","한당",150,227,0,"ea",["CN"],1,"p","~",11,216,0,"","",190],["k298327","한호 (삼국지)",150,218,0,"ea",["CN"],0,"p","~",10,245,0,"","",190],["k3678179","티베리우스 클라우디우스 폼페이아누스",130,193,0,"eu",["IT","TR"],0,"p","~",17,61,1,"","티베리우스 클라우디우스 폼페이아누스 (Tiberius Claudius Pompeianus, 125년경 – 193년)는 서기 2세기 로마 제국에서 활동했던 정치인이자 지휘관이다.",170],["k951003","베티우스 발렌스",120,175,0,"eu",["IT","TR"],6,"p","",18,49,0,"","베티우스 발렌스(Vettius Valens, 120년 2월 8일 ~ 175년경)는 헬레니즘 점성가이며, 프톨레마이오스보다 다소 늦은 태생의 동시대의 사람이다.",160],["k502539","보즐",150,247,0,"ea",["CN"],0,"p","~",13,128,0,"","보즐(步騭, ? ~ 247년)은 중국 후한 말 ~ 삼국 시대 동오의 정치가로, 자는 자산(子山)이며 임회군 회음현(淮陰縣) 사람이다.",190],["k787162","환사황후",150,172,0,"xx",[],8,"p","~",13,125,0,"","환사황후 두묘(桓思皇后 竇妙, ? ~ 172년)는 후한 환제의 세 번째 황후이다.",172],["k481822","주치 (동오)",156,224,0,"ea",["CN"],0,"p","",11,181,0,"","",196],["k3615421","마르쿠스 안니우스 베루스 카이사르",162,169,0,"eu",["IT"],0,"p","",18,46,1,"","마르쿠스 안니우스 베루스 카이사르 (Marcus Annius Verus Caesar, 162년 혹은 163년 – 169년 9월 10일)는 로마 황제 마르쿠스 아우렐리우스와 황후 소 파우스티나 사이에",169],["k177395","반장 (동오)",150,234,0,"ea",["CN"],0,"p","~",10,215,0,"","",190],["k282732","복양 전투",194,195,0,"ea",["CN"],1,"e","",7,364,1,"","",194],["k102599","소열황후",150,210,0,"ea",["CN"],8,"p","~",9,244,1,"","",190],["k873914","무열황후",156,207,0,"ea",["CN"],8,"p","",13,112,0,"","무열황후 오씨(武烈皇后 吳氏, ? ~ 207년)는 손견의 부인으로, 손견이 동오에서 황제로 추존되면서 황후로 추존됐다.",196],["k293867","완성 전투",197,199,0,"ea",["CN"],1,"e","",8,292,0,"","",197],["k875184","보연사",150,238,0,"ea",["CN"],8,"p","~",10,188,0,"","",190],["k194335","장굉",153,212,0,"ea",["CN"],0,"p","",12,125,0,"","장굉(張紘, 153년 ~ 212년)은 중국 후한 말기의 군웅 손권(孫權)의 모사이며, 자는 자강(子綱)이고 광릉군 사람이다.",193],["k256892","오의",150,237,0,"ea",["CN"],1,"p","~",8,266,0,"","",190],["k102724","공손공",150,300,0,"ea",["CN"],0,"p","~",11,149,0,"","",190],["k298655","계교 전투",191,null,0,"ea",["CN"],1,"e","",10,174,0,"","",191],["k165070","장연 (삼국지)",150,null,0,"ea",["CN"],2,"p","~",8,229,0,"","",190],["k380360","한현",151,209,0,"xx",[],0,"p","",9,188,0,"","",191],["k433982","진도 (촉한)",150,null,0,"ea",["CN"],1,"p","~",9,180,0,"","",190],["k300115","양봉 (삼국지)",200,null,0,"xx",[],1,"p","~",8,209,0,"","",197],["k447824","송황후 (후한)",156,178,0,"xx",[],8,"p","",11,114,0,"","",178],["k487336","장양 (후한 환관)",200,null,0,"ea",["CN"],0,"p","~",11,111,0,"","",189],["k3962210","루키우스 볼루시우스 마이키아누스",110,175,0,"eu",["IT"],0,"p","~",18,28,1,"","루키우스 볼루시우스 마이키아누스 (Lucius Volusius Maecianus, 110년경 – 175년)는 로마 시대의 법학자로, 로마 황제 안토니누스 피우스에게 법적 문제에 대해 조언을 했으며,",150],["k568021","하제 (동오)",150,227,0,"ea",["CN"],0,"p","~",9,157,0,"","",190],["k19407