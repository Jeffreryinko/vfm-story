{"id":"k3584962","qid":"Q123057","title":"오귀스탱 피라무스 드 캉돌","en":"Augustin Pyramus de Candolle","desc":"Swiss botanist (1778–1841)","k":"person","y":1778,"y2":1841,"ya":1818,"md":"","e":3,"r":"유럽","c":["CH","FR"],"s":["제네바 공화국"],"h":"발견과 실수","g":"","n":53,"img":"https://upload.wikimedia.org/wikipedia/commons/7/7c/Candolle_Augustin_Pyrame_de_1778-1841.jpg?utm_source=ko.wikipedia.org&utm_campaign=api&utm_content=thumbnail_unscaled","one":"오귀스탱 피라무스 드 캉돌(Augustin Pyramus de Candolle, 1778년 2월 4일 – 1841년 9월 9일)은 스위스인 식물학자이다.","lead":"오귀스탱 피라무스 드 캉돌(Augustin Pyramus de Candolle, 1778년 2월 4일 – 1841년 9월 9일)은 스위스인 식물학자이다. 데폰테이누는 캉돌을 허바륨에서 식물학 경력을 시작할 수 있게 했다. 2년에 걸쳐 캉돌은 새로운 속을 확립했으며 수백개 과의 식물을 기록하고 새로운 자연 식물 분류법을 완성했다. 식물하에 주로 집중했으나 식물지리학, 농학, 고생물학, 의학식물학, 경제식물학 등 관련 분야에도 기여했다.","secs":[],"heads":[["저서",2]],"full":true,"cut":false,"links":["스위스인","식물학","데폰테이누","허바륨","식물지리학","농학","고생물학","경제식물학"],"rel":{},"occ":["식물학자","교수","동물학자","자연과학자"],"cls":["사람"],"cats":["1778년 출생","1841년 사망","네덜란드 왕립 예술 과학 아카데미 회원","로열 메달 수상자","선태학자","스웨덴 왕립 과학원의 회원","스위스의 분류학자","양치식물학자","왕립학회 외국인 회원","진화론 선구자"],"src":{"site":"ko.wikipedia.org","title":"오귀스탱 피라무스 드 캉돌","url":"https://ko.wikipedia.org/wiki/%EC%98%A4%EA%B7%80%EC%8A%A4%ED%83%B1_%ED%94%BC%EB%9D%BC%EB%AC%B4%EC%8A%A4_%EB%93%9C_%EC%BA%89%EB%8F%8C","rev":40606814,"edited":"2025-09-11","license":"CC BY-SA 4.0"},"at":"2026-11-04","roles":{"nat":[["CH",""],["CH","제네바 공화국"],["FR",""]],"work":[["FR",""],["CH",""]],"born":[["CH",""]]}}