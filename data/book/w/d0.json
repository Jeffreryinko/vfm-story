t/search?w=bookpage&bookId=776718&q=%EC%9A%B8%EA%B8%B0%EC%97%94+%EC%A2%80+%EC%95%A0%EB%A7%A4%ED%95%9C","links":{"google":"https://www.google.com/search?q=%22%EC%9A%B8%EA%B8%B0%EC%97%94%20%EC%A2%80%20%EC%95%A0%EB%A7%A4%ED%95%9C%22%20%EC%B5%9C%EA%B7%9C%EC%84%9D","lib":"https://www.data4library.kr/srch?srchText=9788958284970","millie":"https://www.millie.co.kr/v3/search/result/%EC%9A%B8%EA%B8%B0%EC%97%94%20%EC%A2%80%20%EC%95%A0%EB%A7%A4%ED%95%9C","ridi":"https://ridibooks.com/search?q=%EC%9A%B8%EA%B8%B0%EC%97%94%20%EC%A2%80%20%EC%95%A0%EB%A7%A4%ED%95%9C","welaaa":"https://www.welaaa.com/search?keyword=%EC%9A%B8%EA%B8%B0%EC%97%94%20%EC%A2%80%20%EC%95%A0%EB%A7%A4%ED%95%9C","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788958284970","yes24":"https://www.yes24.com/product/search?query=9788958284970","elib":"https://www.google.com/search?q=%EC%9A%B8%EA%B8%B0%EC%97%94%20%EC%A2%80%20%EC%95%A0%EB%A7%A4%ED%95%9C%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bd0987a52d":{"id":"bd0987a52d","t":"교양의 탄생","a":"이광주","tr":[],"pub":"한길사","y":"2009","isbn":"9788935657377","isbns":["9788935657377"],"cv":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788935657377.jpg","cv2":"https://search1.kakaocdn.net/thumb/R120x174.q85/?fname=http%3A%2F%2Ft1.daumcdn.net%2Flbook%2Fimage%2F525369%3Ftimestamp%3D20190123161324","f":"철학·사상","n":"한국","e":"현대","l":"보통","pg":"","ot":"","intro":"&lt;편력: 내 젊은 날의 마에스트로&gt; &lt;유럽사회 풍속산책&gt;등 지성사를 중심으로 유럽 문화 전반에 대해 폭넓은 연구를 해오고 있는 인제대 명예교수 이광주의 저서『교양의 탄생』. 이 책은 고대 그리스?로마 시대로부터 20세기의 지식인 참여운동에 이르기까지, 유럽을 형성해온 인문정신을 탐구한 유럽 지성사의 완결편이다.  교양은 ‘정신의 육성’을 뜻하고 교양인은 농민이 밭을 갈 듯 도처에 삶의 푸르름을 만끽할 수 있는 사람이다. 중세","icut":true,"toc":"����\u0000\u0010JFIF\u0000\u0001\u0001\u0001\u0001,\u0001,\u0000\u0000�� �Exif\u0000\u0000MM\u0000*\u0000\u0000\u0000\b\u0000\u0007\u0001\u0012\u0000\u0003\u0000\u0000\u0000\u0001\u0000\u0001\u0000\u0000\u0001\u001a\u0000\u0005\u0000\u0000\u0000\u0001\u0000\u0000\u0000b\u0001\u001b\u0000\u0005\u0000\u0000\u0000\u0001