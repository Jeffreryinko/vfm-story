%20%EB%8F%84%EA%B0%90","welaaa":"https://www.welaaa.com/search?keyword=%EB%94%B1%EC%A0%95%EB%B2%8C%EB%A0%88%20%EB%8F%84%EA%B0%90","kyobo":"https://search.kyobobook.co.kr/search?keyword=9791163141143","yes24":"https://www.yes24.com/product/search?query=9791163141143","elib":"https://www.google.com/search?q=%EB%94%B1%EC%A0%95%EB%B2%8C%EB%A0%88%20%EB%8F%84%EA%B0%90%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"b5b515838c":{"id":"b5b515838c","t":"분단의 현장 판문점과 DMZ","a":"김녕만","tr":[],"pub":"윤진","y":"2018","isbn":"9791195596478","isbns":["9791195596478"],"cv":"https://image.yes24.com/goods/62495283/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9791195596478.jpg","f":"예술","n":"한국","e":"현대","l":"쉽게","pg":"288","ot":"","intro":"김녕만 사진집\n\"분단의 현장 판문점과 DMZ\"\n\n1983년부터 2018년까지 35년 동안 판문점과 비무장지대(DMZ), 서해안 북방한계선(NLL) 그리고 접경지역을 기록해온 김녕만 사진집 \"분단의 현장 판문점과 DMZ\"가 출간되었다. 제1부는 판문점, 2부는 DMZ(Demilitarized Zone)와 NLL(Northern Limit Line), 그리고 제3부는 철책과 더불어 사는 접경지역 사람들의 삶으로 구성되었다. 288페이지 책 속에 187점의 사진들이 수록되어 있다. 판문점 내 건물 처마에서 굵은 고드름이 녹아내리는 사진, 철조망 공사를 위해 잠시 철책이 제거된 사이로 선명하게 보이는 북한 마을, 지뢰 경고판 아래에서도 꽃은 피어나고 철책 앞에서 고라니들이 헤엄치는 사진들을 통해 작가는 끊임없이 긍정의 메시지를 보내고 있다.","icut":false,"toc":"작업 노트 | 분단의 현장에서 희망을 읽다\n판문점\n비무장지대와 북방한계선\n접경지역\n판문점과 비무장지대 그리고 접경지역","recs":[["sejong","2019"]],"shorts":["세종도서"],"univ":[],"au":{"b":1949,"kw":"김녕만"},"eb":[],"full":{},"rel":[],"star":0,"y24":"https://www.yes24.com/product/goods/62495283","daum":"https://search.daum.net/search?w=bookpage&bookId=1654220&q=%EB%B6%84%EB%8B%A8%EC%9D%98+%ED%98%84%EC%9E%A5+%ED%8C%90%EB%AC%B8%EC%A0%90%EA%B3%BC+DMZ","links":{"google":"https://www.google.com/search?q=%22%EB%B6%84%EB%8B%A8%EC%9D%98%20%ED%98%84%EC%9E%A5%20%ED%8C%90%EB%AC%B8%EC%A0%90%EA%B3%BC%20DMZ%22%20%EA%B9%80%EB%85%95%EB%A7%8C","lib":"https://www.data4library.kr/srch?srchText=9791195596478","millie":"https://www.millie.co.kr/v3/search/result/%EB%B6%84%EB%8B%A8%EC%9D%98%20%ED%98%84%EC%9E%A5%20%ED%8C%90%EB%AC%B8%EC%A0%90%EA%B3%BC%20DMZ","ridi":"https://ridibooks.com/search?q=%EB%B6%84%EB%8B%A8%EC%9D%98%20%ED%98%84%EC%9E%A5%20%ED%8C%90%EB%AC%B8%EC%A0%90%EA%B3%BC%20DMZ","welaaa":"https://www.welaaa.com/search?keyword=%EB%B6%84%EB%8B%A8%EC%9D%98%20%ED%98%84%EC%9E%A5%20%ED%8C%90%EB%AC%B8%EC%A0%90%EA%B3%BC%20DMZ","kyobo":"https://search.kyobobook.co.kr/search?keyword=9791195596478","yes24":"https://www.yes24.com/product/search?query=9791195596478","elib":"https://www.google.com/search?q=%EB%B6%84%EB%8B%A8%EC%9D%98%20%ED%98%84%EC%9E%A5%20%ED%8C%90%EB%AC%B8%EC%A0%90%EA%B3%BC%20DMZ%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"b5b991519d":{"id":"b5b991519d","t":"어느 외계인의 인류학 보고서","a":"이경덕","tr":[],"pub":"사계절","y":"2013","isbn":"9788958286882","isbns":["9788958286882"],"cv":"https://image.yes24.com/goods/11101308/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788958286882.jpg","f":"사회·정치","n":"한국","e":"근대","l":"쉽게","pg":"224","ot":"","intro":"가상의 외계인 보고서를 통해 사회화, 문화의 교류와 변화, 성 역할, 어른 되기, 놀이와 축제, 결혼과 가족, 권력의 종류, 종교의 역할 등 인류 문화를 전반적으로 다룬다. 즉 한 사회의 구성원이 된다는 것이 무엇인지, 남성과 여성의 역할은 어떻게 정해지는 것인지, 어른이 된다는 것은 또 무엇인지, 왜 세상에는 다양한 결혼 제도가 있는지, 권력은 어디에서 나오는지, 종교의 역할은 무엇인지 등을 다룬다.\n\n이러한 내용을 지구에 정착해서 살려고 하는 외계인의 입을 빌려 때로는 유머러스하게 때로는 진지하게 풀어간다. 그러면서 인류 문화의 본질을 꿰는 이야기를 자연스럽게 펼쳐 낸다. 3자인 외계인의 시각, 즉 인류학의 시각으로 다채로운 인류 문화를 흥미롭게 풀어 낸 이 책이 문화를 이해하는 눈과 문화를 성숙하게 키워나갈 힘을 더해 줄 것이다.","icut":false,"toc":"머리말 외계인의 보고서가 출간되기까지\n프롤로그 '아름다운 고리'의 비극과 희망\n일러두기 돌도끼와 쇠도끼\n1 인류와 문화\n인간과 동물의 진정한 차이는? - 인간과 문화\n인간의 탈을 쓴 늑대 - 문화화의 상징\n서로 다른 문화가 만나면? - 문화상대주의와 교류\n2 요람에서 무덤까지\n태어난 여성, 만들어진 남성 - 성과 사회\n아이의 죽음 - 성인식\n신붓값과 지참금 - 결혼과 가족\n놀이하는 인간 - 놀이와 축제\n3 사회와 세계\n신들은 어디에 있을까? - 종교와 사회\n힘은 어디에서 올까? - 정치와 권력\n교환의 세계 - 경제\n이스터 섬의 석상들 - 자연과 인간\n에필로그\n저자 후기\n참고문헌","recs":[["sejong","2014"],["teenyr","2013"]],"shorts":["세종도서","올해의 청소년도서"],"univ":[],"au":{"b":1858,"d":1926,"kw":"이완용","en":"Yi Wanyong"},"eb":[["YES24 eBook","https://www.yes24.com/product/goods/16977540"]],"full":{},"rel":[["h","k6312","이완용"]],"star":8.9,"y24":"https://www.yes24.com/product/goods/11101308","daum":"https://search.daum.net/search?w=bookpage&bookId=776912&q=%EC%96%B4%EB%8A%90+%EC%99%B8%EA%B3%84%EC%9D%B8%EC%9D%98+%EC%9D%B8%EB%A5%98%ED%95%99+%EB%B3%B4%EA%B3%A0%EC%84%9C","links":{"google":"https://www.google.com/search?q=%22%EC%96%B4%EB%8A%90%20%EC%99%B8%EA%B3%84%EC%9D%B8%EC%9D%98%20%EC%9D%B8%EB%A5%98%ED%95%99%20%EB%B3%B4%EA%B3%A0%EC%84%9C%22%20%EC%9D%B4%EA%B2%BD%EB%8D%95","lib":"https://www.data4library.kr/srch?srchText=9788958286882","millie":"https://www.millie.co.kr/v3/search/result/%EC%96%B4%EB%8A%90%20%EC%99%B8%EA%B3%84%EC%9D%B8%EC%9D%98%20%EC%9D%B8%EB%A5%98%ED%95%99%20%EB%B3%B4%EA%B3%A0%EC%84%9C","ridi":"https://ridibooks.com/search?q=%EC%96%B4%EB%8A%90%20%EC%99%B8%EA%B3%84%EC%9D%B8%EC%9D%98%20%EC%9D%B8%EB%A5%98%ED%95%99%20%EB%B3%B4%EA%B3%A0%EC%84%9C","welaaa":"https://www.welaaa.com/search?keyword=%EC%96%B4%EB%8A%90%20%EC%99%B8%EA%B3%84%EC%9D%B8%EC%9D%98%20%EC%9D%B8%EB%A5%98%ED%95%99%20%EB%B3%B4%EA%B3%A0%EC%84%9C","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788958286882","yes24":"https://www.yes24.com/product/search?query=9788958286882","elib":"https://www.google.com/search?q=%EC%96%B4%EB%8A%90%20%EC%99%B8%EA%B3%84%EC%9D%B8%EC%9D%98%20%EC%9D%B8%EB%A5%98%ED%95%99%20%EB%B3%B4%EA%B3%A0%EC%84%9C%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"b5b281bf53":{"id":"b5b281bf53","t":"대마도에서 만난 우리 역사","a":"문사철","tr":[],"pub":"한림출판사","y":"2011","isbn":"9788970946214","isbns":["9788970946214"],"cv":"https://image.yes24.com/goods/4853948/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788970946214.jpg","f":"언어·교양","n":"한국","e":"미상","l":"쉽게","pg":"216","ot":"","intro":"대마도는 한국과 일본 사이에 있는 작은 섬. 지리적으로 한국과는 49km, 일본과는 138km 떨어져 있기 때문에 예로부터 우리와 밀접한 관계를 맺어 왔다. 지금도 대마도 주민보다 한국인 관광객이 더 많이 오가는, 한국에 의존해 살아갈 수밖에 없는 ‘한국을 바라보는 일본 섬’이다. 이 섬이 간직하고 있는 한국과 일본의 역사는 깊고도 넓다.","icut":false,"toc":"1. 역사의 시작과 대마도\n- 진구 황후의 전설이 남아 있는 쓰쓰 반도에서\n2. 삼국시대의 대마도\n- 박제상이 장렬히 죽음을 맞은 미나토에서\n3. 삼국 통일과 대마도\n- 백제 유민의 한이 서려 있는 가네다 성에서\n4. 고려 시대의 대마도\n- 여원 연합군이 밀어닥친 고모다하마에서\n5. 왜구와 대마도\n- 조선의 정벌군이 밀어닥친 오자키에서\n6. 임진왜란과 대마도\n- 조선 정벌의 광풍이 몰아닥친 오우라에서\n7. 조선 통신사와 대마도\n- 평화의 사도를 따라 사스나에서 이즈하라까지\n8. 항일 투쟁과 대마도\n- 최익현의 충정이 서려 있는 이즈하라에서\n9. 일제강점기의 대마도\n- 덕혜옹주의 한이 서려 있는 이즈하라에서","recs":[["sejong","2011"]],"shorts":["세종도서"],"univ":[],"au":{},"eb":[],"full":{},"rel":[],"star":6.9,"y24":"https://www.yes24.com/product/goods/4853948","daum":"https://search.daum.net/search?w=bookpage&bookId=976063&q=%EB%8C%80%EB%A7%88%EB%8F%84%EC%97%90%EC%84%9C+%EB%A7%8C%EB%82%9C+%EC%9A%B0%EB%A6%AC+%EC%97%AD%EC%82%AC","links":{"google":"https://www.google.com/search?q=%22%EB%8C%80%EB%A7%88%EB%8F%84%EC%97%90%EC%84%9C%20%EB%A7%8C%EB%82%9C%20%EC%9A%B0%EB%A6%AC%20%EC%97%AD%EC%82%AC%22%20%EB%AC%B8%EC%82%AC%EC%B2%A0","lib":"https://www.data4library.kr/srch?srchText=9788970946214","millie":"https://www.millie.co.kr/v3/search/result/%EB%8C%80%EB%A7%88%EB%8F%84%EC%97%90%EC%84%9C%20%EB%A7%8C%EB%82%9C%20%EC%9A%B0%EB%A6%AC%20%EC%97%AD%EC%82%AC","ridi":"https://ridibooks.com/search?q=%EB%8C%80%EB%A7%88%EB%8F%84%EC%97%90%EC%84%9C%20%EB%A7%8C%EB%82%9C%20%EC%9A%B0%EB%A6%AC%20%EC%97%AD%EC%82%AC","welaaa":"https://www.welaaa.com/search?keyword=%EB%8C%80%EB%A7%88%EB%8F%84%EC%97%90%EC%84%9C%20%EB%A7%8C%EB%82%9C%20%EC%9A%B0%EB%A6%AC%20%EC%97%AD%EC%82%AC","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788970946214","yes24":"https://www.yes24.com/product/search?query=9788970946214","elib":"https://www.google.com/search?q=%EB%8C%80%EB%A7%88%EB%8F%84%EC%97%90%EC%84%9C%20%EB%A7%8C%EB%82%9C%20%EC%9A%B0%EB%A6%AC%20%EC%97%AD%EC%82%AC%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"b5b8fec9a1":{"id":"b5b8fec9a1","t":"천하무적 오형제","a":"노경실","tr":[],"pub":"애플트리태일즈","y":"2009","isbn":"9788991667549","isbns":["9788991667549"],"cv":"https://image.yes24.com/goods/3576766/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788991667549.jpg","f":"언어·교양","n":"한국","e":"현대","l":"쉽게","pg":"48","ot":"","intro":"이 시대 우리 아이들에게 필요한 협동심과 용기 있는 삶을\n좋은 글과 좋은 그림으로 표현하다\n\n각기 특별한 재주를 가진 아이 다섯이 만나 형제를 맺고 손을 잡아 호랑이와의 싸움을 막아내는 이야기는 핵가족 속에 살아가는 우리 아이들에게 사회 속에서 다른 사람들과의 화합이 얼마나 중요한가를 얘기해 줍니다. 다섯 아이들의 재주는 기존 가치에 부합하는 우월성이 아니라 엉뚱하고 웃음을 자아내는 재능입니다.","icut":false,"toc":"","recs":[["sejong","2010"]],"shorts":["세종도서"],"univ":[],"au":{"b":1958,"kw":"노경실"},"eb":[],"full":{},"rel":[],"star":9.6,"y24":"https://www.yes24.com/product/goods/3576766","daum":"https://search.daum.net/search?w=bookpage&bookId=1353957&q=%EC%B2%9C%ED%95%98%EB%AC%B4%EC%A0%81+%EC%98%A4%ED%98%95%EC%A0%9C","links":{"google":"https://www.google.com/search?q=%22%EC%B2%9C%ED%95%98%EB%AC%B4%EC%A0%81%20%EC%98%A4%ED%98%95%EC%A0%9C%22%20%EB%85%B8%EA%B2%BD%EC%8B%A4","lib":"https://www.data4library.kr/srch?srchText=9788991667549","millie":"https://www.millie.co.kr/v3/search/result/%EC%B2%9C%ED%95%98%EB%AC%B4%EC%A0%81%20%EC%98%A4%ED%98%95%EC%A0%9C","ridi":"https://ridibooks.com/search?q=%EC%B2%9C%ED%95%98%EB%AC%B4%EC%A0%81%20%EC%98%A4%ED%98%95%EC%A0%9C","welaaa":"https://www.welaaa.com/search?keyword=%EC%B2%9C%ED%95%98%EB%AC%B4%EC%A0%81%20%EC%98%A4%ED%98%95%EC%A0%9C","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788991667549","yes24":"https://www.yes24.com/product/search?query=9788991667549","elib":"https://www.google.com/search?q=%EC%B2%9C%ED%95%98%EB%AC%B4%EC%A0%81%20%EC%98%A4%ED%98%95%EC%A0%9C%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"b5b7188911":{"id":"b5b7188911","t":"엄마를 구합니다","a":"이규희","tr":[],"pub":"청어람주니어","y":"2009","isbn":"9788925116372","isbns":["9788925116372"],"cv":"https://image.yes24.com/goods/3258668/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788925116372.jpg","f":"언어·교양","n":"한국","e":"현대","l":"쉽게","pg":"120","ot":"","intro":"스스로 엄마를 찾아 나서는 씩씩한 아이들!\n\n『엄마를 구합니다』는 새엄마가 필요한 나래와 미루의 엄마 구하기 작전이 아슬아슬하게 펼쳐지는 동화입니다. 엄마가 되면 좋을 거 같아 보이는 여자 어른들은 틀림없이 나래와 미루의 작전 망으로 걸려들지요. 이렇게 우여곡절 끝에 전혀 생각지도 못한 아줌마를 엄마로 맞이하게 된 아이들은 어느 새 한 뼘 자라 있습니다.\n\n‘엄마 구하기’를 통해 새로운 가족을 받아들이는 아이들의 모습이 진지하면서도 발랄하게 펼쳐지는 동화 『엄마를 구합니다』.","icut":false,"toc":"1. 온 집 안이 엉망진창\n2. 요리는 너무 어려워\n3. 우리도 엄마가 있었으면\n4. 우리 아빠 좀 살려 주세요!\n5. 아무래도 안 되겠어!\n6. 109동 704호 아줌마\n7. 우리 선생님 어때?\n8. 아빠의 여자 친구\n9. 새로운 작전이 필요해\n10. 어, 이건 아니잖아\n11. 사람마다 다 다르잖아","recs":[["sejong","2009"]],"shorts":["세종도서"],"univ":[],"au":{"b":1961,"kw":"이규희","en":"Lee Kyu-hee"},"eb":[],"full":{},"rel":[],"star":0,"y24":"https://www.yes24.com/product/goods/3258668","daum":"https://search.daum.net/search?w=bookpage&bookId=399019&q=%EC%97%84%EB%A7%88%EB%A5%BC+%EA%B5%AC%ED%95%A9%EB%8B%88%EB%8B%A4","links":{"google":"https://www.google.com/search?q=%22%EC%97%84%EB%A7%88%EB%A5%BC%20%EA%B5%AC%ED%95%A9%EB%8B%88%EB%8B%A4%22%20%EC%9D%B4%EA%B7%9C%ED%9D%AC","lib":"https://www.data4library.kr/srch?srchText=9788925116372","millie":"https://www.millie.co.kr/v3/search/result/%EC%97%84%EB%A7%88%EB%A5%BC%20%EA%B5%AC%ED%95%A9%EB%8B%88%EB%8B%A4","ridi":"https://ridibooks.com/search?q=%EC%97%84%EB%A7%88%EB%A5%BC%20%EA%B5%AC%ED%95%A9%EB%8B%88%EB%8B%A4","welaaa":"https://www.welaaa.com/search?keyword=%EC%97%84%EB%A7%88%EB%A5%BC%20%EA%B5%AC%ED%95%A9%EB%8B%88%EB%8B%A4","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788925116372","yes24":"https://www.yes24.com/product/search?query=9788925116372","elib":"https://www.google.com/search?q=%EC%97%84%EB%A7%88%EB%A5%BC%20%EA%B5%AC%ED%95%A9%EB%8B%88%EB%8B%A4%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"b5bcfc0719":{"id":"b5bcfc0719","t":"십대답게 살아라","a":"문지현","tr":[],"pub":"뜨인돌출판사","y":"2008","isbn":"9788958072485","isbns":["9788958072485"],"cv":"https://image.yes24.com/goods/3213052/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788958072485.jpg","f":"언어·교양","n":"한국","e":"현대","l":"쉽게","pg":"198","ot":"","intro":"'튼튼한 정신’을 소유하는 것만이 어떤 상황에서도 진짜 행복할 수 있는 유일한 비결이라고 믿는 정신과 전문의의 심리상담 자기계발서. 십대들이 의욕과 열정을 갖지 못하는 이유는 목표가 없어서도, 꿈이 없어서도 아니다. 바로 그들 내면에 어떠한 문제가 생겼기 때문이다. 공부와 친구 관계, 외모 등 여러가지 문제들로 고민하는 소년들의 내면을 어루만져줄 뿐만 아니라 각기 다른 문제들을 해결할 수 있는 명쾌한 행동법을 제시한다.","icut":false,"toc":"나를 말한다\n애늙은이 십대에서 저력 있는 십대로\n내가 너무 싫어 낮은 자존감 바이러스\n이게 다 너 때문이야 탓쟁이 바이러스\n인생 뭐 있어, 그냥 쉬엄쉬엄 가는 거야 게으름 바이러스\n상처는 나의 힘 한恨 바이러스\n화를 내야 건강하다, 이거지? 분노 억압 바이러스\n이젠 혼자 놀기도 지겨워 아웃사이더 바이러스\n헥헥, 바쁘다 바빠! 분주함 바이러스\n유비무환! 걱정도 미리미리 염려 바이러스\n친구라면 절대 그럴 수 없지 Should 바이러스\n나는 아직도 배가 고프다 완벽주의 바이러스\n네가 그렇지, 뭐! 편견 바이러스\n나는야 쿨~ 하다 못해 냉담한 십대 메마름 바이러스\n후덜덜, 나 혼자 하라고? 의존 바이러스\n도대체, 왜, 항상! 나만 이 모양이야! 투덜이 바이러스\n열정으로 무장한 진짜 나를 만나길","recs":[["sejong","2009"]],"shorts":["세종도서"],"univ":[],"au":{"b":1960,"kw":"문지현","en":"Mun Ji-hyeon"},"eb":[],"full":{},"rel":[],"star":9,"y24":"https://www.yes24.com/product/goods/3213052","daum":"https://search.daum.net/search?w=bookpage&bookId=772302&q=%EC%8B%AD%EB%8C%80%EB%8B%B5%EA%B2%8C+%EC%82%B4%EC%95%84%EB%9D%BC","links":{"google":"https://www.google.com/search?q=%22%EC%8B%AD%EB%8C%80%EB%8B%B5%EA%B2%8C%20%EC%82%B4%EC%95%84%EB%9D%BC%22%20%EB%AC%B8%EC%A7%80%ED%98%84","lib":"https://www.data4library.kr/srch?srchText=9788958072485","millie":"https://www.millie.co.kr/v3/search/result/%EC%8B%AD%EB%8C%80%EB%8B%B5%EA%B2%8C%20%EC%82%B4%EC%95%84%EB%9D%BC","ridi":"https://ridibooks.com/search?q=%EC%8B%AD%EB%8C%80%EB%8B%B5%EA%B2%8C%20%EC%82%B4%EC%95%84%EB%9D%BC","welaaa":"https://www.welaaa.com/search?keyword=%EC%8B%AD%EB%8C%80%EB%8B%B5%EA%B2%8C%20%EC%82%B4%EC%95%84%EB%9D%BC","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788958072485","yes24":"https://www.yes24.com/product/search?query=9788958072485","elib":"https://www.google.com/search?q=%EC%8B%AD%EB%8C%80%EB%8B%B5%EA%B2%8C%20%EC%82%B4%EC%95%84%EB%9D%BC%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"b5be5674bc":{"id":"b5be5674bc","t":"서울사용 설명서 2084","a":"이현수","tr":[],"pub":"도서출판 선","y":"2008","isbn":"9788986509649","isbns":["9788986509649"],"cv":"https://image.yes24.com/goods/2921995/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788986509649.jpg","f":"예술","n":"한국","e":"미상","l":"보통","pg":"620","ot":"","intro":"서울사용설명서 2084는 미래에 다가 올 대한민국 건국 100주년이 되는 해 2048년을 생각하며 쓴 책이다. 조지 오웰이 저서 ‘1984년’에서 48년을 거꾸로 하여 책 제목을 ‘1984년’으로 정한 것처럼, 2084를 책 제목 뒤에 붙였다. 서울사용설명서는 서울사람들의 행복은 물론 대한민국의 국민을 보다 행복하게 만들려는 의도에서 쓰여 진 책이다. 사람이 공간을 만들지만 공간은 사람을 만든다. 저자는 공간을 매개체로 사람들을 얼마든지 행복하게 만들 수 있다고 믿는다. 이것이 저자가 생각하는 공간행복론이다.","icut":false,"toc":"01_2005년 10월의 미래,2084년\n흥국생명 빌딩/파이낸스 빌딩/청계천의 수로복원/청계천입구/복원의 소멸,청계천과 동대문 운동장/환유의 풍경/청계천 존치교각/오래된 미래 2084년\n02_근대화의 기억,종로거리\n삼일빌딩/종로타워/정상/명품건축/명품 마케팅\n03_이종교배의 꼴라쥬,이태원과 한남동\n이슬람/이슬람 사원/체험 마케팅/삼성 미술관 리움/고 미술관/현대 미술관/한국 근현대 미술/서양 근현대 미술/렘 쿨하스/력셔리 코리아/이종교배\n04_숍 아이덴티티,강남대로\n교보빌딩/갈색/부티크 모나코/명품 마케팅/쇼를 하라/디지털 유목민/강남의 상점/신사동 가로수길/2029 트렌드/가로수길의 상점/숍 아이덴티티\n^05_서울 마케팅\n경관/랜드마크/길/명품건축/서울의 품격\n06_정점,북촌마을\n가회동 언덕/골목길/가회동 31번지/한옥체험/가회 박물관/올물/윤보선가/북촌의 레스토랑/수제화 숍/북촌마을/정점\n07_전통과 미래의 길,인사동 거리\n인사아트 & 가나아트센터/쌈지길/고택/인사동에서 만나는 상점/찻집/인사동길/예술 마케팅/화랑거리의 복원\n08_거대 전시공간,영동대로\n라 데팡스의 조각 공원/코엑스 몰/메가박스 VIP공간/IT종합 체험관/서비스 마케팅/코엑스 전시관/거대 조각 작품,현대 산업개발 I-PARK/레벨업/대중 마케팅/원스톱 서비스 복합건물\n09_기억의 복원,광화문 거리\n교보빌딩/KT 사옥/오래된 축선/광화문/근정전/사정전과 강녕전/교태전/경회루/역사 마케팅\n10_대한민국 마케팅\n세계화/사회의 여성화/접속사회화/감시사회/교양/미/상상력/열정/보편적 가치/예술의 도시/자연의 도시/소통의 도시/스토리텔링의 도시/공간행복론의 도시","recs":[["sejong","2008"]],"shorts":["세종도서"],"univ":[],"au":{"en":"Hyun Su Lee"},"eb":[],"full":{},"rel":[],"star":6,"y24":"https://www.yes24.com/product/goods/2921995","daum":"https://search.daum.net/search?w=bookpage&bookId=1241227&q=%EC%84%9C%EC%9A%B8%EC%82%AC%EC%9A%A9+%EC%84%A4%EB%AA%85%EC%84%9C+2084","links":{"google":"https://www.google.com/search?q=%22%EC%84%9C%EC%9A%B8%EC%82%AC%EC%9A%A9%20%EC%84%A4%EB%AA%85%EC%84%9C%202084%22%20%EC%9D%B4%ED%98%84%EC%88%98","lib":"https://www.data4library.kr/srch?srchText=9788986509649","millie":"https://www.millie.co.kr/v3/search/result/%EC%84%9C%EC%9A%B8%EC%82%AC%EC%9A%A9%20%EC%84%A4%EB%AA%85%EC%84%9C%202084","ridi":"https://ridibooks.com/search?q=%EC%84%9C%EC%9A%B8%EC%82%AC%EC%9A%A9%20%EC%84%A4%EB%AA%85%EC%84%9C%202084","welaaa":"https://www.welaaa.com/search?keyword=%EC%84%9C%EC%9A%B8%EC%82%AC%EC%9A%A9%20%EC%84%A4%EB%AA%85%EC%84%9C%202084","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788986509649","yes24":"https://www.yes24.com/product/search?query=9788986509649","elib":"https://www.google.com/search?q=%EC%84%9C%EC%9A%B8%EC%82%AC%EC%9A%A9%20%EC%84%A4%EB%AA%85%EC%84%9C%202084%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"b5bda8b927":{"id":"b5bda8b927","t":"좋아하는 것들을 죽여 가면서","a":"임정민","tr":[],"pub":"민음사","y":"2021","isbn":"9788937409097","isbns":["9788937409097"],"cv":"https://image.yes24.com/goods/104106266/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788937409097.jpg","f":"문학","n":"한국","e":"현대","l":"쉽게","pg":"204","ot":"","intro":"끝없이 달아난 끝에 도착한 낯선 세계에서\n이야기의 손을 잡고 강변을 거니는 시간\n\n임정민 시인의 첫 시집 『좋아하는 것들을 죽여 가면서』가 [민음의 시] 289번으로 출간되었다. 2015년 [세계의문학] 시 부문 신인상을 수상하며 등단한 임정민 시인은 시편마다 새로운 공간과 세계를 창조하여 그 안에 머무는 인물들의 독특한 사고를 시적 언어로 형상화하는 작품들을 써 왔다. ‘좋아하는 것들을 죽여 가면서’라는 제목은 쓸쓸한 체념의 어조로 읽히기도 하고, 단호한 결심의 서두로 읽히기도 한다.\n\n이 시집은 두 가지 태도를 한 몸에 지녔다. 시의 인물들은 잔뜩 긴장한 채 떨고 있는 것처럼도 보이지만 미지의 지점으로의 모험을 결코 포기하지 않는 당찬 성정을 지녔다. “똑같은 몸짓으로는 매번 달라지는 감정을 설명할 수 없어요.”라는 문장처럼 임정민의 시는 익숙한 것으로부터 계속해서 미끄러지고 달아난다.","icut":false,"toc":"1부\nHEENT 13\n사물 시는 작게 말한다 19\n조형 시는 골지 위에 쓴다 22\n공상과 포위 25\n공백의 광선 33\n아날로그 39\n벌 신(Bee God) 46\n콕토의 검색 58\n자율의 오도 1 61\n자율의 오도 2 62\n자율의 오도 3 63\n자율의 오도 4 64\n자율의 오도 5 65\n자율의 오도 6 66\n자율의 오도 7 67\n자율의 오도 8 68\n자율의 오도 9 69\n자율의 오도 10 70\n2부\n좋아하는 것들을 죽여 가면서 73\n태화강 오후 86\n갈증 92\n스몰 토크 99\n밀실 102\n모래주머니의 S와 돕는 연인들 104\n루지, 언더 트리 108\ninterlude 113\n가장 다정한 116\nasap 118\n선경 121\n공주 130\n3부\nhtml ghost 135\n루블 140\n기숙사 144\n검은 옷의 혼선에 서서 146\n크로나 150\n스키를 타는 것 154\n수조를 보는 것 158\n크로나 164\nLoveless 169\n크로나 176\n푸른빛이 페달을 181\n물방울치과 185\n1227 188\n발문│송승언(시인)\n숨은 길 189","recs":[["munhak","2022"]],"shorts":["문학나눔"],"univ":[],"au":{"b":2004,"en":"Lim Jungmin"},"eb":[["YES24 eBook","https://www.yes24.com/product/goods/106494432"]],"full":{},"rel":[],"star":0,"y24":"https://www.yes24.com/product/goods/104106266","daum":"https://search.daum.net/search?w=bookpage&bookId=5857852&q=%EC%A2%8B%EC%95%84%ED%95%98%EB%8A%94+%EA%B2%83%EB%93%A4%EC%9D%84+%EC%A3%BD%EC%97%AC+%EA%B0%80%EB%A9%B4%EC%84%9C","links":{"google":"https://www.google.com/search?q=%22%EC%A2%8B%EC%95%84%ED%95%98%EB%8A%94%20%EA%B2%83%EB%93%A4%EC%9D%84%20%EC%A3%BD%EC%97%AC%20%EA%B0%80%EB%A9%B4%EC%84%9C%22%20%EC%9E%84%EC%A0%95%EB%AF%BC","lib":"https://www.data4library.kr/srch?srchText=9788937409097","millie":"https://www.millie.co.kr/v3/search/result/%EC%A2%8B%EC%95%84%ED%95%98%EB%8A%94%20%EA%B2%83%EB%93%A4%EC%9D%84%20%EC%A3%BD%EC%97%AC%20%EA%B0%80%EB%A9%B4%EC%84%9C","ridi":"https://ridibooks.com/search?q=%EC%A2%8B%EC%95%84%ED%95%98%EB%8A%94%20%EA%B2%83%EB%93%A4%EC%9D%84%20%EC%A3%BD%EC%97%AC%20%EA%B0%80%EB%A9%B4%EC%84%9C","welaaa":"https://www.welaaa.com/search?keyword=%EC%A2%8B%EC%95%84%ED%95%98%EB%8A%94%20%EA%B2%83%EB%93%A4%EC%9D%84%20%EC%A3%BD%EC%97%AC%20%EA%B0%80%EB%A9%B4%EC%84%9C","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788937409097","yes24":"https://www.yes24.com/product/search?query=9788937409097","elib":"https://www.google.com/search?q=%EC%A2%8B%EC%95%84%ED%95%98%EB%8A%94%20%EA%B2%83%EB%93%A4%EC%9D%84%20%EC%A3%BD%EC%97%AC%20%EA%B0%80%EB%A9%B4%EC%84%9C%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"b5bdc9e329":{"id":"b5bdc9e329","t":"주 다는 남자","a":"이동재","tr":[],"pub":"포지션","y":"2018","isbn":"9791196137069","isbns":["9791196137069"],"cv":"https://image.yes24.com/goods/66916314/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9791196137069.jpg","f":"문학","n":"한국","e":"현대","l":"쉽게","pg":"124","ot":"","intro":"비판과 풍자가 사라진 지 오래인 한국 시단에 희한한 웃음을 던져주는 시인이 있다. 위정자들의 가식을 폭로할 때는 시원하고, 졸렬한 이웃들을 꾸짖을 때는 아프고, 격변하는 세태를 꼬집을 때는 절로 고개가 끄덕여지게 하는 달변의 화술이다. 여리게 웅얼거리는 시들 속에서 단연 도드라지는 통쾌한 목소리다. 여기는 우주의 작은 티끌 같은 지구이고 오천 년 지난한 역사를 통과해온 대한민국이고 무한경쟁의 덫에 걸린 삶의 현장이지만, 사람이 살아가는 곳이고 사람이라면 사람을 생각하며 살아야 한다는 지극히 당연한 사실을, 쓰리고 아리고 허탈한 웃음과 함께 일깨운다. 그의 시는 지금 이 땅에서 벌어지는 인간성 상실의 온갖 증거에 붙이는 꼼꼼한 각주이다. 이 각주들은 모두가 외면하는 불편한 진실을 가차 없이 드러내는 보고서다. 각주에는 매끈한 본문에서 느낄 수 없는 묘미가 있다. 본문에서 배제된 사실을 촘촘히 담아내는 각주로서 그의 시는 우리 시에서 자꾸 멀어지는 문학과 삶을 긴밀하게 접착한다.","icut":false,"toc":"제1부-대학에서\n대학입학금 12\n강사 퇴근 13\n갑과 을 14\n어느 강의실에서 16\n말세의 희탄 17\n투명인간 20\n대한민국에 사는 세 가지 기쁨 21\n대학지도大學之道 22\n대학강사 삼애三哀 23\n대학 적폐 26\n제2부-전설 따라 삼 센티\n만리장성과 피라미드 30\n조선뉴스 1 32\n조선뉴스 2 33\n조선뉴스 3 34\n조선뉴스 4 35\n조선뉴스 5 36\n조선뉴스 6 38\n조선뉴스 7 39\n조선뉴스 8 41\n조선뉴스 9 42\n한국 정당 근친사와 노안 43\n전설 따라 삼 센티 44\nSK 47\n창업론 49\n켈로KLO 아저씨의 죽음 50\n불신 지옥 51\n가만히 있으리 53\n세상, 참 55\n제3부-여자들\n모든 주어는 미친년 58\n바람이 전하는 말 60\n개와 늑대의 시간 61\n여신 63\n여배우들의 수다 64\n적멸 65\n오래된 여자 67\n위대한 설계 69\n어머니 71\n아내 변천사 72\n지금 한국 여자들은 클라이밍 중 73\n호우 시절 74\n본처의 나라 75\n한국 드라마 시청기 77\n한국 여자는 성장 중 78\n시골 가로등 80\n누구에게나 자기만의 바다가 있다 81\n안인마을에서 82\n수평선 83\n평등 84\n어떤 이별 85\n제4부-변두리 문단\n황금시대 88\n시단詩壇 89\n우수문예지 90\n시인의 훈장 91\n신작시 읽기 92\n공자의 재발견 93\n시론詩論時論 94\n가지자지 95\n붓질과 좆질 96\n허명 97\n적 98\n주 다는 남자 99\n시를 위하여 103\n해설\n지옥에서 보낸 한철│고봉준 108","recs":[["munhak","2019"]],"shorts":["문학나눔"],"univ":[],"au":{"b":1996,"kw":"이동재 (축구 선수)","en":"Lee Dong-jae"},"eb":[],"full":{},"rel":[],"star":0,"y24":"https://www.yes24.com/product/goods/66916314","daum":"https://search.daum.net/search?w=bookpage&bookId=4807980&q=%EC%A3%BC+%EB%8B%A4%EB%8A%94+%EB%82%A8%EC%9E%90","links":{"google":"https://www.google.com/search?q=%22%EC%A3%BC%20%EB%8B%A4%EB%8A%94%20%EB%82%A8%EC%9E%90%22%20%EC%9D%B4%EB%8F%99%EC%9E%AC","lib":"https://www.data4library.kr/srch?srchText=9791196137069","millie":"https://www.millie.co.kr/v3/search/result/%EC%A3%BC%20%EB%8B%A4%EB%8A%94%20%EB%82%A8%EC%9E%90","ridi":"https://ridibooks.com/search?q=%EC%A3%BC%20%EB%8B%A4%EB%8A%94%20%EB%82%A8%EC%9E%90","welaaa":"https://www.welaaa.com/search?keyword=%EC%A3%BC%20%EB%8B%A4%EB%8A%94%20%EB%82%A8%EC%9E%90","kyobo":"https://search.kyobobook.co.kr/search?keyword=9791196137069","yes24":"https://www.yes24.com/product/search?query=9791196137069","elib":"https://www.google.com/search?q=%EC%A3%BC%20%EB%8B%A4%EB%8A%94%20%EB%82%A8%EC%9E%90%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"b5bda0770a":{"id":"b5bda0770a","t":"아버지 형이상학","a":"박찬일","tr":[],"pub":"예술가","y":"2017","isbn":"9791187081043","isbns":["9791187081043"],"cv":"https://image.yes24.com/goods/35188847/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9791187081043.jpg","f":"문학","n":"한국","e":"미상","l":"쉽게","pg":"172","ot":"","intro":"박찬일 시집『아버지 형이상학』. 박찬일 시인의 시 작품을 담은 책이다. '하늘의 별자리와 땅의 별자리', '수면사망의 수모', '두 마리와 사랑', '생각으로 되는 일', '도대체 무슨 상관인가' 등 박찬일 시인의 주옥같은 시 작품들을 만나볼 수 있다.","icut":true,"toc":"시인의 말\n하늘의 별자리와 땅의 별자리\n수면사망의 수모\n두 마리의 사람\n생각으로 되는 일\n도대체 무슨 상관인가\n'왜 차라리 무가 아닌가'\n차라투스트라의 동굴\n고요한 위대\n(중략)\n낭만적인, 너무나 낭만적인\n신들의 당당한 군홧발 소리\n눈 날리는 소리\n자기실망 금지 캠페인이 필요하다\n지쳐서 떨어지게 하는 방식 A-B\n아버지 형이상학\n몰락이 늘 이르다\n해설","recs":[["munhak","2017"]],"shorts":["문학나눔"],"univ":[],"au":{},"eb":[],"full":{},"rel":[],"star":0,"y24":"https://www.yes24.com/product/goods/35188847","daum":"https://search.daum.net/search?w=bookpage&bookId=1638943&q=%EC%95%84%EB%B2%84%EC%A7%80+%ED%98%95%EC%9D%B4%EC%83%81%ED%95%99","links":{"google":"https://www.google.com/search?q=%22%EC%95%84%EB%B2%84%EC%A7%80%20%ED%98%95%EC%9D%B4%EC%83%81%ED%95%99%22%20%EB%B0%95%EC%B0%AC%EC%9D%BC","lib":"https://www.data4library.kr/srch?srchText=9791187081043","millie":"https://www.millie.co.kr/v3/search/result/%EC%95%84%EB%B2%84%EC%A7%80%20%ED%98%95%EC%9D%B4%EC%83%81%ED%95%99","ridi":"https://ridibooks.com/search?q=%EC%95%84%EB%B2%84%EC%A7%80%20%ED%98%95%EC%9D%B4%EC%83%81%ED%95%99","welaaa":"https://www.welaaa.com/search?keyword=%EC%95%84%EB%B2%84%EC%A7%80%20%ED%98%95%EC%9D%B4%EC%83%81%ED%95%99","kyobo":"https://search.kyobobook.co.kr/search?keyword=9791187081043","yes24":"https://www.yes24.com/product/search?query=9791187081043","elib":"https://www.google.com/search?q=%EC%95%84%EB%B2%84%EC%A7%80%20%ED%98%95%EC%9D%B4%EC%83%81%ED%95%99%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"b5be37fde7":{"id":"b5be37fde7","t":"소금의 날","a":"문영","tr":[],"pub":"신생","y":"2006","isbn":"9788990944115","isbns":["9788990944115"],"cv":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788990944115.jpg","cv2":"https://search1.kakaocdn.net/thumb/R120x174.q85/?fname=http%3A%2F%2Ft1.daumcdn.net%2Flbook%2Fimage%2F1327701%3Ftimestamp%3D20191231121603","f":"문학","n":"한국","e":"미상","l":"쉽게","pg":"","ot":"","intro":"","icut":false,"toc":"","recs":[["munhak","2006"]],"shorts":["문학나눔"],"univ":[],"au":{"en":"Yeung-Chul Mun"},"eb":[],"full":{},"rel":[["h","k2712824","문영철"]],"star":null,"y24":"","daum":"https://search.daum.net/search?w=bookpage&bookId=1327701&q=%EC%86%8C%EA%B8%88%EC%9D%98+%EB%82%A0%28%EC%8B%A0%EC%83%9D%EC%8B%9C%EC%84%A0+12%29","links":{"google":"https://www.google.com/search?q=%22%EC%86%8C%EA%B8%88%EC%9D%98%20%EB%82%A0%22%20%EB%AC%B8%EC%98%81","lib":"https://www.data4library.kr/srch?srchText=9788990944115","millie":"https://www.millie.co.kr/v3/search/result/%EC%86%8C%EA%B8%88%EC%9D%98%20%EB%82%A0","ridi":"https://ridibooks.com/search?q=%EC%86%8C%EA%B8%88%EC%9D%98%20%EB%82%A0","welaaa":"https://www.welaaa.com/search?keyword=%EC%86%8C%EA%B8%88%EC%9D%98%20%EB%82%A0","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788990944115","yes24":"https://www.yes24.com/product/search?query=9788990944115","elib":"https://www.google.com/search?q=%EC%86%8C%EA%B8%88%EC%9D%98%20%EB%82%A0%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"b5b3d95701":{"id":"b5b3d95701","t":"잠든 나의 얼굴을","a":"임수지","tr":[],"pub":"은행나무","y":"2025","isbn":"9791167375957","isbns":["9791167375957"],"cv":"https://image.yes24.com/goods/163268254/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9791167375957.jpg","f":"문학","n":"한국","e":"미상","l":"쉽게","pg":"312","ot":"","intro":"5천만 원 고료 제2회 아르떼문학상 수상작\n서로의 얼굴에 비친 나를 발견하고 넓혀가는 일에 대하여\n\n기성 작가와 신인 작가를 아우르며 한국문학의 새로운 지평을 열고자 한국경제신문사에서 신설한 아르떼문학상이 올해로 제2회를 맞이했다. 총 503편의 응모작 가운데 심사를 거쳐 만장일치로 소설가 임수지의 첫 장편소설 《잠든 나의 얼굴을》이 수상작으로 선정되었다. 할머니, 고모, 주인공으로 이어지는 가족의 슬픔과 아픔, 유대와 성장을 그린 이 작품은 “심사하고 있다는 것을 잊을 정도로 좋았던 소설”, “줄어가는 문학의 영토 속에서 오늘날 소설이 해야 하고 해낼 수 있는 일은 무엇인가를 진지하게 탐색하는 소설”이라는 평을 받으며 심사위원들의 지지를 이끌어냈다.\n소설은 주인공이 고모의 연락을 받고 할머니를 돌보기 위해 광주로 내려가는 것으로 시작한다.","icut":false,"toc":"1부\n잠 · 티켓 · 잠 · 영향 · 방 · 자주색 · 숨 · 빛나는 소라 고모 · 간장의 맛 · 잠 · 동맥 · 달고 끈적거리는 것 · 진짜와 가짜 · 눈물점 · 라면 · 빛나는 · 방 · 이백 원 · 복\n2부\n칼과 가위 · 나 · 작고 낮은 · 둥근 통증 · ^.^ · 방 · 잠 · 희게 빛나는 · 장면 · 손 · 불\n3부\n실내 정숙 · 하고 싶은 것을 한다 · 뺨 · 표본 · 브레이크 타임 · 잠 · 겨울밤 · 멀리 · 오직 · 오직 · 타고 남은 것 · 방 · 오직 · 오직 · 방 · 오직 · 옮겨 적기 · 얼굴\n에필로그\n작가의 말","recs":[["munhak","2026"]],"shorts":["문학나눔"],"univ":[],"au":{},"eb":[["YES24 eBook","https://www.yes24.com/product/goods/172018488"]],"full":{},"rel":[],"star":8.6,"y24":"https://www.yes24.com/product/goods/163268254","daum":"https://search.daum.net/search?w=bookpage&bookId=7068027&q=%EC%9E%A0%EB%93%A0+%EB%82%98%EC%9D%98+%EC%96%BC%EA%B5%B4%EC%9D%84","links":{"google":"https://www.google.com/search?q=%22%EC%9E%A0%EB%93%A0%20%EB%82%98%EC%9D%98%20%EC%96%BC%EA%B5%B4%EC%9D%84%22%20%EC%9E%84%EC%88%98%EC%A7%80","lib":"https://www.data4library.kr/srch?srchText=9791167375957","millie":"https://www.millie.co.kr/v3/search/result/%EC%9E%A0%EB%93%A0%20%EB%82%98%EC%9D%98%20%EC%96%BC%EA%B5%B4%EC%9D%84","ridi":"https://ridibooks.com/search?q=%EC%9E%A0%EB%93%A0%20%EB%82%98%EC%9D%98%20%EC%96%BC%EA%B5%B4%EC%9D%84","welaaa":"https://www.welaaa.com/search?keyword=%EC%9E%A0%EB%93%A0%20%EB%82%98%EC%9D%98%20%EC%96%BC%EA%B5%B4%EC%9D%84","kyobo":"https://search.kyobobook.co.kr/search?keyword=9791167375957","yes24":"https://www.yes24.com/product/search?query=9791167375957","elib":"https://www.google.com/search?q=%EC%9E%A0%EB%93%A0%20%EB%82%98%EC%9D%98%20%EC%96%BC%EA%B5%B4%EC%9D%84%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"b5bc3c97ad":{"id":"b5bc3c97ad","t":"파출소를 구원하라","a":"원도","tr":[],"pub":"나무옆의자","y":"2025","isbn":"9791161572239","isbns":["9791161572239"],"cv":"https://image.yes24.com/goods/145704976/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9791161572239.jpg","f":"문학","n":"한국","e":"미상","l":"쉽게","pg":"268","ot":"","intro":"환장의 파출소, 환상의 팀워크\n만년 꼴찌 파출소를 구원할 이들이 등판했다!\n\n『경찰관속으로』, 『아무튼, 언니』 원도 첫 장편소설\n\n예측할 수 없는 공이 날아드는 세상에서도\n더 나은 내일을 향해 온몸으로 진루하는 경찰관들의 이야기\n\n『경찰관속으로』와 『아무튼, 언니』, 『있었던 존재들』에서 경찰관의 삶을 주제로 하여 편지글, 에세이, 칼럼 등 다양한 형식으로 목소리를 내온 작가 원도가 첫 장편소설로 독자를 찾아왔다. 소설의 배경은 파출소, 주인공은 경찰관이다. 이쯤 되면 원도 작가에게 경찰 이야기를 쓴다는 것은 하나의 본능이자 숙명이라고 할 수 있지 않을까.\n\n『파출소를 구원하라』는 파출소에서 일어나는 크고 작은 사건을 통해 경찰관의 삶, 더 나아가 우리 모두가 영위하는 보편적인 삶에 대해 말하는 소설이다. 경찰관으로 8년간 일한 작가의 경력 덕분에 소설의 등장인물들은 모두 페이지를 뚫고 나와 살아 숨 쉬는 듯 생생하다.","icut":false,"toc":"1장 첫 타석은 데드볼\n2장 잘 쳐봐야 3할\n3장 평균 자책점\n4장 스토브 리그\n5장 우천 취소\n6장 삼진 아웃\n7장 퍼펙트게임\n에필로그 영구 결번\n작가의 말","recs":[["munhak","2025"]],"shorts":["문학나눔"],"univ":[],"au":{},"eb":[["YES24 eBook","https://www.yes24.com/product/goods/145943898"]],"full":{},"rel":[],"star":9.8,"y24":"https://www.yes24.com/product/goods/145704976","daum":"https://search.daum.net/search?w=bookpage&bookId=6899320&q=%ED%8C%8C%EC%B6%9C%EC%86%8C%EB%A5%BC+%EA%B5%AC%EC%9B%90%ED%95%98%EB%9D%BC","links":{"google":"https://www.google.com/search?q=%22%ED%8C%8C%EC%B6%9C%EC%86%8C%EB%A5%BC%20%EA%B5%AC%EC%9B%90%ED%95%98%EB%9D%BC%22%20%EC%9B%90%EB%8F%84","lib":"https://www.data4library.kr/srch?srchText=9791161572239","millie":"https://www.millie.co.kr/v3/search/result/%ED%8C%8C%EC%B6%9C%EC%86%8C%EB%A5%BC%20%EA%B5%AC%EC%9B%90%ED%95%98%EB%9D%BC","ridi":"https://ridibooks.com/search?q=%ED%8C%8C%EC%B6%9C%EC%86%8C%EB%A5%BC%20%EA%B5%AC%EC%9B%90%ED%95%98%EB%9D%BC","welaaa":"https://www.welaaa.com/search?keyword=%ED%8C%8C%EC%B6%9C%EC%86%8C%EB%A5%BC%20%EA%B5%AC%EC%9B%90%ED%95%98%EB%9D%BC","kyobo":"https://search.kyobobook.co.kr/search?keyword=9791161572239","yes24":"https://www.yes24.com/product/search?query=9791161572239","elib":"https://www.google.com/search?q=%ED%8C%8C%EC%B6%9C%EC%86%8C%EB%A5%BC%20%EA%B5%AC%EC%9B%90%ED%95%98%EB%9D%BC%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"b5b8b17bb2":{"id":"b5b8b17bb2","t":"프레너미","a":"심아진","tr":[],"pub":"강","y":"2024","isbn":"9788982183409","isbns":["9788982183409"],"cv":"https://image.yes24.com/goods/125877515/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788982183409.jpg","f":"문학","n":"한국","e":"현대","l":"쉽게","pg":"308","ot":"","intro":"여기, 결혼 육 년 차에 이유를 모른 채 아내로부터 헤어짐을 요구받은 남자가 있다. 서른다섯의 안경사 이재열. 어느 날 갑자기 사라져버린 아내 두윤서는 돌연 이혼을 통보해온다. 빈집과 빈 침대, 아내의 부재, 그의 이야기는 이렇게 제자리에 있던 것들의 질서가 동요하고 익숙함이 배반하는 풍경에서 시작된다.\n\n문제는 남자가 느끼기에 이 모든 일이 갑작스럽게 이루어졌고, 따라서 “아무런 이유가 없다”는 것이다. 징조나 전조 증세를 되짚어보다 지난밤 식탁에서의 사소한 다툼에서 애꿎은 이유를 끌어와보기도 하고, 외도를 의심해 아내를 미행하기도 하는 등 헤어짐의 이유와 원인을 찾기 위해 고군분투해보지만, 남자는 아무래도 그 이유를 ‘모른다’. 아이러니한 것은 이 ‘모른다’는 서술어가 나머지 문장들을 견인해가는 동력으로 작용한다는 점이다.\n\n이 소설에서 ‘모른다’는 서술어는 헤어짐의 이유 말고도 한 가지 목적어를 더 대동한다. 바로 결혼기념일에 도둑맞은 물건의 정체.","icut":false,"toc":"1부\n2부\n3부\n4부\n해설 기억과 망각, 연대와 적대의 아포리아 | 임정연\n작가의 말","recs":[["munhak","2024"]],"shorts":["문학나눔"],"univ":[],"au":{"b":1972,"kw":"심아진","en":"Ahjin Shim"},"eb":[],"full":{},"rel":[],"star":10,"y24":"https://www.yes24.com/product/goods/125877515","daum":"https://search.daum.net/search?w=bookpage&bookId=6605510&q=%ED%94%84%EB%A0%88%EB%84%88%EB%AF%B8","links":{"google":"https://www.google.com/search?q=%22%ED%94%84%EB%A0%88%EB%84%88%EB%AF%B8%22%20%EC%8B%AC%EC%95%84%EC%A7%84","lib":"https://www.data4library.kr/srch?srchText=9788982183409","millie":"https://www.millie.co.kr/v3/search/result/%ED%94%84%EB%A0%88%EB%84%88%EB%AF%B8","ridi":"https://ridibooks.com/search?q=%ED%94%84%EB%A0%88%EB%84%88%EB%AF%B8","welaaa":"https://www.welaaa.com/search?keyword=%ED%94%84%EB%A0%88%EB%84%88%EB%AF%B8","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788982183409","yes24":"https://www.yes24.com/product/search?query=9788982183409","elib":"https://www.google.com/search?q=%ED%94%84%EB%A0%88%EB%84%88%EB%AF%B8%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"b5beab4910":{"id":"b5beab4910","t":"리시안셔스","a":"연여름","tr":[],"pub":"황금가지","y":"2022","isbn":"9791170520733","isbns":["9791170520733"],"cv":"https://image.yes24.com/goods/108406100/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9791170520733.jpg","f":"문학","n":"한국","e":"미상","l":"쉽게","pg":"388","ot":"","intro":"한국 SF 어워드 수상 작가 연여름의 첫 번째 단편 소설집 『리시안셔스』가 출간되었다. 수상작 「리시안셔스」을 비롯, 수상 후보작인 「시금치 소테」 등을 포함하여 서정적이면서도 발랄한 매력이 돋보이는 총 9편의 단편 소설이 수록되어 있다. 수록작들은 21세기, 변두리에 서 있는 다양한 존재들의 이야기를 조명한다.\n\n표제작 「리시안셔스」는 시한부의 삶을 살아가던 ‘진’이 같은 사람인 ‘규희’에 의해 반려로서 입양되는 이야기다. 작가는 인간과 반려동물 사이의 일방적인 관계를 사람이 사람을 기르는 세계에 빗대어 동물권의 문제를 다룬다. 해당 작품은 480여 개에 이르는 후보 중 단연 세 손가락 안에 꼽히며 작품성을 인정받은 바 있으며 구한나리 심사위원장은 심사평을 통해 “SF만이 가능한 현실 비판의 예시 같은 작품”이라고 극찬했다.","icut":false,"toc":"리시안셔스 7\n시금치 소테 63\n표백 99\n제 오류는 아주 심각한 것 같아요 143\n가빙 라이트 173\n좀비 보호 구역 225\n비아 패스파인더 269\n면도 321\n오프 더 레코드 355","recs":[["munhak","2022"]],"shorts":["문학나눔"],"univ":[],"au":{},"eb":[["YES24 eBook","https://www.yes24.com/product/goods/108451820"]],"full":{},"rel":[],"star":9.6,"y24":"https://www.yes24.com/product/goods/108406100","daum":"https://search.daum.net/search?w=bookpage&bookId=6043452&q=%EB%A6%AC%EC%8B%9C%EC%95%88%EC%85%94%EC%8A%A4","links":{"google":"https://www.google.com/search?q=%22%EB%A6%AC%EC%8B%9C%EC%95%88%EC%85%94%EC%8A%A4%22%20%EC%97%B0%EC%97%AC%EB%A6%84","lib":"https://www.data4library.kr/srch?srchText=9791170520733","millie":"https://www.millie.co.kr/v3/search/result/%EB%A6%AC%EC%8B%9C%EC%95%88%EC%85%94%EC%8A%A4","ridi":"https://ridibooks.com/search?q=%EB%A6%AC%EC%8B%9C%EC%95%88%EC%85%94%EC%8A%A4","welaaa":"https://www.welaaa.com/search?keyword=%EB%A6%AC%EC%8B%9C%EC%95%88%EC%85%94%EC%8A%A4","kyobo":"https://search.kyobobook.co.kr/search?keyword=9791170520733","yes24":"https://www.yes24.com/product/search?query=9791170520733","elib":"https://www.google.com/search?q=%EB%A6%AC%EC%8B%9C%EC%95%88%EC%85%94%EC%8A%A4%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"b5b8b2b6d9":{"id":"b5b8b2b6d9","t":"종말 하나만 막고 올게","a":"임태운","tr":[],"pub":"시공사","y":"2021","isbn":"9791165796020","isbns":["9791165796020"],"cv":"https://image.yes24.com/goods/102387338/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9791165796020.jpg","f":"문학","n":"한국","e":"현대","l":"쉽게","pg":"316","ot":"","intro":"한국 SF를 이끄는 젊은 작가 임태운의\n명랑하고, 우주적인 이야기 세계\n\n임태운 작가는 2006년 단편 「앱솔루트 바디」를 발표하고, 이듬해 한국전자출판협회 제2회 디지털작가상 우수상을 수상한 장편 『이터널 마일』을 펴내며 본격적으로 작가의 길을 걷기 시작했다. 어느덧 15년차 작가가 되었지만 여전히 그만의 젊은 감각과 독특한 아이디어로 결말을 예측할 수 없는 이야기를 써 내려가고 있다. 『종말 하나만 막고 올게』는 9년 만에 출간되는 임태운 작가의 두 번째 소설집이다. 데뷔작인 「앱솔루트 바디」를 개작한 「궁극의 몸」을 비롯해, 네이버 오늘의 문학에 게재되어 많은 독자들로부터 호평받았던 「가울반점」, 이번에 처음 공개하는 신작이자 표제작 「종말 하나만 막고 올게」 등 작가가 애착을 가지고 엄선한 여섯 개의 단편을 수록했다.","icut":false,"toc":"1장 가울반점\n2장 종말 하나만 막고 올게\n3장 궁극의 몸(Absolute Body)\n4장 이빨에 끼인 돌개바람\n5장 레어템의 보존법칙\n6장 로봇이라서 다행이야\n작가의 말","recs":[["munhak","2021"]],"shorts":["문학나눔"],"univ":[],"au":{"b":1985,"kw":"임태운"},"eb":[],"full":{},"rel":[],"star":9.5,"y24":"https://www.yes24.com/product/goods/102387338","daum":"https://search.daum.net/search?w=bookpage&bookId=5752383&q=%EC%A2%85%EB%A7%90+%ED%95%98%EB%82%98%EB%A7%8C+%EB%A7%89%EA%B3%A0+%EC%98%AC%EA%B2%8C","links":{"google":"https://www.google.com/search?q=%22%EC%A2%85%EB%A7%90%20%ED%95%98%EB%82%98%EB%A7%8C%20%EB%A7%89%EA%B3%A0%20%EC%98%AC%EA%B2%8C%22%20%EC%9E%84%ED%83%9C%EC%9A%B4","lib":"https://www.data4library.kr/srch?srchText=9791165796020","millie":"https://www.millie.co.kr/v3/search/result/%EC%A2%85%EB%A7%90%20%ED%95%98%EB%82%98%EB%A7%8C%20%EB%A7%89%EA%B3%A0%20%EC%98%AC%EA%B2%8C","ridi":"https://ridibooks.com/search?q=%EC%A2%85%EB%A7%90%20%ED%95%98%EB%82%98%EB%A7%8C%20%EB%A7%89%EA%B3%A0%20%EC%98%AC%EA%B2%8C","welaaa":"https://www.welaaa.com/search?keyword=%EC%A2%85%EB%A7%90%20%ED%95%98%EB%82%98%EB%A7%8C%20%EB%A7%89%EA%B3%A0%20%EC%98%AC%EA%B2%8C","kyobo":"https://search.kyobobook.co.kr/search?keyword=9791165796020","yes24":"https://www.yes24.com/product/search?query=9791165796020","elib":"https://www.google.com/search?q=%EC%A2%85%EB%A7%90%20%ED%95%98%EB%82%98%EB%A7%8C%20%EB%A7%89%EA%B3%A0%20%EC%98%AC%EA%B2%8C%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"b5bf32d3e2":{"id":"b5bf32d3e2","t":"호르몬이 그랬어","a":"박서련","tr":[],"pub":"자음과모음","y":"2021","isbn":"9788954446334","isbns":["9788954446334"],"cv":"https://image.yes24.com/goods/97172059/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788954446334.jpg","f":"문학","n":"한국","e":"현대","l":"쉽게","pg":"136","ot":"","intro":"“첫 문장은 남겨두자.\n바뀌지 않는 것도 있어야지.\n이건 바뀌지 않는 것에 대한 소설이기도 하니까.”\n\n한겨레문학상 수상 작가 박서련의\n트리플 시리즈 첫 번째 소설\n\n[자음과모음 트리플 시리즈]는 한국문학의 새로운 작가들을 시차 없이 접할 수 있는 기획이다. 2015년 『실천문학』으로 데뷔하여 장편소설 『체공녀 강주룡』으로 제23회 한겨레문학상을 수상한 신예 작가 박서련의 『호르몬이 그랬어』가 [트리플 시리즈] 1번으로 출간되었다.\n\n이 책은 장편소설 『체공녀 강주룡』 『마르타의 일』 『더 셜리 클럽』을 통해 각기 다른 시대와 각기 다른 공간에 존재했던 여성 인물의 삶을 작가적 상상력으로 다채롭게 변주해온 박서련의 첫 번째 소설집이기도 하다. 『호르몬이 그랬어』에 실린 세 편의 소설은 온난한 기후에서 궤를 이탈해버린, 한랭기단이 드리운 현실을 살아가고 있는 동시대 동세대 청년들의 삶에 대해 이야기하고 있어 작가의 목소리에 가장 가까이 닿아 있는 작품이다.","icut":false,"toc":"다시 바람은 그대 쪽으로\n호르몬이 그랬어\n총塚\n에세이 ……라고 썼다\n해설 겨울의 습작_윤경희","recs":[["munhak","2021"]],"shorts":["문학나눔"],"univ":[],"au":{"b":1989,"en":"Park Seo-lyeon"},"eb":[["YES24 eBook","https://www.yes24.com/product/goods/97172557"]],"full":{},"rel":[],"star":9,"y24":"https://www.yes24.com/product/goods/97172059","daum":"https://search.daum.net/search?w=bookpage&bookId=5586994&q=%ED%98%B8%EB%A5%B4%EB%AA%AC%EC%9D%B4+%EA%B7%B8%EB%9E%AC%EC%96%B4","links":{"google":"https://www.google.com/search?q=%22%ED%98%B8%EB%A5%B4%EB%AA%AC%EC%9D%B4%20%EA%B7%B8%EB%9E%AC%EC%96%B4%22%20%EB%B0%95%EC%84%9C%EB%A0%A8","lib":"https://www.data4library.kr/srch?srchText=9788954446334","millie":"https://www.millie.co.kr/v3/search/result/%ED%98%B8%EB%A5%B4%EB%AA%AC%EC%9D%B4%20%EA%B7%B8%EB%9E%AC%EC%96%B4","ridi":"https://ridibooks.com/search?q=%ED%98%B8%EB%A5%B4%EB%AA%AC%EC%9D%B4%20%EA%B7%B8%EB%9E%AC%EC%96%B4","welaaa":"https://www.welaaa.com/search?keyword=%ED%98%B8%EB%A5%B4%EB%AA%AC%EC%9D%B4%20%EA%B7%B8%EB%9E%AC%EC%96%B4","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788954446334","yes24":"https://www.yes24.com/product/search?query=9788954446334","elib":"https://www.google.com/search?q=%ED%98%B8%EB%A5%B4%EB%AA%AC%EC%9D%B4%20%EA%B7%B8%EB%9E%AC%EC%96%B4%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"b5b6fb5d65":{"id":"b5b6fb5d65","t":"총구에 핀 꽃","a":"이대환","tr":[],"pub":"아시아","y":"2019","isbn":"9791156624066","isbns":["9791156624066"],"cv":"https://image.yes24.com/goods/71859704/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9791156624066.jpg","f":"문학","n":"한국","e":"현대","l":"쉽게","pg":"360","ot":"","intro":"데뷔 40주년을 앞둔 소설가 이대환이 11년 만에 들고 온 장편소설 『총구에 핀 꽃』은 베트남전쟁이 낳은 또 다른 상처를 드러내며 진정한 세계평화의 길을 모색한 우리 시대의 문제작이다. 실존일물인 김진수를 모델로, 한국전쟁의 고아 출신이 미군으로 참전한 베트남전쟁의 상처를 부여안고 ‘작은 인간’의 영혼에 남은 평화를 지키기 위해 지구를 거의 한 바퀴 돌아야 했던 손진호를 주인공으로 내세웠다. 그의 외롭지만 의로운 여행이 소설을 이룬다.\n\n아들 손기정이 나로 등장하여 요나스 요나손이라는 스웨덴 이름을 가진 아버지와 함께 일본과 한국을 여행하는 지금의 이야기 속에 아들 손기정이 아버지 손진호에 대해 쓴 소설이 수시로 나오는 액자소설 형식의 이 소설은, 작가가 작가 후기를 통해 밝혔듯 ‘김진수를 소설에서도 살아가게 하는 방법’의 하나로 ‘허구라는 이름으로 작가의 정신과 상상력을 담아낸 소설적 특권’을 한껏 발휘했다.","icut":false,"toc":"1장 바나나 태우는 청년\n2장 꽃과 전단\n3장 유폐의 노고지리\n4장 새 소리\n작가 후기\n해설_자유의 노고지리를 위하여(이경재)","recs":[["munhak","2019"]],"shorts":["문학나눔"],"univ":[],"au":{"b":1979,"kw":"이대환","en":"Lee Dae-hwan"},"eb":[["YES24 eBook","https://www.yes24.com/product/goods/90555678"]],"full":{},"rel":[],"star":9.1,"y24":"https://www.yes24.com/product/goods/71859704","daum":"https://search.daum.net/search?w=bookpage&bookId=4918662&q=%EC%B4%9D%EA%B5%AC%EC%97%90+%ED%95%80+%EA%BD%83%28%EC%95%84%EC%8B%9C%EC%95%84+%EB%AC%B8%ED%95%99%EC%84%A0+21%29","links":{"google":"https://www.google.com/search?q=%22%EC%B4%9D%EA%B5%AC%EC%97%90%20%ED%95%80%20%EA%BD%83%22%20%EC%9D%B4%EB%8C%80%ED%99%98","lib":"https://www.data4library.kr/srch?srchText=9791156624066","millie":"https://www.millie.co.kr/v3/search/result/%EC%B4%9D%EA%B5%AC%EC%97%90%20%ED%95%80%20%EA%BD%83","ridi":"https://ridibooks.com/search?q=%EC%B4%9D%EA%B5%AC%EC%97%90%20%ED%95%80%20%EA%BD%83","welaaa":"https://www.welaaa.com/search?keyword=%EC%B4%9D%EA%B5%AC%EC%97%90%20%ED%95%80%20%EA%BD%83","kyobo":"https://search.kyobobook.co.kr/search?keyword=9791156624066","yes24":"https://www.yes24.com/product/search?query=9791156624066","elib":"https://www.google.com/search?q=%EC%B4%9D%EA%B5%AC%EC%97%90%20%ED%95%80%20%EA%BD%83%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"b5b9454985":{"id":"b5b9454985","t":"수치","a":"전수찬","tr":[],"pub":"창비","y":"2014","isbn":"9788936434113","isbns":["9788936434113"],"cv":"https://image.yes24.com/goods/12563514/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788936434113.jpg","f":"문학","n":"한국","e":"미상","l":"쉽게","pg":"208","ot":"","intro":"문학동네작가상(2004)을 수상하며 작품활동을 시작한 작가 전수찬의 세번째 장편소설 『수치』가 출간되었다. 등단 당시 ‘개개인의 실존적 고뇌와 삶에 관한 녹록지 않은 통찰력을 보여준다’(신수정)는 평을 받은 그가 본격적으로 인간의 가장 내밀하고도 연약한 감정, ‘수치’를 치밀하게 파헤친다.\n\n삶의 지척에 있는 죽음의 그림자와 끊임없이 다투는 세명의 탈북자. 살아남았다는 수치심에 자신의 삶을 방기하는 그들의 슬픔과 번뇌는 극도로 자본화된 사회에서 최소한의 도덕조차 내던진 사람들과 대비되며 생의 비참한 더께를 극명하게 드러낸다. 여러 층위의 사회적 문제를 개인의 내밀한 기억과 맞물려 제시하고, 빈틈없는 대화에 실어 형상화하는 작가의 재주가 돋보인다.","icut":false,"toc":"","recs":[["munhak","2014"]],"shorts":["문학나눔"],"univ":[],"au":{},"eb":[["YES24 eBook","https://www.yes24.com/product/goods/176968839"]],"full":{},"rel":[],"star":9.3,"y24":"https://www.yes24.com/product/goods/12563514","daum":"https://search.daum.net/search?w=bookpage&bookId=532448&q=%EC%88%98%EC%B9%98","links":{"google":"https://www.google.com/search?q=%22%EC%88%98%EC%B9%98%22%20%EC%A0%84%EC%88%98%EC%B0%AC","lib":"https://www.data4library.kr/srch?srchText=9788936434113","millie":"https://www.millie.co.kr/v3/search/result/%EC%88%98%EC%B9%98","ridi":"https://ridibooks.com/search?q=%EC%88%98%EC%B9%98","welaaa":"https://www.welaaa.com/search?keyword=%EC%88%98%EC%B9%98","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788936434113","yes24":"https://www.yes24.com/product/search?query=9788936434113","elib":"https://www.google.com/search?q=%EC%88%98%EC%B9%98%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"b5be743b1e":{"id":"b5be743b1e","t":"바디 페인팅","a":"박금산","tr":[],"pub":"실천문학사","y":"2007","isbn":"9788939205888","isbns":["9788939205888"],"cv":"https://image.yes24.com/goods/4470611/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788939205888.jpg","f":"문학","n":"한국","e":"미상","l":"쉽게","pg":"389","ot":"","intro":"2001년 『문예중앙』으로 등단한 박금산의 두번째 소설집. 그간 발표해온 연작 중·단편소설 4편을 하나로 묶어내었다. 4편의 소설들은 표면적으로는 ‘문화예술위원회 지원금 운용기’나 ‘실행기’이지만 또한, ‘교통사고 수습 처리기’이며 ‘영어학원 환불체험기’이고 ‘누나 카드빚 상환 갈등기’이거나 ‘멜가트 답사 좌절기’로 보일 법도 하지만 세부를 들여다보면 그렇지 않다. 그의 연작소설은 시작부터 끝까지 '제도'와 맞닿아 있다. 우리 시대의 소설가, 그들의 일상이고 생계이며 작품생산과 관계되는 체계, 혹은 제도?..","icut":false,"toc":"제1호 생활의 자세\n제2호 행복한 만보\n제3호 소설은 아름다워\n제4호 거긴 인도였어요\n해설 서영인\n작가의 말","recs":[["munhak","2007"]],"shorts":["문학나눔"],"univ":[],"au":{},"eb":[],"full":{},"rel":[],"star":0,"y24":"https://www.yes24.com/product/goods/4470611","daum":"https://search.daum.net/search?w=bookpage&bookId=554910&q=%EB%B0%94%EB%94%94+%ED%8E%98%EC%9D%B8%ED%8C%85","links":{"google":"https://www.google.com/search?q=%22%EB%B0%94%EB%94%94%20%ED%8E%98%EC%9D%B8%ED%8C%85%22%20%EB%B0%95%EA%B8%88%EC%82%B0","lib":"https://www.data4library.kr/srch?srchText=9788939205888","millie":"https://www.millie.co.kr/v3/search/result/%EB%B0%94%EB%94%94%20%ED%8E%98%EC%9D%B8%ED%8C%85","ridi":"https://ridibooks.com/search?q=%EB%B0%94%EB%94%94%20%ED%8E%98%EC%9D%B8%ED%8C%85","welaaa":"https://www.welaaa.com/search?keyword=%EB%B0%94%EB%94%94%20%ED%8E%98%EC%9D%B8%ED%8C%85","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788939205888","yes24":"https://www.yes24.com/product/search?query=9788939205888","elib":"https://www.google.com/search?q=%EB%B0%94%EB%94%94%20%ED%8E%98%EC%9D%B8%ED%8C%85%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"b5b97aba02":{"id":"b5b97aba02","t":"이곳에 볕이 잘 듭니다","a":"한순","tr":[],"pub":"나무생각","y":"2021","isbn":"9791162181454","isbns":["9791162181454"],"cv":"https://image.yes24.com/goods/99101770/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9791162181454.jpg","f":"문학","n":"한국","e":"근세","l":"쉽게","pg":"224","ot":"","intro":"도시에서 나흘, 시골에서 사흘\n시간과 환경을 견디며 나를 되찾는\n본질 회복 에세이\n“자신의 허약함을 보는 일은 그리 기쁘지는 않지만 감사한 일이다.”\n\n‘도사시삼’, 말 그대로 도시에서 4일을 살고 시골에서 3일을 살겠다는 건 작가에게 크나큰 결심이었다. 출판사를 운영하고, 두 아이를 키우며 누구보다 치열하게 살았다. 그런데 오십 중반이 되어서 삶의 에너지가 다 고갈된 듯한 허기가 몰려왔다. 도시에서 나흘, 시골에서 사흘, 반절짜리 귀촌을 선택한 작가는 시골에만 가면, 빽빽한 빌딩숲을 벗어나 나무와 흙냄새 나는 시골로 들어가기만 하면 모든 게 해결될 줄 알았다. 하지만 도시와 시골을 오가는 그 생활도 숨 가쁘긴 매한가지였다. 관성을 뿌리치며 일터인 도시에서 시골로, 시골에서 도시로 매주 오가는 것도 그렇지만, 내적으로도 살면서 부러 외면하고 떨어뜨려 놓았던 본질과의 밀당이 본격 시작되었기 때문이다.","icut":false,"toc":"책머리에\n봄 ─ 이곳에 볕이 잘 듭니다\n진달래 꽃도장\n목련이라는 영화\n이곳에 볕이 잘 듭니다\n다시 페이지는 넘어간다\n가난했던 날의 초상 1 - 무심천과 금반지\n같이 갑시다\n당신에게 - 우리가 잊고 있는 것들\n여름 ─ 이제 와 새삼\n스스로 그러한 것들\n당선 소감\n이제 와 새삼\n엄마의 수묵화\n외갓집 향기는 왜 이렇게 달큰할까?\n유리창을 사이에 두고\n프리랜서\n가난했던 날의 초상 2 - 촉촉한 건빵\n가을 ─ 느림 속으로\n도토리가 질문을 던졌다\n꽃의 하안거\n11월을 좋아하세요?\n유키 엄마와 춤을\n느림 속으로\n쉼표, 1초의 미학\n어머니, 된장 좀 주세요\n겨울 ─ 산부추꽃\n1월, 새의 묵상\n그래서 오늘도 가방을 싼다\n모피코트는 어디로 갔을까?\n산부추꽃\n반으로 줄여야 해\n가장 먼저 보여주고 싶은 사람\n열정과 사랑","recs":[["munhak","2021"]],"shorts":["문학나눔"],"univ":[],"au":{"b":1453,"d":1541,"kw":"한순 (1453년)","en":"Han Sun"},"eb":[["YES24 eBook","https://www.yes24.com/product/goods/99400442"]],"full":{},"rel":[["h","k1075407","한순 (1453년)"]],"star":9.5,"y24":"https://www.yes24.com/product/goods/99101770","daum":"https://search.daum.net/search?w=bookpage&bookId=5638410&q=%EC%9D%B4%EA%B3%B3%EC%97%90+%EB%B3%95%EC%9D%B4+%EC%9E%98+%EB%93%AD%EB%8B%88%EB%8B%A4","links":{"google":"https://www.google.com/search?q=%22%EC%9D%B4%EA%B3%B3%EC%97%90%20%EB%B3%95%EC%9D%B4%20%EC%9E%98%20%EB%93%AD%EB%8B%88%EB%8B%A4%22%20%ED%95%9C%EC%88%9C","lib":"https://www.data4library.kr/srch?srchText=9791162181454","millie":"https://www.millie.co.kr/v3/search/result/%EC%9D%B4%EA%B3%B3%EC%97%90%20%EB%B3%95%EC%9D%B4%20%EC%9E%98%20%EB%93%AD%EB%8B%88%EB%8B%A4","ridi":"https://ridibooks.com/search?q=%EC%9D%B4%EA%B3%B3%EC%97%90%20%EB%B3%95%EC%9D%B4%20%EC%9E%98%20%EB%93%AD%EB%8B%88%EB%8B%A4","welaaa":"https://www.welaaa.com/search?keyword=%EC%9D%B4%EA%B3%B3%EC%97%90%20%EB%B3%95%EC%9D%B4%20%EC%9E%98%20%EB%93%AD%EB%8B%88%EB%8B%A4","kyobo":"https://search.kyobobook.co.kr/search?keyword=9791162181454","yes24":"https://www.yes24.com/product/search?query=9791162181454","elib":"https://www.google.com/search?q=%EC%9D%B4%EA%B3%B3%EC%97%90%20%EB%B3%95%EC%9D%B4%20%EC%9E%98%20%EB%93%AD%EB%8B%88%EB%8B%A4%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"b5b6c2b72e":{"id":"b5b6c2b72e","t":"된장 담그는 시인","a":"이위발","tr":[],"pub":"엠블라","y":"2014","isbn":"9788995915561","isbns":["9788995915561"],"cv":"https://image.yes24.com/goods/12222145/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788995915561.jpg","f":"문학","n":"한국","e":"미상","l":"쉽게","pg":"280","ot":"","intro":"된장 담그는 시인 이위발의 첫 산문집\n\n고향이란 무엇일까? 뜨내기가 될 수밖에 없는 요즘 세상에 고향의 의미에 대해 묻는 것은 어쩌면 의미가 없는 일일 수도 있다. 태어나서 평생 같은 곳에서 살아가는 사람도 있겠지만 그렇지 않은 사람들이 더 많을 것이다. 하지만 그럼에도 불구하고 사람들은 끊임없이 ‘향수’라는 감정에 사로잡힌다. 여우가 죽을 때 고향을 향해 머리를 돌리듯, 고향을 향한 그리움이란 떼어내려야 떼어낼 수가 없는 것일지도 모른다.\n엠블라에서 출간된 시인 이위발의 첫 산문집 『된장 담그는 시인』은 이런 그리움의 정서를 자극한다. 저자는 경북 안동에서 ‘된장 담그는 시인’으로 살아가면서 보고, 듣고, 느꼈던 것들을 감성적인 산문으로 엮어냈다. 이 책을 읽으면서 독자들은 돌아가고 싶지만 그럴 수 없었던 고향을 느끼고 잠시 아련한 기분에 빠질 수 있을 것이다.","icut":false,"toc":"책을 내면서\n제1부 이 세상천지에 나 아닌 것이 없다\n제비 몰러 나간다! / 몸을 낮추고 바라보면 또 다른 세상이 보입니다\n한 편만 더 소설을 쓰고 싶다! / 만 원의 행복\n부끄러워할 줄 아는 사람이 그립다 / 행복은 어디에서 찾아오는가?\n역사는 잔인하지만 살아 있음은 아름답다 / 이 세상천지에 나 아닌 것이 없다\n거미보다 못한 사람들 / 느낌이 가져다준 신바람\n제2부 메주 향에서 시작되는 산매골의 봄\n눈물 흘리는 항아리 / 따뜻한 사람이 그리운 아침\n메주 향에서 시작되는 산매골의 봄 / 정성을 다하지 않는 충고는 상처만 남긴다\n아버지의 침묵이 너무 그립습니다 / 가난을 원수로 여기면 가난 때문에 죽는다\n상상력이 가져다주는 즐거움 / 동박새가 노래하는 아침\n우리가 왜 눈물을 흘려야 하는지…… / 개구리들의 웃음소리\n제3부 시는 어제의 고향이고 내일의 고향이다\n욕심과 조급함을 반성하며 / 시는 어제의 고향이고 내일의 고향이다\n아버지의 유언 / 인생유전\n애기집 / 안개 속에 묻혀버린 깍새를 찾아서\n시를 쓸지언정 유언은 쓰지 않겠소! / 이 시대에 시인으로 살아가는 길\n빌뱅이 언덕에서 울려 퍼지는 말똥굴레 노래 / 문학의 토양을 이룬 반성의 정신","recs":[["munhak","2014"]],"shorts":["문학나눔"],"univ":[],"au":{},"eb":[["YES24 eBook","https://www.yes24.com/product/goods/102791538"]],"full":{},"rel":[],"star":0,"y24":"https://www.yes24.com/product/goods/12222145","daum":"https://search.daum.net/search?w=bookpage&bookId=1455156&q=%EB%90%9C%EC%9E%A5+%EB%8B%B4%EA%B7%B8%EB%8A%94+%EC%8B%9C%EC%9D%B8","links":{"google":"https://www.google.com/search?q=%22%EB%90%9C%EC%9E%A5%20%EB%8B%B4%EA%B7%B8%EB%8A%94%20%EC%8B%9C%EC%9D%B8%22%20%EC%9D%B4%EC%9C%84%EB%B0%9C","lib":"https://www.data4library.kr/srch?srchText=9788995915561","millie":"https://www.millie.co.kr/v3/search/result/%EB%90%9C%EC%9E%A5%20%EB%8B%B4%EA%B7%B8%EB%8A%94%20%EC%8B%9C%EC%9D%B8","ridi":"https://ridibooks.com/search?q=%EB%90%9C%EC%9E%A5%20%EB%8B%B4%EA%B7%B8%EB%8A%94%20%EC%8B%9C%EC%9D%B8","welaaa":"https://www.welaaa.com/search?keyword=%EB%90%9C%EC%9E%A5%20%EB%8B%B4%EA%B7%B8%EB%8A%94%20%EC%8B%9C%EC%9D%B8","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788995915561","yes24":"https://www.yes24.com/product/search?query=9788995915561","elib":"https://www.google.com/search?q=%EB%90%9C%EC%9E%A5%20%EB%8B%B4%EA%B7%B8%EB%8A%94%20%EC%8B%9C%EC%9D%B8%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"b5b4068c41":{"id":"b5b4068c41","t":"즐리 삼 형제","a":"알렉스 쿠소","tr":["나선희"],"pub":"책빛","y":"2025","isbn":"9788962194821","isbns":["9788962194821"],"cv":"https://image.yes24.com/goods/141905717/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788962194821.jpg","f":"언어·교양","n":"미상","e":"미상","l":"쉽게","pg":"40","ot":"Les Freres Zzli","intro":"2024년 알베르틴상\n이주민에 대한 공동체의 역할과 책임\n따뜻한 환대와 사랑의 실천\n\n어느 추운 겨울날, 깊은 숲속에 사는 한 소녀가 집을 잃고 살 곳을 찾아 헤매는 즐리 삼 형제를 따뜻하게 맞이합니다. 소녀와 즐리 삼 형제는 친구가 되고, 소녀의 집은 아픔을 치유하고, 희망을 꿈꾸는 안식처가 됩니다. 하지만 이웃들은 곧 세상의 모든 곰들이 숲을 차지할 거라며 즐리 삼 형제를 의심하고 경계합니다. 어느 날 수상한 화재로 집이 다 타버리자 즐리 삼 형제와 소녀는 마침내 그들을 따뜻하게 맞아줄 집을 향해 다시 길을 떠납니다.\n\n볼로냐 라가치상 대상을 수상한 알렉스 쿠소 작가와 안리즈 부탱 작가는 어린이들에게 친숙한 사랑스러운 곰 삼 형제를 주인공으로 난민과 이주민을 수용하는 문제를 어린이의 눈높이에서 바라볼 수 있도록 이끌며, 고전적이며 밝고 경쾌한 그림에 새로운 이웃을 향한 따뜻한 환대와 사랑을 담아내며 공동체의 역할과 책임을 일깨웁니다.","icut":false,"toc":"","recs":[["munhak","2025"]],"shorts":["문학나눔"],"univ":[],"au":{},"eb":[],"full":{},"rel":[],"star":10,"y24":"https://www.yes24.com/product/goods/141905717","daum":"https://search.daum.net/search?w=bookpage&bookId=6829278&q=%EC%A6%90%EB%A6%AC+%EC%82%BC+%ED%98%95%EC%A0%9C","links":{"google":"https://www.google.com/search?q=%22%EC%A6%90%EB%A6%AC%20%EC%82%BC%20%ED%98%95%EC%A0%9C%22%20%EC%95%8C%EB%A0%89%EC%8A%A4%20%EC%BF%A0%EC%86%8C","lib":"https://www.data4library.kr/srch?srchText=9788962194821","millie":"https://www.millie.co.kr/v3/search/result/%EC%A6%90%EB%A6%AC%20%EC%82%BC%20%ED%98%95%EC%A0%9C","ridi":"https://ridibooks.com/search?q=%EC%A6%90%EB%A6%AC%20%EC%82%BC%20%ED%98%95%EC%A0%9C","welaaa":"https://www.welaaa.com/search?keyword=%EC%A6%90%EB%A6%AC%20%EC%82%BC%20%ED%98%95%EC%A0%9C","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788962194821","yes24":"https://www.yes24.com/product/search?query=9788962194821","elib":"https://www.google.com/search?q=%EC%A6%90%EB%A6%AC%20%EC%82%BC%20%ED%98%95%EC%A0%9C%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"b5bdede8c9":{"id":"b5bdede8c9","t":"안의 가방","a":"박영란","tr":[],"pub":"창비","y":"2021","isbn":"9788936457044","isbns":["9788936457044"],"cv":"https://image.yes24.com/goods/103450806/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788936457044.jpg","f":"언어·교양","n":"한국","e":"미상","l":"쉽게","pg":"176","ot":"","intro":"서두르지 않고 천천히 성장해 가는 이들을 위하여\n『편의점 가는 기분』 박영란 작가 신작\n\n『편의점 가는 기분』과 『게스트하우스 Q』로 학교 현장에서 많은 사랑을 받은 박영란 작가의 소설집 『안의 가방』이 창비청소년문학 104번으로 출간되었다. 그동안 도시 재개발, 청소년의 노동 등 소외된 자리에 꾸준한 관심을 보여 온 작가의 단편소설 일곱 편을 모았다. 재개발 지역의 나무부터 매일 같은 시간 편의점에 오는 손님, 아파트 단지의 길고양이까지, 우리 곁을 스쳐 지나는 작은 존재를 향한 따스한 시선이 돋보인다. 서두르지 않고 천천히 성장하는 이들, 주목받지 못하더라도 자신만의 자리를 위해 목소리를 내는 모든 이를 위한 소설집이다.","icut":false,"toc":"이 나무는 내 친구입니다\n안의 가방\n간신히\n상어를 기다리며\n소소한 명예\n나만 할 수 있는 일\n수지\n작가의 말\n수록 작품 발표 지면","recs":[["munhak","2021"]],"shorts":["문학나눔"],"univ":[],"au":{},"eb":[["YES24 eBook","https://www.yes24.com/product/goods/176969263"]],"full":{},"rel":[],"star":10,"y24":"https://www.yes24.com/product/goods/103450806","daum":"https://search.daum.net/search?w=bookpage&bookId=5823952&q=%EC%95%88%EC%9D%98+%EA%B0%80%EB%B0%A9","links":{"google":"https://www.google.com/search?q=%22%EC%95%88%EC%9D%98%20%EA%B0%80%EB%B0%A9%22%20%EB%B0%95%EC%98%81%EB%9E%80","lib":"https://www.data4library.kr/srch?srchText=9788936457044","millie":"https://www.millie.co.kr/v3/search/result/%EC%95%88%EC%9D%98%20%EA%B0%80%EB%B0%A9","ridi":"https://ridibooks.com/search?q=%EC%95%88%EC%9D%98%20%EA%B0%80%EB%B0%A9","welaaa":"https://www.welaaa.com/search?keyword=%EC%95%88%EC%9D%98%20%EA%B0%80%EB%B0%A9","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788936457044","yes24":"https://www.yes24.com/product/search?query=9788936457044","elib":"https://www.google.com/search?q=%EC%95%88%EC%9D%98%20%EA%B0%80%EB%B0%A9%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"b5bbcfdc2b":{"id":"b5bbcfdc2b","t":"바람이 눈을 빛내고 있었어","a":"문신","tr":[],"pub":"문학동네","y":"2020","isbn":"9788954674232","isbns":["9788954674232"],"cv":"https://image.yes24.com/goods/92364853/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788954674232.jpg","f":"언어·교양","n":"한국","e":"미상","l":"쉽게","pg":"132","ot":"","intro":"바람이 스치듯 기미와 낌새로 연행(演行)된다.\n열두 살, 그 좋아하고 설레고 외롭고 두렵고 기대되는 마음들을\n어떤 형용사로 표현할 수 있을까.” _송선미(『동시마중』 발행인, 동시인)\n\n| 열두 살이 된다는 건\n| 바람이 연주하는 노래를 온몸으로 따라 부르는 일이지\n\n문신 시인의 첫 동시집입니다. 시를 써 왔던 그는 세 아이를 키우며 동시를 쓰기 시작했습니다. 2015년 조선일보 신춘문예에 동시로 당선되었고 문학동네동시문학상에서는 제5회, 제6회, 제7회 등 무려 세 차례에 걸쳐 최종 본심에 올랐습니다. 특히 마지막까지 격론의 대상이 되었던 제7회 문학동네동시문학상 심사 당시 ‘시적 세련성에서 단연 돋보인다/ 말을 다루는 솜씨가 빼어나다/ 어디 거칠거나 어색한 언어의 실밥이 도무지 눈에 띄지 않을 정도로 잘 다듬어져 있다’라는 평을 받은 바 있습니다.","icut":false,"toc":"제1부 열두 살이 된다는 건\n바람의 그림자 | 혼나는 나무 | 2월 30일 | 강가에 굴러떨어지는 돌멩이 |\n고래라는 이름의 고양이 | 뒤로 걸으면 | 열한 시 | 가을 하늘과 이마 |\n하늘 기둥 | 솜이불 | 달의 마술사\n제2부 어디선가 나를 닮은 또 다른 아이도\n바람의 눈 | 두꺼비 운동화 | 시험 끝나면 | 불꽃인데 | 막힌 말 | 윤이가 좋다 |\n겨울밤 | 유리컵 | 달이 좋아요 | 이사 | 고물 자동차\n제3부 큰 목소리로 이름 부르면\n대팻밥 | 가을 저녁 | 하늘을 나는 가위 | 봄 햇빛 공수 대작전 | 등산 |\n바람이 불어올 때 | 무릎으로 웃는다 | 무서운 가을 | 달팽이와 참꽃마리 |\n요기 조기 저기 | 작은 것들 | 콩과 콩새와 별\n제4부 흐린 날엔 구름책을 펼친다\n웃지 마, 꽃! | 물 그림 | 뿔난 발톱 | 반달 | 비를 듣는다 | 늑대와 북적북적 도서관 |\n봄비 내릴 때 구름 위에는 | 달력 | 나무도 안다 | 소나기 지나갈 때 | 연극\n해설_송선미","recs":[["munhak","2020"]],"shorts":["문학나눔"],"univ":[],"au":{},"eb":[],"full":{},"rel":[],"star":4,"y24":"https://www.yes24.com/product/goods/92364853","daum":"https://search.daum.net/search?w=bookpage&bookId=5461959&q=%EB%B0%94%EB%9E%8C%EC%9D%B4+%EB%88%88%EC%9D%84+%EB%B9%9B%EB%82%B4%EA%B3%A0+%EC%9E%88%EC%97%88%EC%96%B4","links":{"google":"https://www.google.com/search?q=%22%EB%B0%94%EB%9E%8C%EC%9D%B4%20%EB%88%88%EC%9D%84%20%EB%B9%9B%EB%82%B4%EA%B3%A0%20%EC%9E%88%EC%97%88%EC%96%B4%22%20%EB%AC%B8%EC%8B%A0","lib":"https://www.data4library.kr/srch?srchText=9788954674232","millie":"https://www.millie.co.kr/v3/search/result/%EB%B0%94%EB%9E%8C%EC%9D%B4%20%EB%88%88%EC%9D%84%20%EB%B9%9B%EB%82%B4%EA%B3%A0%20%EC%9E%88%EC%97%88%EC%96%B4","ridi":"https://ridibooks.com/search?q=%EB%B0%94%EB%9E%8C%EC%9D%B4%20%EB%88%88%EC%9D%84%20%EB%B9%9B%EB%82%B4%EA%B3%A0%20%EC%9E%88%EC%97%88%EC%96%B4","welaaa":"https://www.welaaa.com/search?keyword=%EB%B0%94%EB%9E%8C%EC%9D%B4%20%EB%88%88%EC%9D%84%20%EB%B9%9B%EB%82%B4%EA%B3%A0%20%EC%9E%88%EC%97%88%EC%96%B4","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788954674232","yes24":"https://www.yes24.com/product/search?query=9788954674232","elib":"https://www.google.com/search?q=%EB%B0%94%EB%9E%8C%EC%9D%B4%20%EB%88%88%EC%9D%84%20%EB%B9%9B%EB%82%B4%EA%B3%A0%20%EC%9E%88%EC%97%88%EC%96%B4%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"b5b1939409":{"id":"b5b1939409","t":"왜냐면","a":"안녕달","tr":[],"pub":"책읽는곰","y":"2017","isbn":"9791158360382","isbns":["9791158360382"],"cv":"https://image.yes24.com/goods/38292205/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9791158360382.jpg","f":"언어·교양","n":"한국","e":"미상","l":"쉽게","pg":"52","ot":"","intro":"끝없는 아이의 질문, 재치 있는 엄마의 대답,\n한없이 넓어지는 아이의 세계!\n『수박 수영장』, 『할머니의 여름휴가』의 시원한 감동에\n즐거운 상상과 유쾌함을 더한 사랑스러운 그림책\n\n바닷가 마을에 반짝, 여름 소나기가 내립니다. 엄마는 서둘러 유치원에 아이 마중을 왔지요. 집으로 가는 길, 세상이 온통 궁금한 아이는 질문을 시작합니다. “엄마, 왜 비가 와요?” “하늘에서 새들이 울어서 그래.” 아이의 끈덕진 질문과 엄마의 친절하고도 엉뚱한 대답이 꼬리에 꼬리를 물며, 둘은 함께 상상의 나래를 펼쳐 나갑니다. 그리고…… 늘 오가던 익숙한 귀갓길은 어느새 환상적인 여행길이 됩니다.\n\n『수박 수영장』의 작가, 안녕달의 신작 『왜냐면…』은 일상과 판타지의 경계를 자연스레 허무는 작가의 유머 감각과 상상력이 돋보이는 책입니다.","icut":false,"toc":"","recs":[["munhak","2017"]],"shorts":["문학나눔"],"univ":[],"au":{},"eb":[],"full":{},"rel":[],"star":9.6,"y24":"https://www.yes24.com/product/goods/38292205","daum":"https://search.daum.net/search?w=bookpage&bookId=1586431&q=%EC%99%9C%EB%83%90%EB%A9%B4","links":{"google":"https://www.google.com/search?q=%22%EC%99%9C%EB%83%90%EB%A9%B4%22%20%EC%95%88%EB%85%95%EB%8B%AC","lib":"https://www.data4library.kr/srch?srchText=9791158360382","millie":"https://www.millie.co.kr/v3/search/result/%EC%99%9C%EB%83%90%EB%A9%B4","ridi":"https://ridibooks.com/search?q=%EC%99%9C%EB%83%90%EB%A9%B4","welaaa":"https://www.welaaa.com/search?keyword=%EC%99%9C%EB%83%90%EB%A9%B4","kyobo":"https://search.kyobobook.co.kr/search?keyword=9791158360382","yes24":"https://www.yes24.com/product/search?query=9791158360382","elib":"https://www.google.com/search?q=%EC%99%9C%EB%83%90%EB%A9%B4%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"b5b6432465":{"id":"b5b6432465","t":"할망네 우영팟듸 자파리","a":"김정희","tr":[],"pub":"한그루","y":"2017","isbn":"9788994474465","isbns":["9788994474465"],"cv":"https://image.yes24.com/goods/37611864/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788994474465.jpg","f":"언어·교양","n":"한국","e":"근대","l":"쉽게","pg":"196","ot":"","intro":"시인이자 아동문학가인 김정희 작가의 제주어 동시집입니다. 김 작가는 학교와 도서관 등에서 아이들과 함께 시와 동화를 공부하고 구연해보기도 하는데, 그때마다 제주어를 접목한 수업을 고민했습니다. 할머니가 얘기해주는 것처럼 가르치고 싶지만, 아이들을 제주어와 가깝게 하기가 쉽지 않았고, 활용할 교재도 많지 않았습니다. 그래서 아이들이 쉽게 읽고 말할 수 있는 제주어 동시책을 만들게 되었다고 합니다.\n\n이 동시집에는 66편의 창작동시가 실려 있는데, 표준어와 제주어를 같이 실었다. 제주어 감수는 제주어보존회 회원들이 맡아 주었습니다. 아이들과 함께한 시간이 오래인 작가이기에 아이들의 눈높이에 맞는 재미있고 따뜻한 동시는 그 자체로 완결성이 높습니다. 거기에, 같은 내용을 제주어로 옮겨 놓아 제주어 공부는 물론, 제주어 특유의 맛이 담긴 시어들이 또 다른 감각으로 다가올 것입니다. 주제 또한 아이들의 일상생활에서부터 제주의 풍경, 역사 등 다채롭게 이루어져 있습니다.","icut":false,"toc":"","recs":[["munhak","2017"]],"shorts":["문학나눔"],"univ":[],"au":{"b":1786,"d":1856,"kw":"김정희","en":"Kim Jeong-hui"},"eb":[],"full":{},"rel":[["h","k47838","김정희"]],"star":10,"y24":"https://www.yes24.com/product/goods/37611864","daum":"https://search.daum.net/search?w=bookpage&bookId=1419013&q=%ED%95%A0%EB%A7%9D%EB%84%A4+%EC%9A%B0%EC%98%81%ED%8C%9F%EB%93%B8+%EC%9E%90%ED%8C%8C%EB%A6%AC%28%EC%94%A8%EC%95%97%EC%8B%9C%EC%84%A0+5%29","links":{"google":"https://www.google.com/search?q=%22%ED%95%A0%EB%A7%9D%EB%84%A4%20%EC%9A%B0%EC%98%81%ED%8C%9F%EB%93%B8%20%EC%9E%90%ED%8C%8C%EB%A6%AC%22%20%EA%B9%80%EC%A0%95%ED%9D%AC","lib":"https://www.data4library.kr/srch?srchText=9788994474465","millie":"https://www.millie.co.kr/v3/search/result/%ED%95%A0%EB%A7%9D%EB%84%A4%20%EC%9A%B0%EC%98%81%ED%8C%9F%EB%93%B8%20%EC%9E%90%ED%8C%8C%EB%A6%AC","ridi":"https://ridibooks.com/search?q=%ED%95%A0%EB%A7%9D%EB%84%A4%20%EC%9A%B0%EC%98%81%ED%8C%9F%EB%93%B8%20%EC%9E%90%ED%8C%8C%EB%A6%AC","welaaa":"https://www.welaaa.com/search?keyword=%ED%95%A0%EB%A7%9D%EB%84%A4%20%EC%9A%B0%EC%98%81%ED%8C%9F%EB%93%B8%20%EC%9E%90%ED%8C%8C%EB%A6%AC","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788994474465","yes24":"https://www.yes24.com/product/search?query=9788994474465","elib":"https://www.google.com/search?q=%ED%95%A0%EB%A7%9D%EB%84%A4%20%EC%9A%B0%EC%98%81%ED%8C%9F%EB%93%B8%20%EC%9E%90%ED%8C%8C%EB%A6%AC%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"b5b21295e0":{"id":"b5b21295e0","t":"발명소녀 오마영","a":"고정욱","tr":[],"pub":"페퍼민트","y":"2014","isbn":"9788997976164","isbns":["9788997976164"],"cv":"https://image.yes24.com/goods/14609089/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788997976164.jpg","f":"언어·교양","n":"한국","e":"미상","l":"쉽게","pg":"136","ot":"","intro":"창의성은 경쟁에서 나올까?\n\n아이들을 명문대에 보내기 위한 득점기계로 만드는 우리나라 교육 현실의 문제점을 모르는 학부모는 거의 없을 것입니다. 알고는 있지만 마땅한 대안이 없어 대부분의 학교와 학부모 가입시 위주의 학습에 매달리고 있습니다. 이러한 문제점을 공감하고 있는 많은 학교들이 경험 위주의 교육 과정이 중심이 되는 ‘창의 인성 교육’에 점차 관심을 보이고 있는 것은 다행스런 일입니다. 전국 188개(2013년 기준)의 창의 인성 모델학교들이 어려운 여건에서 다양한 방법으로 나름의 ‘창의 인성 교육’을 펼치고 있습니다. 그런데 창의성과 인성이라는 얼핏 전혀 달라보이는 두가지 요소가 왜 함께 묶여 있는 걸까요? ‘창의 인성’은 창조경제만큼이