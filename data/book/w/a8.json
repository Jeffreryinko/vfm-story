.com/search?q=%EA%B7%B8%EB%A6%BC%EC%9D%B4%20%EB%A7%90%EC%9D%84%20%EA%B1%B0%EB%8A%94%20%EC%83%9D%EA%B0%81%EB%AF%B8%EC%88%A0%EA%B4%80","welaaa":"https://www.welaaa.com/search?keyword=%EA%B7%B8%EB%A6%BC%EC%9D%B4%20%EB%A7%90%EC%9D%84%20%EA%B1%B0%EB%8A%94%20%EC%83%9D%EA%B0%81%EB%AF%B8%EC%88%A0%EA%B4%80","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788955820881","yes24":"https://www.yes24.com/product/search?query=9788955820881","elib":"https://www.google.com/search?q=%EA%B7%B8%EB%A6%BC%EC%9D%B4%20%EB%A7%90%EC%9D%84%20%EA%B1%B0%EB%8A%94%20%EC%83%9D%EA%B0%81%EB%AF%B8%EC%88%A0%EA%B4%80%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"ba8419a516":{"id":"ba8419a516","t":"심청이 무슨 효녀야 : 옛이야기 딴지걸기","a":"이경혜","tr":[],"pub":"바람의아이들","y":"2008","isbn":"9788990878540","isbns":["9788990878540"],"cv":"https://image.yes24.com/goods/2880341/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788990878540.jpg","f":"언어·교양","n":"한국","e":"미상","l":"쉽게","pg":"176","ot":"","intro":"『심청이가 무슨 효녀야?』는 ‘구전만이 가지는 강력한 힘’을 되찾고자 딱딱한 책 속에 갇힌 이야기들을 풀어내주기 위해 기획된 책이다. 『심청이가 무슨 효녀야?』역시 옛이야기를 책 꼴로 만들어내는 작업임에는 틀림없지만 고정된 이야기로 남기보다 읽는 사람 마음대로 바꿔 읽기를 권한다는 점에서 옛이야기의 참맛을 살리고 있다.","icut":false,"toc":"선녀와 나무꾼에겐 아이들도 있다고!\n심청이 무슨 효녀야?\n우렁이 엄마가 우리 엄마라면!\n알고 보면 팥주도 가엾어!\n이 도령이 암행어사가 안 됐으면?\n작가의 말","recs":[["sejong","2008"]],"shorts":["세종도서"],"univ":[],"au":{},"eb":[["YES24 eBook","https://www.yes24.com/product/goods/140258593"]],"full":{},"rel":[],"star":9.4,"y24":"https://www.yes24.com/product/goods/2880341","daum":"https://search.daum.net/search?w=bookpage&bookId=1333959&q=%EC%8B%AC%EC%B2%AD%EC%9D%B4+%EB%AC%B4%EC%8A%A8+%ED%9A%A8%EB%85%80%EC%95%BC+%3A+%EC%98%9B%EC%9D%B4%EC%95%BC%EA%B8%B0+%EB%94%B4%EC%A7%80%EA%B1%B8%EA%B8%B0+1","links":{"google":"https://www.google.com/search?q=%22%EC%8B%AC%EC%B2%AD%EC%9D%B4%20%EB%AC%B4%EC%8A%A8%20%ED%9A%A8%EB%85%80%EC%95%BC%22%20%EC%9D%B4%EA%B2%BD%ED%98%9C","lib":"https://www.data4library.kr/srch?srchText=9788990878540","millie":"https://www.millie.co.kr/v3/search/result/%EC%8B%AC%EC%B2%AD%EC%9D%B4%20%EB%AC%B4%EC%8A%A8%20%ED%9A%A8%EB%85%80%EC%95%BC","ridi":"https://ridibooks.com/search?q=%EC%8B%AC%EC%B2%AD%EC%9D%B4%20%EB%AC%B4%EC%8A%A8%20%ED%9A%A8%EB%85%80%EC%95%BC","welaaa":"https://www.welaaa.com/search?keyword=%EC%8B%AC%EC%B2%AD%EC%9D%B4%20%EB%AC%B4%EC%8A%A8%20%ED%9A%A8%EB%85%80%EC%95%BC","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788990878540","yes24":"https://www.yes24.com/product/search?query=9788990878540","elib":"https://www.google.com/search?q=%EC%8B%AC%EC%B2%AD%EC%9D%B4%20%EB%AC%B4%EC%8A%A8%20%ED%9A%A8%EB%85%80%EC%95%BC%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"ba8efb915f":{"id":"ba8efb915f","t":"아흔아홉 개의 달과 아흔아홉 번의 겨울","a":"박제영","tr":[],"pub":"달아실","y":"2025","isbn":"9791172070724","isbns":["9791172070724"],"cv":"https://image.yes24.com/goods/155152617/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9791172070724.jpg","f":"문학","n":"한국","e":"미상","l":"쉽게","pg":"136","ot":"","intro":"이상하고 수상한 데다 괴랄해서 뭐라 말해야 할지 모르겠다\n- 박제영 시집 『아흔아홉 개의 달과 아흔아홉 번의 겨울』\n\n박제영 시인이 일곱 번째 신작 시집 『아흔아홉 개의 달과 아흔아홉 번의 겨울』을 펴냈다. 달아실시선 99번으로 나왔다.\n\n시인 박제영은 1992년 등단 이후 삼십여 년 동안 여섯 권의 시집을 통해 삶의 슬픔과 고통을 해학으로 어루만지고, 사회의 불공정과 부조리를 풍자로 비판해왔다. 박제영의 시편들을 단순히 정의하기는 어렵지만 거칠게 요약하자면, ‘서사(敍事)와 사설(辭說)’이라는 뼈대에 ‘풍자와 해학’이라는 살을 입히고 있으며, 그 안을 흐르는 피(리듬)는 판소리에 가깝다.","icut":false,"toc":"시인의 말\n들어가는 詩\n나의 시인에게\n1부. 사랑과 이별에 관한 포에트리 슬램, 부에노스아이레스 탱고를 위한 서곡\n베고니아│뚱딴지꽃│배롱나무 그늘에 앉아│화진│복수초│탱자 같은 눈이 내려서│프리지어│해는 간절곶에서 떠올라 카보 다 호카에서 진다네│사랑과 이별에 관한 포에트리 슬램, 부에노스아이레스 탱고를 위한 서곡│백년의 오지, 백년의 미로│사랑에 관한 먹먹하고 막막한 색의 번짐 ― 시인 강기원│사랑학개론│신은 생식의 기관으로 만들었으나 시인은 연애와 이별의 기표로 만들었으니 꽃은 어느 편에 설 것인가 당신이라면 어디로 기울 텐가│에프엠 구백구십구점구 사랑은 거짓말이야│만항│그믐│사랑은 끝말잇기와 같아서│꽃들의 사정, 늙은 시인에게\n2부. 검은 눈에 물든다는 건 시에 물드는 일\n박정대 사용 설명서 혹은 여행 안내서│검은 눈에 물든다는 건 시에 물드는 일│1923년 12월 11일 파리 몽파르나스에 처음 문을 연 카페 『르 셀렉트』에서 서른네 살의 장 콕토와 스무 살의 레옹 라디게는 무슨 말을 했나│무가당 담배 클럽 동인이자 인터내셔널 포에트리 급진 오랑캐 밴드 멤버이자 율란통신 에스프리 편집장 무사 강돌이자 영화감독 오랑캐 이 강이기도 한 그러나 끝내 시인인 박정대 형에게\n3부. 햄버거와 황지우를 빙자한 시적 사기술\n오, 마이 캡틴! 오, 마이 탁번!│애기동백, 붙박이별 그리고 려족旅族들│아무도 별을 헤지 않는다│박용하는 서럽다│내 시는 진이정의 각주에 불과했다│매혹이란 그런 것이다│기담, 기담을 읽어요, 기담 식으로요│문장수선공 k│숫│시인 최승호와 숫│눈사람 자살 사건의 재구성│햄버거와 황지우를 빙자한 시적 사기술│쉰아홉의 쟈니가 스물아홉의 쟈니에게│숲 해설사, 한 잎의 여자를 모르는 남자│어깨너머│뭄, 빨간 원피스를 입은 까롤린\n4부. 마이크 타이슨을 위한 마이크 테스트 하나 둘 셋\n창졸지간 새 된 얘기│『무릇 형상 있는 것은 모두 허망한 것이니, 만약 모든 형상이 형상이 아님을 보면 곧 여래를 볼 것』이라는 부처의 말씀을 야부 스님은 『산은 산이요 물은 물이로다 부처님은 어느 곳에 계시는가』라는 시로 풀어냈다 훗날 이를 성철 스님이 인용하셨으나 알아들은 이 없어 내 다시 시로 풀어보는 것이나 이 또한 알아들을 이 누가 있을지 모를 일이다│원숭이 똥구멍이 빨간 거니│차마고도│나는 개새끼로소이다│마이크 타이슨을 위한 마이크 테스트 하나 둘 셋│사는 게 뭐냐고 묻는다면 눈이 그쳤다고 얘기할 수밖에│어디선가 누군가에 무슨 일이 생기면 틀림없이 나타나는 춘배 옵빠를 위한 남녀 혼성 울트라 짬뽕 뽕짝 트로트│정태순 씨│장사익│수세미│아욱국\n나가는 詩\n나의 시인들에게\n발문 _ 박정대\n시인, 온 언어로 사랑을 추구하는 자\n아름다운 그믐의 언어를 사용하는 자\n엔딩 크레딧\n아흔아홉의 천사들","recs":[["munhak","2026"]],"shorts":["문학나눔"],"univ":[],"au":{},"eb":[],"full":{},"rel":[],"star":0,"y24":"https://www.yes24.com/product/goods/155152617","daum":"https://search.daum.net/search?w=bookpage&bookId=7039735&q=%EC%95%84%ED%9D%94%EC%95%84%ED%99%89+%EA%B0%9C%EC%9D%98+%EB%8B%AC%EA%B3%BC+%EC%95%84%ED%9D%94%EC%95%84%ED%99%89+%EB%B2%88%EC%9D%98+%EA%B2%A8%EC%9A%B8","links":{"google":"https://www.google.com/search?q=%22%EC%95%84%ED%9D%94%EC%95%84%ED%99%89%20%EA%B0%9C%EC%9D%98%20%EB%8B%AC%EA%B3%BC%20%EC%95%84%ED%9D%94%EC%95%84%ED%99%89%20%EB%B2%88%EC%9D%98%20%EA%B2%A8%EC%9A%B8%22%20%EB%B0%95%EC%A0%9C%EC%98%81","lib":"https://www.data4library.kr/srch?srchText=9791172070724","millie":"https://www.millie.co.kr/v3/search/result/%EC%95%84%ED%9D%94%EC%95%84%ED%99%89%20%EA%B0%9C%EC%9D%98%20%EB%8B%AC%EA%B3%BC%20%EC%95%84%ED%9D%94%EC%95%84%ED%99%89%20%EB%B2%88%EC%9D%98%20%EA%B2%A8%EC%9A%B8","ridi":"https://ridibooks.com/search?q=%EC%95%84%ED%9D%94%EC%95%84%ED%99%89%20%EA%B0%9C%EC%9D%98%20%EB%8B%AC%EA%B3%BC%20%EC%95%84%ED%9D%94%EC%95%84%ED%99%89%20%EB%B2%88%EC%9D%98%20%EA%B2%A8%EC%9A%B8","welaaa":"https://www.welaaa.com/search?keyword=%EC%95%84%ED%9D%94%EC%95%84%ED%99%89%20%EA%B0%9C%EC%9D%98%20%EB%8B%AC%EA%B3%BC%20%EC%95%84%ED%9D%94%EC%95%84%ED%99%89%20%EB%B2%88%EC%9D%98%20%EA%B2%A8%EC%9A%B8","kyobo":"https://search.kyobobook.co.kr/search?keyword=9791172070724","yes24":"https://www.yes24.com/product/search?query=9791172070724","elib":"https://www.google.com/search?q=%EC%95%84%ED%9D%94%EC%95%84%ED%99%89%20%EA%B0%9C%EC%9D%98%20%EB%8B%AC%EA%B3%BC%20%EC%95%84%ED%9D%94%EC%95%84%ED%99%89%20%EB%B2%88%EC%9D%98%20%EA%B2%A8%EC%9A%B8%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"ba8981b325":{"id":"ba8981b325","t":"세계문학전집","a":"권혁웅","tr":[],"pub":"타이피스트","y":"2024","isbn":"9791198188694","isbns":["9791198188694"],"cv":"https://image.yes24.com/goods/124987347/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9791198188694.jpg","f":"문학","n":"한국","e":"현대","l":"쉽게","pg":"152","ot":"","intro":"출판사 타이피스트에서 새롭게 「타이피스트 시인선」을 시작한다. 시리즈의 첫 권으로 ‘미당문학상’을 수상한 시인이자 평론가로서 활동하고 있는 권혁웅 시인의 여섯 번째 시집 『세계문학전집』이 출간되었다.\n\n일상의 풍경 속에서 삶의 세목을 짚어 내는 시편들로 잔잔한 공감을 불러 일으켰던『애인은 토막 난 순대처럼 운다』(2013, 창비) 이후 만 10년 만에 펴내는 이번 시집에서는 철학과 역사를 기반으로 일상의 숨겨진 사유를 보여 주며 이 세계와 인간에 대한 시인만의 전집 이야기를 만들어 낸다.\n\n능청스러운 해학과 날카로운 인식은 권혁웅 시인의 전매특허이다. 특히 시집 『세계문학전집』에서는 이전 시집에서 보여 줬던 삶의 현장을 조망하는 시선에 더해 다채로운 문학 전집 속 인물들이 기존의 이야기들을 뒤엎으며 또 다른 소재로서 등장한다. 시집의 제목처럼 모든 이야기 속 3인칭들이 권혁웅의 문장을 통과하며 시가 되고 현실의 삶이 되어, 시대를 뛰어넘는 “세계문학전집”이 태어났다.","icut":false,"toc":"1부\n윙크/동물의 왕국/전설의 고향?배달의 민족/최후의 심판/판다는 알고 황후는 모르는 일\n남미 기행\n월하의 공동묘지\n거울에 관한 명상\n파에 관한 명상\n가훈은 가화만사성\nE=mc2\n내 몸이 집이라면 이사한 다음에 나는 어디로 간 것일까\n틱타알릭의 하루\n2부\n악착(齷齪)\n구운몽 1\n구운몽 2\n세계문학전집(1차분)\n세계문학전집(2차분)\n장동건\n고소영\n나를 만지지 마라\n날아가는 새들을 부러워하지 아니함\n미스터피자를 노래함\n양념게장과 간장게장\n세계사상전집(1차분)\n세계사상전집(2차분)\n성찰\n액자소설\n승읍(承泣)\n주기율표\n3부\n눈사람\n귀신들\n잠만 잘 분\n왕좌의 게임 1\n왕좌의 게임 2\n검설(劍說)\n4차 산업혁명 위원회\n골목식당\n신비아파트 캐릭터 도감\n엄마야 누나야 카프카야\n24시 신의주찹쌀순대\n코네티컷 이야기\n환상동물사전 1\n환상동물사전 2\n환상동물사전 3\n서시와 서사시\n웨이터\n산문 - 부정신학과 종이옷","recs":[["munhak","2024"]],"shorts":["문학나눔"],"univ":[],"au":{"b":1967,"kw":"권혁웅","en":"Kwon Hyeok-ung"},"eb":[],"full":{},"rel":[],"star":10,"y24":"https://www.yes24.com/product/goods/124987347","daum":"https://search.daum.net/search?w=bookpage&bookId=6561908&q=%EC%84%B8%EA%B3%84%EB%AC%B8%ED%95%99%EC%A0%84%EC%A7%91","links":{"google":"https://www.google.com/search?q=%22%EC%84%B8%EA%B3%84%EB%AC%B8%ED%95%99%EC%A0%84%EC%A7%91%22%20%EA%B6%8C%ED%98%81%EC%9B%85","lib":"https://www.data4library.kr/srch?srchText=9791198188694","millie":"https://www.millie.co.kr/v3/search/result/%EC%84%B8%EA%B3%84%EB%AC%B8%ED%95%99%EC%A0%84%EC%A7%91","ridi":"https://ridibooks.com/search?q=%EC%84%B8%EA%B3%84%EB%AC%B8%ED%95%99%EC%A0%84%EC%A7%91","welaaa":"https://www.welaaa.com/search?keyword=%EC%84%B8%EA%B3%84%EB%AC%B8%ED%95%99%EC%A0%84%EC%A7%91","kyobo":"https://search.kyobobook.co.kr/search?keyword=9791198188694","yes24":"https://www.yes24.com/product/search?query=9791198188694","elib":"https://www.google.com/search?q=%EC%84%B8%EA%B3%84%EB%AC%B8%ED%95%99%EC%A0%84%EC%A7%91%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"ba877dcedc":{"id":"ba877dcedc","t":"하염없이 하염없는","a":"강연호","tr":[],"pub":"시인의일요일","y":"2023","isbn":"9791192732145","isbns":["9791192732145"],"cv":"https://image.yes24.com/goods/124138625/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9791192732145.jpg","f":"문학","n":"한국","e":"현대","l":"쉽게","pg":"184","ot":"","intro":"돌이킬 수 없어서 다행인 날들의 기억\n\n첫 시집 『비단길』을 혜성처럼 시단에 등장한 서정주의자. 이후 『잘못 든 길이 지도를 만든다』 『세상의 모든 뿌리는 젖어 있다』 『기억의 못갖춘마디』등의 시집으로 1990년대 후반과 2000년대 초반 우리 시의 서정적 가치를 지켜냈던 강연호 시인이 드디어 11년 만에 돌아왔다.\n\n그는 이전 네 권의 시집에서, 일상의 삶이 품은 비애를 가만히 추적하며 슬픔과 허무의 맥을 짚어나갔다. 이번 시집 『하염없이 하염없는』 역시 깊은 곳에서 오랫동안 우려낸 듯한 정서를 담아내고 있다. 중년을 건너가는 삶이 거느린 비루한 삶의 풍경과 마음의 얼룩을 첨예한 보석의 언어로 펼쳐낸다. 일상의 삶이 품은 슬픈 비애를 가만히 추적하며 슬픔과 허무의 맥을 짚어나가는 서정적인 체험을 독자에게 선사하며, 독자의 마음에 잔잔한 감동의 파동을 일으킨다. 그는 서정의 연금술사처럼 우리의 삶 속에서 피어나는 감정의 스펙트럼을 다른 빛깔들로 자기 시 속에 촘촘히 수놓는다.","icut":false,"toc":"1부\n혼자 밥 먹는 사람은 / 포옹 / 물고기 발자국 / 자필 이력서 쓰는 밤 / 당신의 문체 / 싱크홀 1 / 연밥을 입에 물어 마음을 달래다 / 수제비 뜨는 저녁 / 후드득 흐드득 / 숨은 신 / 등신불 / 풍선아트 / 알리바이 / 인간적 / 돌탑 / 봄꽃의 선후 / 단풍지도 / 저녁 깊은 밤\n2부\n내 입술의 모든 말 / 고독한 아이 / 퍼스트 펭귄 / 말뼈 원가 판매 / 당신의 좀비 / 비문증 / 대관람차 / 신들의 전쟁 / 우리가 지구를 떠날 때 / 간판 / 향수 / 외로움을 잃어버렸죠 / 공공의 적 / 잉크가 묻은 손가락 / 여반장 / 과거가 있다 / 벽화 / 처음에는 다 선의였으나\n3부\n얼굴 / 불우 / 하염없이 하염없는 / 오늘이 가면 / 책의 취향 / 지나간 연애 / 접촉사고 / 놀이터 1 / 놀이터 2 / 백 년쯤 전에 당신은 / 첫눈 / 관계의 내연 / 나머지 / 하마르티아 / 아웃도어 / 건강이 제일이지 / 중년 / 커튼\n4부\n스토리텔링 / 연금술 / 가족 / 파과 / 호랑이 / 늙은 아이 / 늦둥이 / 텃밭 / 예의 / 스마트워치 / 유실물센터 / 사랑의 배신 / 싱크홀 2 / 구석 / 냉장고 / 오후의 손톱 / 이모티콘 / 이 종이 다발의 한 낱장으로\n해설\n‘홀로’와 경청의 감각 | 이경수(문학평론가 · 중앙대 교수)","recs":[["munhak","2024"]],"shorts":["문학나눔"],"univ":[],"au":{"b":1955},"eb":[["YES24 eBook","https://www.yes24.com/product/goods/152372969"]],"full":{},"rel":[],"star":9.7,"y24":"https://www.yes24.com/product/goods/124138625","daum":"https://search.daum.net/search?w=bookpage&bookId=6515909&q=%ED%95%98%EC%97%BC%EC%97%86%EC%9D%B4+%ED%95%98%EC%97%BC%EC%97%86%EB%8A%94","links":{"google":"https://www.google.com/search?q=%22%ED%95%98%EC%97%BC%EC%97%86%EC%9D%B4%20%ED%95%98%EC%97%BC%EC%97%86%EB%8A%94%22%20%EA%B0%95%EC%97%B0%ED%98%B8","lib":"https://www.data4library.kr/srch?srchText=9791192732145","millie":"https://www.millie.co.kr/v3/search/result/%ED%95%98%EC%97%BC%EC%97%86%EC%9D%B4%20%ED%95%98%EC%97%BC%EC%97%86%EB%8A%94","ridi":"https://ridibooks.com/search?q=%ED%95%98%EC%97%BC%EC%97%86%EC%9D%B4%20%ED%95%98%EC%97%BC%EC%97%86%EB%8A%94","welaaa":"https://www.welaaa.com/search?keyword=%ED%95%98%EC%97%BC%EC%97%86%EC%9D%B4%20%ED%95%98%EC%97%BC%EC%97%86%EB%8A%94","kyobo":"https://search.kyobobook.co.kr/search?keyword=9791192732145","yes24":"https://www.yes24.com/product/search?query=9791192732145","elib":"https://www.google.com/search?q=%ED%95%98%EC%97%BC%EC%97%86%EC%9D%B4%20%ED%95%98%EC%97%BC%EC%97%86%EB%8A%94%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"ba88e076cc":{"id":"ba88e076cc","t":"홍콩정원","a":"정우신","tr":[],"pub":"현대문학","y":"2021","isbn":"9791190885553","isbns":["9791190885553"],"cv":"https://image.yes24.com/goods/97056288/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9791190885553.jpg","f":"문학","n":"한국","e":"미상","l":"쉽게","pg":"112","ot":"","intro":"현대문학의 새로운 한국 문학 시리즈인 [현대문학 핀 시리즈] 시인선 서른두 번째 시집 정우신의 『홍콩 정원』을 출간한다. 2018년 시리즈 론칭 후 지금까지 총 서른한 권의 시인선을 내놓은 핀 시리즈는 그간 6개월마다 여섯 권을 동시에 출간하던 방식을 바꿔 격월로 한 권씩 발간하고 있다. 서른두 번째 핀 시리즈 시인선의 주인공은 2016년 『현대문학』 신인추천으로 문단에 나온 이래 생과 사, 그 안에 깃든 인간의 비애를 정제된 언어와 개성적 이미지로 보여주며 그 성과를 인정받고 있는 정우신 시인이다. 사물들과 서로 응시하는 파편화된 신체, 회화적인 상징과 이미지들의 복합체인 리플리컨트를 통해 현대인의 고독과 사랑에 대해 이야기하는 작품들이 모인 시집이다.","icut":false,"toc":"1부\n핑크 스팀 11\n不二門―건봉사의 항아리를 정리하는 비구니 리플리컨트 14\n무당―신내림을 연습하는 리플리컨트 16\n생화학교실―리플리컨트의 탄생 20\n베이스캠프 26\n부소담악―머신 러닝 1 28\n숭배―머신 러닝 2 30\n익산 가는 길 32\n사슬―머신 러닝 3 36\n失樂園 38\n接冬 接冬―머신 러닝 4 44\n2부\n네온사인 49\n암시장―만리포 여관에 버려진 리플리컨트 54\n마리화나 소년―리셋된 자신에게\n머신건을 쏘는 리플리컨트 56\n쥐 인간 62\n대왕 나방―리플리컨트의 멜랑콜리 66\n홍콩 정원 74\n해동 78\n◎◎◎◎◎◎\n◎◎◎◎◎◎ 80\n廢家―머신 러닝 5 84\n口音―머신 러닝 6 86\n액화질소탱크 88\n변전소―리플리컨트 폐기 92\n에세이 : 관류 실험 101","recs":[["munhak","2021"]],"shorts":["문학나눔"],"univ":[],"au":{},"eb":[["YES24 eBook","https://www.yes24.com/product/goods/105530809"]],"full":{},"rel":[],"star":8,"y24":"https://www.yes24.com/product/goods/97056288","daum":"https://search.daum.net/search?w=bookpage&bookId=5582895&q=%ED%99%8D%EC%BD%A9%EC%A0%95%EC%9B%90","links":{"google":"https://www.google.com/search?q=%22%ED%99%8D%EC%BD%A9%EC%A0%95%EC%9B%90%22%20%EC%A0%95%EC%9A%B0%EC%8B%A0","lib":"https://www.data4library.kr/srch?srchText=9791190885553","millie":"https://www.millie.co.kr/v3/search/result/%ED%99%8D%EC%BD%A9%EC%A0%95%EC%9B%90","ridi":"https://ridibooks.com/search?q=%ED%99%8D%EC%BD%A9%EC%A0%95%EC%9B%90","welaaa":"https://www.welaaa.com/search?keyword=%ED%99%8D%EC%BD%A9%EC%A0%95%EC%9B%90","kyobo":"https://search.kyobobook.co.kr/search?keyword=9791190885553","yes24":"https://www.yes24.com/product/search?query=9791190885553","elib":"https://www.google.com/search?q=%ED%99%8D%EC%BD%A9%EC%A0%95%EC%9B%90%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"ba8cbbbb3a":{"id":"ba8cbbbb3a","t":"승부사","a":"박순호","tr":[],"pub":"애지","y":"2015","isbn":"9788992219570","isbns":["9788992219570"],"cv":"https://image.yes24.com/goods/17187858/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788992219570.jpg","f":"문학","n":"한국","e":"미상","l":"쉽게","pg":"190","ot":"","intro":"박순호 시인의 시집『승부사』. 이번 시집에서는 인간의 내면을 파헤치고 무너뜨리는 고통과 절망에 대한 기록이며 상처를 건너가면서 아로 새긴 문양이 가득하다. 이민호 평론가는 “그의 시에 나타난 기형적 이미지의 다발은 자기 부정의 타나토스와 자기 회복의 에로스를 동시에 지니고 있기 때문”이고, “이러한 전복의 상상력은 내적 인격, 즉 아니마의 뜨거운 에너지에서 비롯”되는 것이며, “영혼이 빠져나간 몸에 다시 세계 혼을 불어넣는 시 쓰기의 연금술이라 할 수 있다”고 말한다.","icut":false,"toc":"시인의 말\n제1부\n시에게 고백하다/ 제지공장 굴뚝/ 더듬이/ 삭인 홍어를 끄집어내다/ 승부사/ 젖은 풀이 봉해지는 시간/ 제비꽃 파낸 자리/ 절벽의 위장술/ 웃음은 누가 일으키는가/ 밤이 몰려오는 냄새/ 꼭지를 위하여/ 달의 목덜미가 하얗다/ 찾았다 서점\n제2부\n우아한 커피 타임/ 어설픈 감정/ 시간이 빚어낸 얼굴들/ 수명 다한 형광등처럼/ 희망도 계급이/ 노랑난간 위에 노랑나비/ 어제의 역습/ 박순호라는 현대사/ 무거운 가방/ 욕실에서 자아를 기웃거리다/ 숨쉬는 타일들/ 어디에서 오는가/ 전복\n제3부\n바람 박물관/ 우아한 방어/ 이불의 세례명/ 빗물을 오므리다/ 쌍방과실/ 그들의 무늬/ 까마귀의 조문/ 별의 길목을 서성거리다/ 단칸방/ 통신맨홀/ 막도장/ 여섯 폭 병풍/ 바위사리\n제4부\n자귀나무 자전거/ 구름을 필사하다/ 결/ 오 분이면 충분하다/ 늙은 실잠자리/ 잠의 덩굴/ 하늘달방/ 박주가리/ 서재에서 잠들다/ 정착에 대하여/ 학암포/ 새의 화석을 보다/ 물의 기술/ 콩나물국을 끓이는 밤","recs":[["munhak","2015"]],"shorts":["문학나눔"],"univ":[],"au":{},"eb":[],"full":{},"rel":[],"star":0,"y24":"https://www.yes24.com/product/goods/17187858","daum":"https://search.daum.net/search?w=bookpage&bookId=1368198&q=%EC%8A%B9%EB%B6%80%EC%82%AC%28%EC%95%A0%EC%A7%80%EC%8B%9C%EC%84%A0+59%29%28%EC%96%91%EC%9E%A5%EB%B3%B8+HardCover%29","links":{"google":"https://www.google.com/search?q=%22%EC%8A%B9%EB%B6%80%EC%82%AC%22%20%EB%B0%95%EC%88%9C%ED%98%B8","lib":"https://www.data4library.kr/srch?srchText=9788992219570","millie":"https://www.millie.co.kr/v3/search/result/%EC%8A%B9%EB%B6%80%EC%82%AC","ridi":"https://ridibooks.com/search?q=%EC%8A%B9%EB%B6%80%EC%82%AC","welaaa":"https://www.welaaa.com/search?keyword=%EC%8A%B9%EB%B6%80%EC%82%AC","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788992219570","yes24":"https://www.yes24.com/product/search?query=9788992219570","elib":"https://www.google.com/search?q=%EC%8A%B9%EB%B6%80%EC%82%AC%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"ba8e9344be":{"id":"ba8e9344be","t":"강물도 목이 마르다","a":"이원규","tr":[],"pub":"실천문학사","y":"2008","isbn":"9788939221765","isbns":["9788939221765"],"cv":"https://image.yes24.com/goods/2927909/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788939221765.jpg","f":"문학","n":"한국","e":"현대","l":"쉽게","pg":"160","ot":"","intro":"‘무정처, 무정처, 무정처’로 행선(行禪) 중인 지리산 시인 이원규가 길 위에서 보내온 여섯 번째 시집. 불혹을 넘어 시인이 정처한 지리산의 꽃과 바람, 별과 강물의 이야기가 고스란히 스며있다. 세상과 같은 방식―같은 속도로 성장할 것을 강요받아온 우리에게 시인의 정처 없음은 다른 유목의 방식을 꿈꾸도록 하는 권유가 될 것이며, 여전히 목이 마른 강물의 이야기를, 우는 돌의 이야기를, 삼보일배를 하며 나아가는 자벌레의 숨소리를 들려줄 것이다.","icut":false,"toc":"제1부 너는 누구냐 묻지 않았다\n족필(足筆)\n낙화\n귀가\n너는 누구냐 묻지 않았다\n혀무덤\n모국어 산부인과\n저 닭을 잡아먹자\n물안개\n신목(神木)\n찔레꽃\n꿩\n운우지정\n음모론\n비천무\n강물도 목이 마르다\n단풍나무 인터넷\n베짱이\n뇌신\n벽소령 안개 사우나\n가을 소식\n돌\n탁좆\n목련\n제2부 뼈가 투명해질 때까지\n누구에게나 암수한몸의 시절이 있었다\n적막강산\n쏘라기 낚시\n도둑고양이\n낮달\n문창별\n귓속말이 세상을 바꾼다\n나비야 청산 가자\n천적\n나그네\n한 여자가 지나갔다\n마이산\n무덤과 무덤사이\n뼈가 투명해질 때까지\n자음의 풍경\n첫사랑은 화석처럼\n저승새\n산중문답\n문수골 문수제\n유마경\n논두렁 우체통\n내 그림자에게 길을 묻다\n현주소\n자궁 속에 잠들다\n제3부 입산자의 노래\n도반\n활인검\n쑥무덤\n북두칠성\n봐라, 꽃이다\n환절기\n다비식\n초식동물은 비겁하다\n달팽이\n유배지의 풀꽃\n고리봉 비석의 말씀\n얘들아, 지리산의 아들딸들아\n현무암\n키만큼\n다만 멈칫거릴 뿐\n황새울의 꿈\n자벌레의 길\n칩거\n길이 길을 막다\n입산자의 노래\n해설 | 이문재\n시인의 말","recs":[["munhak","2008"]],"shorts":["문학나눔"],"univ":[],"au":{"b":1988,"en":"Lee Won-kyu"},"eb":[],"full":{},"rel":[],"star":9,"y24":"https://www.yes24.com/product/goods/2927909","daum":"https://search.daum.net/search?w=bookpage&bookId=555845&q=%EA%B0%95%EB%AC%BC%EB%8F%84+%EB%AA%A9%EC%9D%B4+%EB%A7%88%EB%A5%B4%EB%8B%A4%28%EC%8B%A4%EC%B2%9C%EB%AC%B8%ED%95%99%EC%9D%98+%EC%8B%9C%EC%A7%91+176%29","links":{"google":"https://www.google.com/search?q=%22%EA%B0%95%EB%AC%BC%EB%8F%84%20%EB%AA%A9%EC%9D%B4%20%EB%A7%88%EB%A5%B4%EB%8B%A4%22%20%EC%9D%B4%EC%9B%90%EA%B7%9C","lib":"https://www.data4library.kr/srch?srchText=9788939221765","millie":"https://www.millie.co.kr/v3/search/result/%EA%B0%95%EB%AC%BC%EB%8F%84%20%EB%AA%A9%EC%9D%B4%20%EB%A7%88%EB%A5%B4%EB%8B%A4","ridi":"https://ridibooks.com/search?q=%EA%B0%95%EB%AC%BC%EB%8F%84%20%EB%AA%A9%EC%9D%B4%20%EB%A7%88%EB%A5%B4%EB%8B%A4","welaaa":"https://www.welaaa.com/search?keyword=%EA%B0%95%EB%AC%BC%EB%8F%84%20%EB%AA%A9%EC%9D%B4%20%EB%A7%88%EB%A5%B4%EB%8B%A4","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788939221765","yes24":"https://www.yes24.com/product/search?query=9788939221765","elib":"https://www.google.com/search?q=%EA%B0%95%EB%AC%BC%EB%8F%84%20%EB%AA%A9%EC%9D%B4%20%EB%A7%88%EB%A5%B4%EB%8B%A4%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"ba8a0efe73":{"id":"ba8a0efe73","t":"검은 표범 여인","a":"문혜진","tr":[],"pub":"민음사","y":"2007","isbn":"9788937407611","isbns":["9788937407611"],"cv":"https://image.yes24.com/goods/2795616/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788937407611.jpg","f":"문학","n":"한국","e":"현대","l":"쉽게","pg":"124","ot":"","intro":"1998년 으로 등단한 문혜진 시인이 부른 야생적인 노래. 시인이 세상에 두 번째로 펼쳐낸 날카로운 록의 리듬은 2007년 제 26회 을 날카로운 이빨로 물었다. 근본적인 본능, 여성과 남성의 경계를 무의미하게 만들고 인간 속에 잠들어 있는 맹수를 록 발성이 결합된 시어들의 노래로 깨운다. 생생한 몸으로 시작했지만 몸에 갇히지 않고 광활한 곳으로 달려나가 질주하는 언어 속에 검은 표범의 또 다른 시인의 모습이 생생하게 그려져 있다.","icut":false,"toc":"시인의 말\n검은 표범 여인\n북극흰올빼미\n홍어\n야생의 책\n시베리아의 밤\n악어사나이\n알래스카 - 마이클 주에게\n로드킬\n나무인지 바위인지\n사냥꾼\n표범약국\n붉은 소파, 생물학적 연대기\n독립영양인간 1\n독립영양인간 2\n미나리아재비과 인간\n표범약사의 비밀 약장\n산소카페\n루왁\n코요테\n코스프레 여왕\n혹등고래\n디테일에 관한 짧은 대화\n꽃잔치 스탠드빠\n발정\n계단식 논 머리 모양을 한 소녀\n잘못 뒤집은 네 장의 타로 카드\n운명공동체\n후무후무누쿠누쿠아푸아아\n거리의 피라냐\n맹수에 관한 포르노그래피\n사냥 - 낙태 시술자\n백상아리 레퀴엠\n호랑이 가죽으로 만든 집\n가물치\n알을 주고 떠난 여자의 죽음\n민달팽이\n이방인 여자 - 라오, 일리나, 림성혜\n표범약사의 이중생활\n루니의 의료 관광\n울부짖지 못하는 육식동물을 위한 포효교본\n눈 내리는 밤의 분장술\n젤렘 젤렘\n말의 기원\n검독수리에게\n까마귀밥여름나무\n나이아가라\n작품 해설/신형철\n어쩐지 록 스피릿! - 당신의 '두 번째 인생'을 위한 포효 교본","recs":[["munhak","2008"]],"shorts":["문학나눔"],"univ":[],"au":{"b":1976,"kw":"문혜진 (시인)"},"eb":[["YES24 eBook","https://www.yes24.com/product/goods/7290431"]],"full":{},"rel":[],"star":8,"y24":"https://www.yes24.com/product/goods/2795616","daum":"https://search.daum.net/search?w=bookpage&bookId=537326&q=%EA%B2%80%EC%9D%80+%ED%91%9C%EB%B2%94+%EC%97%AC%EC%9D%B8","links":{"google":"https://www.google.com/search?q=%22%EA%B2%80%EC%9D%80%20%ED%91%9C%EB%B2%94%20%EC%97%AC%EC%9D%B8%22%20%EB%AC%B8%ED%98%9C%EC%A7%84","lib":"https://www.data4library.kr/srch?srchText=9788937407611","millie":"https://www.millie.co.kr/v3/search/result/%EA%B2%80%EC%9D%80%20%ED%91%9C%EB%B2%94%20%EC%97%AC%EC%9D%B8","ridi":"https://ridibooks.com/search?q=%EA%B2%80%EC%9D%80%20%ED%91%9C%EB%B2%94%20%EC%97%AC%EC%9D%B8","welaaa":"https://www.welaaa.com/search?keyword=%EA%B2%80%EC%9D%80%20%ED%91%9C%EB%B2%94%20%EC%97%AC%EC%9D%B8","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788937407611","yes24":"https://www.yes24.com/product/search?query=9788937407611","elib":"https://www.google.com/search?q=%EA%B2%80%EC%9D%80%20%ED%91%9C%EB%B2%94%20%EC%97%AC%EC%9D%B8%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"ba81cc162a":{"id":"ba81cc162a","t":"사랑의 세계","a":"이희주","tr":[],"pub":"스위밍꿀","y":"2021","isbn":"9791196074449","isbns":["9791196074449"],"cv":"https://image.yes24.com/goods/101761443/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9791196074449.jpg","f":"문학","n":"한국","e":"현대","l":"쉽게","pg":"276","ot":"","intro":"왜 내 사랑은 일방향인가?\n아이돌 팬덤에 대한 생생한 기록 『환상통』의 작가 이희주 두번째 소설\n\n스위밍꿀의 네번째 소설이 출간되었다. 정지돈 장편소설 『작은 겁쟁이 겁쟁이 새로운 파티』, 박솔뫼 소설집 『사랑하는 개』, 한정현 장편소설 『줄리아나 도쿄』의 다음을 잇는 새로운 이야기는 이희주 연작 소설집 『사랑의 세계』이다. 아이돌 팬덤에 대한 생생한 기록을 통해 사랑의 특수성을 섬세하게 그려낸 장편소설 『환상통』으로 문학동네 대학소설상을 수상하며 작품활동을 시작한 작가는 이번에도 그 사랑에 대한 탐구를 이어간다. 그는 전작에서 작중 인물이 한 아이돌 멤버를 볼 때마다 내뱉던 말(“씨발, 죽어도 좋아.”)로 독자들을 놀라게 만든 바 있다. 이는 독자들이 체험한 사랑의 속성을 아주 정확히 건드렸기 때문일 것이다. 즉, 왜 내 사랑은 일방향인가? 그는 이 열렬한 욕망과 감정의 세계를 세 편의 연작 소설을 통해 우리 앞에 펼쳐 보인다.","icut":false,"toc":"탐정 이야기 007\n여름 091\n또 하나의 신화 185\n작가의 말 273","recs":[["munhak","2021"]],"shorts":["문학나눔"],"univ":[],"au":{"b":1972,"kw":"이희주"},"eb":[["YES24 eBook","https://www.yes24.com/product/goods/125342472"]],"full":{},"rel":[],"star":8,"y24":"https://www.yes24.com/product/goods/101761443","daum":"https://search.daum.net/search?w=bookpage&bookId=5691787&q=%EC%82%AC%EB%9E%91%EC%9D%98+%EC%84%B8%EA%B3%84","links":{"google":"https://www.google.com/search?q=%22%EC%82%AC%EB%9E%91%EC%9D%98%20%EC%84%B8%EA%B3%84%22%20%EC%9D%B4%ED%9D%AC%EC%A3%BC","lib":"https://www.data4library.kr/srch?srchText=9791196074449","millie":"https://www.millie.co.kr/v3/search/result/%EC%82%AC%EB%9E%91%EC%9D%98%20%EC%84%B8%EA%B3%84","ridi":"https://ridibooks.com/search?q=%EC%82%AC%EB%9E%91%EC%9D%98%20%EC%84%B8%EA%B3%84","welaaa":"https://www.welaaa.com/search?keyword=%EC%82%AC%EB%9E%91%EC%9D%98%20%EC%84%B8%EA%B3%84","kyobo":"https://search.kyobobook.co.kr/search?keyword=9791196074449","yes24":"https://www.yes24.com/product/search?query=9791196074449","elib":"https://www.google.com/search?q=%EC%82%AC%EB%9E%91%EC%9D%98%20%EC%84%B8%EA%B3%84%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"ba82a5c524":{"id":"ba82a5c524","t":"0인칭의 자리","a":"윤해서","tr":[],"pub":"문학과지성사","y":"2019","isbn":"9788932035789","isbns":["9788932035789"],"cv":"https://image.yes24.com/goods/79636214/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788932035789.jpg","f":"문학","n":"한국","e":"미상","l":"쉽게","pg":"204","ot":"","intro":"“어디에도 없는 너를 당신, 하고 부를 때\n내가 부르는 것은 너인지, 나인지, 그인지”\n\n누구의 자리도 아닌 위치에서\n모두의 자리를 조감하는 시선\n\n시적 사유와 현학적인 문체로 주목받아온 윤해서의 첫 장편소설 『0인칭의 자리』(문학과지성사, 2019)가 출간되었다. “엄청난 독립성이 느껴지는 작품”이라는 평을 받은 첫 소설집 『코러스크로노스』(문학과지성사, 2017) 이후 꾸준히 쓰고 다듬은 장편으로, 저마다의 자리에서 필멸의 생을 견디는 인물들을 섬세한 시선으로 조감한 작품이다.\n\n윤해서의 소설을 읽는다는 것은 해석이 가능한 서사를 따라가는 일이 아니라 끊임없이 사유하며 헤매는 일에 가깝다. 보이지 않는 길을 헤쳐 나가기 위한 무형의 지도를 작가가 이끄는 방향으로 함께 창안하는 작업이며, 그로 인해 누구도 쉽사리 이르지 못했을 언어적 시공간에 가까스로 도달하는 경험이다.","icut":false,"toc":"0인칭의 자리\n작가의 말","recs":[["munhak","2019"]],"shorts":["문학나눔"],"univ":[],"au":{},"eb":[],"full":{},"rel":[],"star":10,"y24":"https://www.yes24.com/product/goods/79636214","daum":"https://search.daum.net/search?w=bookpage&bookId=5083742&q=0%EC%9D%B8%EC%B9%AD%EC%9D%98+%EC%9E%90%EB%A6%AC","links":{"google":"https://www.google.com/search?q=%220%EC%9D%B8%EC%B9%AD%EC%9D%98%20%EC%9E%90%EB%A6%AC%22%20%EC%9C%A4%ED%95%B4%EC%84%9C","lib":"https://www.data4library.kr/srch?srchText=9788932035789","millie":"https://www.millie.co.kr/v3/search/result/0%EC%9D%B8%EC%B9%AD%EC%9D%98%20%EC%9E%90%EB%A6%AC","ridi":"https://ridibooks.com/search?q=0%EC%9D%B8%EC%B9%AD%EC%9D%98%20%EC%9E%90%EB%A6%AC","welaaa":"https://www.welaaa.com/search?keyword=0%EC%9D%B8%EC%B9%AD%EC%9D%98%20%EC%9E%90%EB%A6%AC","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788932035789","yes24":"https://www.yes24.com/product/search?query=9788932035789","elib":"https://www.google.com/search?q=0%EC%9D%B8%EC%B9%AD%EC%9D%98%20%EC%9E%90%EB%A6%AC%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"ba8711a755":{"id":"ba8711a755","t":"황금지붕","a":"오수연","tr":[],"pub":"실천문학사","y":"2007","isbn":"9788939205826","isbns":["9788939205826"],"cv":"https://image.yes24.com/goods/4294174/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788939205826.jpg","f":"문학","n":"한국","e":"현대","l":"쉽게","pg":"334","ot":"","intro":"오랫동안 반전평화운동에 적극적인 관심을 가지고, 이라크와 팔레스타인 분쟁지역의 참담한 상황과 그곳 사람들의 비참한 생활에 천착해온 오수연 작가의 두번째 소설집. 『황금 지붕』을 비롯하여 『길』,『꽃비』등 단편 7편이 수록되어 있다....","icut":false,"toc":"","recs":[["munhak","2007"]],"shorts":["문학나눔"],"univ":[],"au":{"b":1964,"kw":"오수연 (소설가)","en":"Oh Soo-yeon"},"eb":[],"full":{},"rel":[],"star":0,"y24":"https://www.yes24.com/product/goods/4294174","daum":"https://search.daum.net/search?w=bookpage&bookId=554877&q=%ED%99%A9%EA%B8%88%EC%A7%80%EB%B6%95","links":{"google":"https://www.google.com/search?q=%22%ED%99%A9%EA%B8%88%EC%A7%80%EB%B6%95%22%20%EC%98%A4%EC%88%98%EC%97%B0","lib":"https://www.data4library.kr/srch?srchText=9788939205826","millie":"https://www.millie.co.kr/v3/search/result/%ED%99%A9%EA%B8%88%EC%A7%80%EB%B6%95","ridi":"https://ridibooks.com/search?q=%ED%99%A9%EA%B8%88%EC%A7%80%EB%B6%95","welaaa":"https://www.welaaa.com/search?keyword=%ED%99%A9%EA%B8%88%EC%A7%80%EB%B6%95","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788939205826","yes24":"https://www.yes24.com/product/search?query=9788939205826","elib":"https://www.google.com/search?q=%ED%99%A9%EA%B8%88%EC%A7%80%EB%B6%95%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"ba85c8706d":{"id":"ba85c8706d","t":"사랑의 무게","a":"한은원","tr":[],"pub":"한국문화사","y":"2017","isbn":"9788968174599","isbns":["9788968174599"],"cv":"https://image.yes24.com/goods/36107794/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788968174599.jpg","f":"문학","n":"한국","e":"미상","l":"쉽게","pg":"296","ot":"","intro":"오랜 기독교 문화권에 있는 서구문학을 다루지만, 『사랑의 무게』는 영미시를 기독교적인 의미로 다루지는 않는다. 34편의 영미시를 읽어나가면서, 시인들이 삶과 어떠한 씨름을 하고 있으며 그 씨름에서 얻게되는 사랑의 의미가 무엇인지 살펴본다. 또한, 그 의미를지금의 삶에서 이해하기 위해서 34편의 우리 시대 서구 소설과 함께 읽었다.","icut":false,"toc":"글을 시작하며\n삶\n17 대지의 노래\nJ. M. 쿳시 『페테르부르크의 대가』 W. 블레이크 「대지의 대답」\n25 사라진 것들의 흔적\n파트릭 모디아노 『어두운 상점들의 거리』\nW. 워즈워드 「야릇이 북받치는 슬픔 난 겪었네」\n33 자연 예찬의 허구\n헬렌 맥도날드 『메이블 이야기』 로버트 프로스트 「풀베기」\n41 지루한 일상 너머\n크리스토프 바타이유 『다다를 수 없는 나라』 월러스 스티븐스 「일요일 아침」\n50 피해야 할 고통\n레오니드 치프킨 『바덴바덴에서의 여름』 랭스턴 휴즈 「알라바마의 예수」\n58 할 바를 다 했다는 것\n로맹 가리 『새벽의 약속』 스티비 스미스 「결코 다시는」\n66 숨은 그림처럼 떠도는\n존 반빌 『신들은 바다로 떠났다』 엘리자베스 비숍 「세스티나」\n75 받아들이기 힘든 신비\n귀도 미나 디 소스피로 『나무의 회상록』\n딜런 토마스 「초록빛 퓨즈 통해 꽃 내모는 힘이」\n84 비극이 불가능한 시대\n필립 로스 『네메시스』 필립 라르킨 「새벽의 노래」\n92 삶의 허망한 진실\n커트 보네거트 『제5 도살장』 톰 건 「산타 마리아 델 포폴로 성당에서」\n100 어린 날의 욕망\n아이리스 머독 『바다여, 바다여』 세이머스 히니 「검은딸기 따기」\n사람\n111 이 낯선 삶에서 헤맬 때\n데이비드 그로스만 『사자의 꿀』 조지 허버트 「구원」\n118 온전히 받아들임\nJ. 사라마구 『예수복음』 존 밀턴 「내 눈이 멀고 나니」\n125 깊은 절망에서 마주하는 사람\n어빈 얄롬 『니체가 눈물을 흘릴 때』 S. T. 코울리지 「낙담」\n133 애도시란 가능할까\n줄리안 반스 『사랑은 그렇게 끝나지 않는다』 P. S. 셸리 『아도네이스』\n141 랩을 읊는 아이들\n앤서니 버지스 『시계태엽 오렌지』 루이스 캐럴 「재버워키」\n149 어젯밤엔 우리 아빠가\n에릭 포토리노 『은밀하게 나를 사랑한 남자』 시어도어 레트키 「내 아빠의 왈츠」\n157 아버지 이해하기\n르 클레지오 『아프리카인』 R. 로웰 「아버지의 침실」\n165 당당한 삶\n하인리히 뵐 『카타리나 블룸의 잃어버린 명예』\n프랭크 오하라 「레이디가 죽었던 그날」\n173 엄마와 딸\n테레사 학경 차 『딕테』 에이드리언 리치 「문틀이 있다는」\n181 나도 어쩔 수 없는\n토마스 베른하르트 『비트겐슈타인의 조카』 테드 휴즈 「늑대들의 울부짖는 소리」\n189 진귀하고 기이한 무언가로\n바슬라프 니진스키 『영혼의 절규』 실비아 플라스 「다섯 길 바닷물 속에」\n사랑\n199 삶은 항상 사랑 뒤에 온다\n데이비드 밴 『자살의 전설』 존 던 「성 루시 날의 야상시」\n206 나도 사랑의 신을 믿고 싶다\n페르 라게르크비스트 『바라바』 벤 존슨 「천상에」\n214 작은 새 같은 소녀\nM. 쿤데라 『불멸』 로버트 헤릭 「코리나는 오월제 갈 거랍니다」\n223 우울은 나의 힘\n오르한 파묵 『이스탄불』 J. 키츠 「우울에 부치는 노래」\n231 내가 바라는 죽음\n마커스 주삭 『책도둑』 에밀리 디킨슨 「이 바람은 과수원에서 온 건 아니야」\n239 늙은 천사들의 섹스\n가브리엘 마르케스 『내 슬픈 창녀들의 기억』 W. B. 예이츠 「마지막 고백」\n247 갠지스 강에 띄운 디아\n알랭 레몽 『하루하루가 작별의 나날』 에이미 로웰 「꽃잎들」\n255 음악 너머의 음악\n폴 오스터 『우연의 음악』 W. C. 윌리엄스 「사막의 음악」\n262 달리 살 수도 있는 가능성\n카를로스 루이스 샤폰 『바람의 그림자』 T. S. 엘리엇 「번트 노튼」\n270 욕망이 아름다운 열정이 될 때\n라우라 에스키벨 『달콤 쌉싸름한 초콜릿』\ne. e. 커밍스 「초록빛 내 사랑 달려 나갔네」\n278 다다를 수 없는 사랑\n더글라스 호프스테터 『나는 이상한 고리이다』\nW. H. 오든 「더 많이 사랑하는 사람」\n286 사랑의 무게\n재닛 윈터슨 『무게: 아틀라스와 헤라클레스』 리영 리 「감미로움의 무게」\n글을 마치며","recs":[["munhak","2017"]],"shorts":["문학나눔"],"univ":[],"au":{},"eb":[["YES24 eBook","https://www.yes24.com/product/goods/60646300"]],"full":{},"rel":[],"star":0,"y24":"https://www.yes24.com/product/goods/36107794","daum":"https://search.daum.net/search?w=bookpage&bookId=941209&q=%EC%82%AC%EB%9E%91%EC%9D%98+%EB%AC%B4%EA%B2%8C","links":{"google":"https://www.google.com/search?q=%22%EC%82%AC%EB%9E%91%EC%9D%98%20%EB%AC%B4%EA%B2%8C%22%20%ED%95%9C%EC%9D%80%EC%9B%90","lib":"https://www.data4library.kr/srch?srchText=9788968174599","millie":"https://www.millie.co.kr/v3/search/result/%EC%82%AC%EB%9E%91%EC%9D%98%20%EB%AC%B4%EA%B2%8C","ridi":"https://ridibooks.com/search?q=%EC%82%AC%EB%9E%91%EC%9D%98%20%EB%AC%B4%EA%B2%8C","welaaa":"https://www.welaaa.com/search?keyword=%EC%82%AC%EB%9E%91%EC%9D%98%20%EB%AC%B4%EA%B2%8C","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788968174599","yes24":"https://www.yes24.com/product/search?query=9788968174599","elib":"https://www.google.com/search?q=%EC%82%AC%EB%9E%91%EC%9D%98%20%EB%AC%B4%EA%B2%8C%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"ba89654da6":{"id":"ba89654da6","t":"모텔 판문점","a":"오태영","tr":[],"pub":"연극과인간","y":"2017","isbn":"9788957866139","isbns":["9788957866139"],"cv":"https://image.yes24.com/goods/44207103/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788957866139.jpg","f":"예술","n":"한국","e":"근대","l":"쉽게","pg":"292","ot":"","intro":"오태영 희곡집 『모텔 판문점』. 비밀 땅굴을 통해 식량조달을 나왔던 북한 처녀가 남한 청년 남식을 만나 사랑을 나누다 임신을 한다. 이 사실을 알게 된 북한 당국과 청와대는 서둘러 두 사람을 공식적으로 결혼시키기로 합의한다. 결혼식장은 판문점. 그런데 결혼식 축하객 명숙이 실수로 휴전선 경계 넘게 되고, 이를 저지하는 경비병과 몸싸움 도중 치마가 찢어지는 사태로 발전한다. 명숙은 치마를 벗어던지며, 판문점이 통일을 위해 분단 70년 동안 한 일","icut":true,"toc":"","recs":[["munhak","2017"]],"shorts":["문학나눔"],"univ":[],"au":{"b":1871,"kw":"오태영 (1871년)"},"eb":[],"full":{},"rel":[["h","k232218","오태영 (1871년)"]],"star":0,"y24":"https://www.yes24.com/product/goods/44207103","daum":"https://search.daum.net/search?w=bookpage&bookId=767644&q=%EB%AA%A8%ED%85%94+%ED%8C%90%EB%AC%B8%EC%A0%90","links":{"google":"https://www.google.com/search?q=%22%EB%AA%A8%ED%85%94%20%ED%8C%90%EB%AC%B8%EC%A0%90%22%20%EC%98%A4%ED%83%9C%EC%98%81","lib":"https://www.data4library.kr/srch?srchText=9788957866139","millie":"https://www.millie.co.kr/v3/search/result/%EB%AA%A8%ED%85%94%20%ED%8C%90%EB%AC%B8%EC%A0%90","ridi":"https://ridibooks.com/search?q=%EB%AA%A8%ED%85%94%20%ED%8C%90%EB%AC%B8%EC%A0%90","welaaa":"https://www.welaaa.com/search?keyword=%EB%AA%A8%ED%85%94%20%ED%8C%90%EB%AC%B8%EC%A0%90","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788957866139","yes24":"https://www.yes24.com/product/search?query=9788957866139","elib":"https://www.google.com/search?q=%EB%AA%A8%ED%85%94%20%ED%8C%90%EB%AC%B8%EC%A0%90%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"ba89beb99b":{"id":"ba89beb99b","t":"그 레벨에 잠이 오니?","a":"이지은","tr":[],"pub":"미래인","y":"2025","isbn":"9788983949967","isbns":["9788983949967"],"cv":"https://image.yes24.com/goods/169100533/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788983949967.jpg","f":"언어·교양","n":"한국","e":"현대","l":"쉽게","pg":"212","ot":"","intro":"★한낙원과학소설상·한국과학문학상 수상작가 신작 ★게임 세대의 감각을 담은 ‘현실 기반 판타지’ 게임에서 벗어나려는 자, 다시 플레이하라! 수상한 캠프에 간 소년의 현실 레벨 업 한낙원과학소설상, 한국과학문학상 수상작가 이지은의 신작 『그 레벨에 잠이 오니?』는 게임을 즐기는 세대의 정서와 언어, 습관을 누구보다 촘촘히 이해하고, 이를 문학적 서사로 구현한 작품이다. 게임 세대의 ‘관계 방식’과 ‘감정 구조’를 이해하려는 시선, 그리고 그 속에서 피어나는 성장의 가능성을 세심하게 담아내 교사와 학부모가 먼저 읽어야 할 소설로 꼽을 수 있다. 방학이 시작되던 날, 낯선 사람들이 찾아와 철봉이를 어디론가 데려간다. 도착한 곳은 게임에 중독된 아이들을 위한 캠프. 황폐한 마을에 자리한 폐교 같은 곳에 열다섯 명의 아이가 모였다. 사실 철봉은 게임에 중독되지 않았다. 학교폭력에 시달리며 게임을 대신하고 레벨 업을 위해 ‘현질’을 했을 뿐이다.","icut":false,"toc":"그 레벨에 잠이 오니? - 7\n작가의 말 - 208","recs":[["munhak","2026"]],"shorts":["문학나눔"],"univ":[],"au":{"b":1993,"kw":"아이유","en":"IU"},"eb":[["YES24 eBook","https://www.yes24.com/product/goods/194894162"]],"full":{},"rel":[],"star":10,"y24":"https://www.yes24.com/product/goods/169100533","daum":"https://search.daum.net/search?w=bookpage&bookId=7103745&q=%EA%B7%B8+%EB%A0%88%EB%B2%A8%EC%97%90+%EC%9E%A0%EC%9D%B4+%EC%98%A4%EB%8B%88%3F","links":{"google":"https://www.google.com/search?q=%22%EA%B7%B8%20%EB%A0%88%EB%B2%A8%EC%97%90%20%EC%9E%A0%EC%9D%B4%20%EC%98%A4%EB%8B%88%3F%22%20%EC%9D%B4%EC%A7%80%EC%9D%80","lib":"https://www.data4library.kr/srch?srchText=9788983949967","millie":"https://www.millie.co.kr/v3/search/result/%EA%B7%B8%20%EB%A0%88%EB%B2%A8%EC%97%90%20%EC%9E%A0%EC%9D%B4%20%EC%98%A4%EB%8B%88%3F","ridi":"https://ridibooks.com/search?q=%EA%B7%B8%20%EB%A0%88%EB%B2%A8%EC%97%90%20%EC%9E%A0%EC%9D%B4%20%EC%98%A4%EB%8B%88%3F","welaaa":"https://www.welaaa.com/search?keyword=%EA%B7%B8%20%EB%A0%88%EB%B2%A8%EC%97%90%20%EC%9E%A0%EC%9D%B4%20%EC%98%A4%EB%8B%88%3F","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788983949967","yes24":"https://www.yes24.com/product/search?query=9788983949967","elib":"https://www.google.com/search?q=%EA%B7%B8%20%EB%A0%88%EB%B2%A8%EC%97%90%20%EC%9E%A0%EC%9D%B4%20%EC%98%A4%EB%8B%88%3F%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"ba81c695b9":{"id":"ba81c695b9","t":"제주 소녀, 수선화","a":"정복현","tr":[],"pub":"리틀씨앤톡","y":"2023","isbn":"9788960988828","isbns":["9788960988828"],"cv":"https://image.yes24.com/goods/117987940/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788960988828.jpg","f":"언어·교양","n":"한국","e":"미상","l":"쉽게","pg":"224","ot":"","intro":"제주에 난이 일어났다!\n\n모두의 동화 시리즈 33권. 1901년 제주 청년 이재수는 몇몇 탐관오리들과 천주교도들의 수탈로 인해 고통을 받던 백성과 함께 신축민란의 중심에 선다. 하지만 이후 조정에선 이재수를 봉기의 우두머리로 지목하여 사형에 처한다. 그의 동생 이순옥은 오빠가 꿈꾸던 더 좋은 세상을 만들기 위해 오빠의 이야기를 세상에 전하기로 하고 제주를 떠난다. 이 이야기는 바로 그 이재수와 그의 동생 이순옥의 행보에서 영감을 얻어 새롭게 창작한 동화이다.","icut":false,"toc":"칠보 어멈과 무릉댁\n구름의 길\n걸궁패와 운도 아저씨\n보련암과 방물장수\n글을 배우리라\n탄원서\n하리모토와 강이 오빠\n경성행 기차\n조선총독부\n아쉬운 작별\n이카이노의 고향 사람\n이재수 이야기\n작가의 말","recs":[["munhak","2023"]],"shorts":["문학나눔"],"univ":[],"au":{},"eb":[["YES24 eBook","https://www.yes24.com/product/goods/120170155"]],"full":{},"rel":[],"star":10,"y24":"https://www.yes24.com/product/goods/117987940","daum":"https://search.daum.net/search?w=bookpage&bookId=6311878&q=%EC%A0%9C%EC%A3%BC+%EC%86%8C%EB%85%80%2C+%EC%88%98%EC%84%A0%ED%99%94","links":{"google":"https://www.google.com/search?q=%22%EC%A0%9C%EC%A3%BC%20%EC%86%8C%EB%85%80%2C%20%EC%88%98%EC%84%A0%ED%99%94%22%20%EC%A0%95%EB%B3%B5%ED%98%84","lib":"https://www.data4library.kr/srch?srchText=9788960988828","millie":"https://www.millie.co.kr/v3/search/result/%EC%A0%9C%EC%A3%BC%20%EC%86%8C%EB%85%80%2C%20%EC%88%98%EC%84%A0%ED%99%94","ridi":"https://ridibooks.com/search?q=%EC%A0%9C%EC%A3%BC%20%EC%86%8C%EB%85%80%2C%20%EC%88%98%EC%84%A0%ED%99%94","welaaa":"https://www.welaaa.com/search?keyword=%EC%A0%9C%EC%A3%BC%20%EC%86%8C%EB%85%80%2C%20%EC%88%98%EC%84%A0%ED%99%94","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788960988828","yes24":"https://www.yes24.com/product/search?query=9788960988828","elib":"https://www.google.com/search?q=%EC%A0%9C%EC%A3%BC%20%EC%86%8C%EB%85%80%2C%20%EC%88%98%EC%84%A0%ED%99%94%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"ba8df5bef4":{"id":"ba8df5bef4","t":"수상한 중학생들의 착한 연대","a":"박기복","tr":[],"pub":"행복한나무","y":"2021","isbn":"9791188758302","isbns":["9791188758302"],"cv":"https://image.yes24.com/goods/97949512/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9791188758302.jpg","f":"언어·교양","n":"한국","e":"현대","l":"쉽게","pg":"184","ot":"","intro":"함께 비를 맞는 길, 그것이 서로 어깨 걸고 문제를 해결하는 착한 연대다!\n\n은지(중3. 여학생)는 강제전학을 당해서 늘품중학교에 왔다. 예쁜 은지에게 학교 친구들은 관심을 보이지만, 은지는 아무와도 가까워지려고 하지 않고 스스로 외톨이가 된다. 담임 선생님은 채원(중3. 여학생)에게 은지를 도와주라고 부탁하고, 채원은 내키지 않았지만, 진학에 도움이 되는 자원봉사상을 받게 해 준다는 말에 이끌려 은지를 도우려 한다. 그러나 채원이 아무리 노력해도 은지는 ‘너를 믿지 않는다’고 하면서 무조건 밀어내기만 하는데…. 채원이 지쳐서 포기하고 싶어질 무렵 은지가 강제전학을 온 이유를 알게 되고, 진정으로 은지를 돕고 싶은 채원은 전혀 다른 차원의 고민을 떠안게 된다.","icut":false,"toc":"* 등장인물 소개\n│프롤로그│\n1. 그것은 착한 일이었을까?\n2. 내 앙갚음은 정당했을까?\n01. 봄인데 봄이 아니다\n02. 움직이는 마네킹\n03. 자원봉사상, 그 달콤한 유혹\n04. 메아리 없는 외침\n05. 난 불쌍한 사람이 아니야\n06. 타인의 고통\n07. 국가인권위원회\n08. 외로운 자리에서\n09. 텅 빈 서명용지\n10. 급식실 앞 새로운 줄\n11. 네 문제, 우리 문제\n│에필로그│\n1. 집안일 돕기?\n2. 울퉁불퉁한 손가락\n3. 감은 햇살을 어떻게 나눌까?\n4. 비 오는 날","recs":[["munhak","2021"]],"shorts":["문학나눔"],"univ":[],"au":{"b":1971,"kw":"박기복","en":"Ki-bok Park"},"eb":[],"full":{},"rel":[],"star":0,"y24":"https://www.yes24.com/product/goods/97949512","daum":"https://search.daum.net/search?w=bookpage&bookId=5618251&q=%EC%88%98%EC%83%81%ED%95%9C+%EC%A4%91%ED%95%99%EC%83%9D%EB%93%A4%EC%9D%98+%EC%B0%A9%ED%95%9C+%EC%97%B0%EB%8C%80","links":{"google":"https://www.google.com/search?q=%22%EC%88%98%EC%83%81%ED%95%9C%20%EC%A4%91%ED%95%99%EC%83%9D%EB%93%A4%EC%9D%98%20%EC%B0%A9%ED%95%9C%20%EC%97%B0%EB%8C%80%22%20%EB%B0%95%EA%B8%B0%EB%B3%B5","lib":"https://www.data4library.kr/srch?srchText=9791188758302","millie":"https://www.millie.co.kr/v3/search/result/%EC%88%98%EC%83%81%ED%95%9C%20%EC%A4%91%ED%95%99%EC%83%9D%EB%93%A4%EC%9D%98%20%EC%B0%A9%ED%95%9C%20%EC%97%B0%EB%8C%80","ridi":"https://ridibooks.com/search?q=%EC%88%98%EC%83%81%ED%95%9C%20%EC%A4%91%ED%95%99%EC%83%9D%EB%93%A4%EC%9D%98%20%EC%B0%A9%ED%95%9C%20%EC%97%B0%EB%8C%80","welaaa":"https://www.welaaa.com/search?keyword=%EC%88%98%EC%83%81%ED%95%9C%20%EC%A4%91%ED%95%99%EC%83%9D%EB%93%A4%EC%9D%98%20%EC%B0%A9%ED%95%9C%20%EC%97%B0%EB%8C%80","kyobo":"https://search.kyobobook.co.kr/search?keyword=9791188758302","yes24":"https://www.yes24.com/product/search?query=9791188758302","elib":"https://www.google.com/search?q=%EC%88%98%EC%83%81%ED%95%9C%20%EC%A4%91%ED%95%99%EC%83%9D%EB%93%A4%EC%9D%98%20%EC%B0%A9%ED%95%9C%20%EC%97%B0%EB%8C%80%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"ba8bc0ad22":{"id":"ba8bc0ad22","t":"나는 조선의 가장 어린 여행 작가","a":"홍선주","tr":[],"pub":"웃는돌고래","y":"2017","isbn":"9788997715503","isbns":["9788997715503"],"cv":"https://image.yes24.com/goods/44145208/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788997715503.jpg","f":"언어·교양","n":"한국","e":"미상","l":"쉽게","pg":"236","ot":"","intro":"조선 청년의 기행문을 통해 경험하는 조선통신사 행렬\n\n《나는 조선의 가장 어린 여행 작가》는 스물네 살 홍경해가 쓴 기행문 《수사일록》을 현대어로 풀어 쓴 작품입니다. 홍경해는 아버지 홍계희가 조선통신사 정사로 임명되면서 ‘자제 군관’의 자격으로 일본에 방문합니다. 조선통신사에는 기록을 담당하는 제술관이 있어 각 행렬의 자취를 남겼으나 홍경해는 자신이 경험한 것을 기록하는 ‘여행 작가’가 되겠다는 당찬 포부를 가집니다. 공적인 업무가 아니라 개인적인 경험을 자유롭게 기록했다는 점에서 이 작품은 남다른 의미를 가집니다.\n약 4백 년 전 일본을 방문한 조선 청년의 솔직한 자기 기록을 통해 우리는 당시 조선과 일본의 관계, 당시 일본의 모습, 조선통신사 행렬의 특징 등을 생생하게 만날 수 있습니다.","icut":false,"toc":"옮긴이의 말－18세기 평범한 학생의 일본 여행 이야기, 한번 들어 볼래?\n들어가며－믿음을 주고받는 사신, 조선통신사\n첫째 장 아버지를 따라서 일본으로 떠나다\n* 쉬어 가는 이야기\n살인 사건까지 일으킨 인삼의 인기\n조선통신사 여행길은 정말 힘들어\n둘째 장 일본 여행의 시작 쓰시마 섬\n* 쉬어 가는 이야기\n조선통신사에는 어린이도 있었어\n셋째 장 신선이 사는 곳처럼 아름다운 아이노시마 섬\n넷째 장 드디어 육지로, 시모노세키\n다섯째 장 화려하고 번화한 오사카\n여섯째 장 천황이 사는 교토\n* 쉬어 가는 이야기\n교토에 있는 귀무덤\n일곱째 장 아름다운 비와 호수, 그리고 후지 산\n* 쉬어 가는 이야기\n통신사는 한류 스타\n여덟째 장 에도 성에 들어가 국서를 전달하다\n* 쉬어 가는 이야기\n책을 사랑한 일본인들\n돌아오는 길 글씨를 남기다\n나가며\n참고 문헌","recs":[["munhak","2017"],["teen","2017"]],"shorts":["문학나눔","청소년 권장"],"univ":[],"au":{},"eb":[],"full":{},"rel":[],"star":10,"y24":"https://www.yes24.com/product/goods/44145208","daum":"https://search.daum.net/search?w=bookpage&bookId=1494407&q=%EB%82%98%EB%8A%94+%EC%A1%B0%EC%84%A0%EC%9D%98+%EA%B0%80%EC%9E%A5+%EC%96%B4%EB%A6%B0+%EC%97%AC%ED%96%89+%EC%9E%91%EA%B0%80%28%EA%BF%88%EA%BE%B8%EB%8A%94+%EB%8F%8C%EA%B3%A0%EB%9E%98+5%29","links":{"google":"https://www.google.com/search?q=%22%EB%82%98%EB%8A%94%20%EC%A1%B0%EC%84%A0%EC%9D%98%20%EA%B0%80%EC%9E%A5%20%EC%96%B4%EB%A6%B0%20%EC%97%AC%ED%96%89%20%EC%9E%91%EA%B0%80%22%20%ED%99%8D%EC%84%A0%EC%A3%BC","lib":"https://www.data4library.kr/srch?srchText=9788997715503","millie":"https://www.millie.co.kr/v3/search/result/%EB%82%98%EB%8A%94%20%EC%A1%B0%EC%84%A0%EC%9D%98%20%EA%B0%80%EC%9E%A5%20%EC%96%B4%EB%A6%B0%20%EC%97%AC%ED%96%89%20%EC%9E%91%EA%B0%80","ridi":"https://ridibooks.com/search?q=%EB%82%98%EB%8A%94%20%EC%A1%B0%EC%84%A0%EC%9D%98%20%EA%B0%80%EC%9E%A5%20%EC%96%B4%EB%A6%B0%20%EC%97%AC%ED%96%89%20%EC%9E%91%EA%B0%80","welaaa":"https://www.welaaa.com/search?keyword=%EB%82%98%EB%8A%94%20%EC%A1%B0%EC%84%A0%EC%9D%98%20%EA%B0%80%EC%9E%A5%20%EC%96%B4%EB%A6%B0%20%EC%97%AC%ED%96%89%20%EC%9E%91%EA%B0%80","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788997715503","yes24":"https://www.yes24.com/product/search?query=9788997715503","elib":"https://www.google.com/search?q=%EB%82%98%EB%8A%94%20%EC%A1%B0%EC%84%A0%EC%9D%98%20%EA%B0%80%EC%9E%A5%20%EC%96%B4%EB%A6%B0%20%EC%97%AC%ED%96%89%20%EC%9E%91%EA%B0%80%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"ba87930473":{"id":"ba87930473","t":"우리는 가족일까","a":"유니게","tr":[],"pub":"푸른책들","y":"2017","isbn":"9788957984901","isbns":["9788957984901"],"cv":"https://image.yes24.com/goods/16857882/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788957984901.jpg","f":"언어·교양","n":"한국","e":"미상","l":"쉽게","pg":"208","ot":"","intro":"이혼과 엄마의 죽음, 7년만에 만나는 동생으로 인해 방황하는 열일곱 살의 소녀가 가족의 의미를 깨달아 가는 과정을 그린 작품이다. 이 작품은 가족 간의 물리적인 결합이나 진위에 대한 물음이 아니라 진짜 가족이 되는 순간을 고찰하고 가족이란 무엇인가를 독자들에게 묻는다.\n\n청소년기의 방황은 때로는 어른으로 가는 지름길이 되기도 한다. 『우리는 가족일까』는 작가가 말한 “극심한 고통을 직면한 순간에 시작되는 성장”을 겪고 있는 모든 청소년들에게 보내는 응원과 위로이다. 이 작품을 통해 끊임없이 고민하게 되는 가족의 의미에 대해 다시금 곱씹고 스스로에게 물어보며 처음과는 다름 울림을 느낄 수 있을 것이다.","icut":false,"toc":"1. 낯선, 아주 낯선 동생이 왔다\n2. 이제, 알람 시계는 필요 없다\n3. 동생의 보호자가 되고 말았다\n4. 막살기로 했다\n5. 시간아, 빨리빨리 흘러라\n6. 달팽이처럼\n7. 나에게도 친구가 생기다니, 기적이다\n8. 성장통\n9. 동생의 두 얼굴\n10. 가까이 걷기\n11. 생태탕은 이제 먹지 않을 것이다\n12. 모두가 쓸쓸하고 고독한 밤\n13. 마침내 사건이 터졌다\n14. 위로가 필요한 날\n15. 동생의 고백\n16. 엄마에 대한 기억\n17. 동생에게 방이 생겼다\n작가의 말","recs":[["munhak","2015"]],"shorts":["문학나눔"],"univ":[],"au":{},"eb":[["YES24 eBook","https://www.yes24.com/product/goods/23688615"]],"full":{},"rel":[],"star":10,"y24":"https://www.yes24.com/product/goods/16857882","daum":"https://search.daum.net/search?w=bookpage&bookId=770697&q=%EC%9A%B0%EB%A6%AC%EB%8A%94+%EA%B0%80%EC%A1%B1%EC%9D%BC%EA%B9%8C%28%ED%91%B8%EB%A5%B8%EB%8F%84%EC%84%9C%EA%B4%80+71%29%28%EC%96%91%EC%9E%A5%EB%B3%B8+HardCover%29","links":{"google":"https://www.google.com/search?q=%22%EC%9A%B0%EB%A6%AC%EB%8A%94%20%EA%B0%80%EC%A1%B1%EC%9D%BC%EA%B9%8C%22%20%EC%9C%A0%EB%8B%88%EA%B2%8C","lib":"https://www.data4library.kr/srch?srchText=9788957984901","millie":"https://www.millie.co.kr/v3/search/result/%EC%9A%B0%EB%A6%AC%EB%8A%94%20%EA%B0%80%EC%A1%B1%EC%9D%BC%EA%B9%8C","ridi":"https://ridibooks.com/search?q=%EC%9A%B0%EB%A6%AC%EB%8A%94%20%EA%B0%80%EC%A1%B1%EC%9D%BC%EA%B9%8C","welaaa":"https://www.welaaa.com/search?keyword=%EC%9A%B0%EB%A6%AC%EB%8A%94%20%EA%B0%80%EC%A1%B1%EC%9D%BC%EA%B9%8C","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788957984901","yes24":"https://www.yes24.com/product/search?query=9788957984901","elib":"https://www.google.com/search?q=%EC%9A%B0%EB%A6%AC%EB%8A%94%20%EA%B0%80%EC%A1%B1%EC%9D%BC%EA%B9%8C%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"ba879ae0a7":{"id":"ba879ae0a7","t":"가루와 함께 일주일만 놀아보자","a":"최희규","tr":[],"pub":"이담북스","y":"2012","isbn":"9788926830642","isbns":["9788926830642"],"cv":"https://image.yes24.com/goods/6319127/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788926830642.jpg","f":"자연과학","n":"한국","e":"미상","l":"쉽게","pg":"197","ot":"","intro":"인간의 삶에 밀착되어 있는 가루에 대해 우리는 얼마만큼 알고 있을까? 분체공학, 미립자, 나노입자 등 짐짓 어렵게만 보이는 이 학문을 저자는 ‘가루’라는 말로 쉽고 재미있게 풀어낸다. 해외에서는 관련 서적이 풍부해 정보를 쉽게 습득할 수 있는 반면, 우리나라에서 분체공학을 가까이 접할 수 있는 기회가 극히 드물다. 이 책은 그간의 독자들의 가루에 대한 궁금증을 시원하게 해갈시켜 줄 것이다.","icut":false,"toc":"머리말 월요 가루란 무엇일까? 가루를 알자! 01 가루의 크기? 02 어디까지가 분자이고어디까지 가루인가? 03 가루의 크기는 어떻게 결정될까? 04 너노 크기 가루를 재어보자 05 크기가 작으면 잘 붙는다 06 가루는 '표면'에서 결정된다 ㆍ가루박사님이 들려주는 가루 이야기 주변의 가루 이야기 화요 가루를 만들자! 01 가루를 만든다 02 물리증착법으로 가루를 03 화학증착법으로 가루를 04 카본나노튜브(CNT) 05 카본나노튜브를 만든다 06 액체 속에서 가루 만들기 07 맛있는 약도 가루로 만든다 08 가루의 표면을 바꿔보자 ㆍ가루박사님이 들려주는 가루 이야기 가루를 만든다 - 왜? 어떻게? 어디에 쓰려고? 수요 무서운 가루! 01 대기 오염도 가루가 02 가루를 모은다? 03 액체처럼 움직이는 가루 04 막히는 가루 05 가루가 불을 뿜는다? 06 날아다니면서 괴롭히는 가루 07 지반이 약해지면 아파트가 가라앉는다 08 오존층의 변화에도 가루가 작용? ㆍ가루박사님이 들려주는 가루 이야기 무서운 가루도 있어요 목요 가루 속에 숨어 있는 수학의 비밀 01 흙을 분리하면 여러 종류의 가루가 - 스톡스 식 02 굴절률이란? 03 가루는 표면의 면적이 중요 04 가루의 딱딱함은? - 본드의 식 05 피라미드의 도굴을 막는 가루의 기술 - 약센 식 06 가루의 크기는 다양한 분포를 이룬다 07 가루는 여러 가지 모양 - 형상지수 ㆍ가루박사님이 들려주는 가루 이야기 가루의 크기는 어떻게 잴까? 금요 가루하고 놀자! 01 전자복사와 프린트는 가루가 결정한다 02 밤에도 환해요 - 글라스비즈 03 불에 타는 쇳가루 04 왜 가루로 만들까? 05 도자기의 발명은 첨단분체기술 06 얼음은 투명한테 눈은 왜 하얄까? 07 떼려야 뗄 수 없는 생활 중의 가루 08 가루가 당신의 피부를 지켜준다 09 아름다운 불꽃 ㆍ가루박사님이 들려주는 가루 이야기 뭉치면 변하는 가루들 토요 가루를 먹자! 01 가루하면 '밀가루' 02 커피도 가루다 03 설탕도 가루다 04 하루에 한 번만 먹는 약 05 '음이온'의 효과는? 06 가루로 만든 약 07 마이크로 캡슐화로 생활이 변한다 ㆍ가루박사님이 들려주는 가루 이야기 움직이는 가루, 분체 일요 미래의 가루들 01 우주시대에서 가루의 역할 02 가루의 새로운 세계 03 미래에는 에너지도 가루에서부터 04 아픈 사람을 치료하는 가루 05 가루는 건강도 지켜줍니다 06 깨끗한 연료도 가루에서 07 친환경 페인트도 가루에서부터 08 액정 디스플레이도 가루에서 │실헙1│가루의 마술 - 소금 눈 │실헌2│가루의 마술 - 가루오 빛을 본다 감사의 글 참고문헌 색인","recs":[["sci","2013"]],"shorts":["우수과학도서"],"univ":[],"au":{},"eb":[["YES24 eBook","https://www.yes24.com/product/goods/14163027"]],"full":{},"rel":[],"star":0,"y24":"https://www.yes24.com/product/goods/6319127","daum":"https://search.daum.net/search?w=bookpage&bookId=445454&q=%EA%B0%80%EB%A3%A8%EC%99%80+%ED%95%A8%EA%BB%98+%EC%9D%BC%EC%A3%BC%EC%9D%BC%EB%A7%8C+%EB%86%80%EC%95%84%EB%B3%B4%EC%9E%90","links":{"google":"https://www.google.com/search?q=%22%EA%B0%80%EB%A3%A8%EC%99%80%20%ED%95%A8%EA%BB%98%20%EC%9D%BC%EC%A3%BC%EC%9D%BC%EB%A7%8C%20%EB%86%80%EC%95%84%EB%B3%B4%EC%9E%90%22%20%EC%B5%9C%ED%9D%AC%EA%B7%9C","lib":"https://www.data4library.kr/srch?srchText=9788926830642","millie":"https://www.millie.co.kr/v3/search/result/%EA%B0%80%EB%A3%A8%EC%99%80%20%ED%95%A8%EA%BB%98%20%EC