.com/product/search?query=9788952115591","elib":"https://www.google.com/search?q=%EC%98%88%EC%9D%B4%EC%B8%A0%20%EC%84%9C%EC%A0%95%EC%8B%9C%20%EC%A0%84%EC%A7%91%20.1%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfa8c1e389":{"id":"bfa8c1e389","t":"가슴이 시키는 일","a":"김이율","tr":[],"pub":"판테온하우스","y":"2011","isbn":"9788996439394","isbns":["9788996439394"],"cv":"https://image.yes24.com/goods/4456460/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788996439394.jpg","f":"경제·경영","n":"한국","e":"미상","l":"보통","pg":"248","ot":"","intro":"가슴이 시키는 ‘진짜 삶’을 찾아 나선 사람들의 감동적이고 가슴 찡한 이야기\n\n『가슴이 시키는 일 - 꿈과 행복을 완성시켜주는 마음의 명령』은 먹고 살기 위해서 억지로 하는 일이 아닌, 자신이 정말 하고 싶고, 하면 할수록 정말 행복한 일을 하기 위해서 ‘진짜 삶’을 선택한 사람들의 이야기를 담은 책이다. 자신의 머리가 아닌 ‘가슴이 시키는 일’을 선택한 이들은 당장은 불편하고 고통스럽더라도 마음이 시키는 명령에 따라 모든 편안함을 잠시 접어둔 삶을 살아간다.","icut":false,"toc":"머리말 _ 지금, 당신은 ‘가슴이 시키는 일’을 하고 있는가?\nChapter 1 지금 하지 않으면 할 수 없는 일\n- 가슴이 시키는 일 | 한국의 슈바이처 이태석 신부\n플러스 메시지 _ 행복의 완성\n- 지금, 나는 행복할까? | 전 KBS 아나운서 손미나\n플러스 메시지 _ 내가 원하는 진짜 삶\n- 나를 넘어서라 | 한국이 낳은 세계 최고의 피겨퀸 김연아\n플러스 메시지 _ 꿈의 힘\n- 더 이상 과거가 아닌 미래를 향해 달려라\n| 세계 최고령 마라톤 완주자 파우자 싱\n플러스 메시지 _ 인생을 두 번 살 수 있는 사람은 아무도 없다\n- 뜨거운 열정을 가진 사람에게는 세상도 굴복한다\n| 33년 동안 ‘꿈의 궁전’을 쌓은 페르디낭 슈발\n플러스 메시지 _ 세상에서 ‘가장’ 강한 사람\n- 정말 하고 싶은 일이라면 모든 것을 걸어라\n| 세계 최초의 여성 종군기자 마가렛 버크 화이트\n플러스 메시지 _ 목숨을 건 것과 걸지 않는 것의 차이\n- 미래의 나를 마음껏 상상하고 꿈꿔라 | 『해리포터』 작가 조앤 롤링\n플러스 메시지 _ 아름다운 내일을 만드는 최고의 마음 치료제\n- 힘이 들수록 더 힘차게 전진하라\n| 암을 극복한 인간 승리의 신화 랜스 암스트롱\n플러스 메시지 _ 목표가 있는 것과 없는 것의 차이\n- 더 이상 미루지 말고 지금 즉시 해라\n| 평생 꿈을 기록하고 실천한 존 고다드\n플러스 메시지 _ 지금 알고 있는 걸 그때도 알았더라면\n2장 지금, 당장 시작하라\n- 모든 일들은 나름의 이유가 다 있다 | 세계 최고의 명배우 찰리 채플린\n플러스 메시지 _ 당신만의 색으로 세상을 색칠하라\n- 몸이 아프다고 꿈마저 아픈 것은 아니다\n| 전세계를 감동시킨 오페라 가수 폴 포츠\n플러스 메시지 _ 진짜로 살아 있다는 것\n- 간절히 바라고 희망하면 결국은 이루어진다\n| 토크쇼의 여왕 오프라 윈프리\n플러스 메시지 _ 행운을 바란다면\n- 460억 원보다 더 값진 것\n| 편지 한 통에 460억 원을 포기한 남자 시셉스키\n플러스 메시지 _ 인생을 제대로 사는 법\n- 지금 내 삶이 누군가의 ‘희망’이 될 수도 있다\n| 장애인들에게 희망을 심어준 헤더밀스\n플러스 메시지 _ 모든 것은 다 흘러가기 마련이다\n- 이름값을 해라 | 한국 제과제빵계의 마에스트로 김영모\n플러스 메시지 _ 간절히 간절히 간절히, 끝까지 끝까지 끝까지\n- 단점에 신경 쓰지 말고 장점을 최대한 살려라\n| 못생긴 외모를 극복한 가수 캐스달리\n플러스 메시지 _ 단점이 개성이 될 수도 있다\n- 신입사원 시절의 열정을 아직도 갖고 있는가?\n| 미국의 살아 있는 전설 아이야코카\n플러스 메시지 _ 지금 절망에 빠져 있다면……\n- 어느 순간에도 흔들리지 않는 강한 프로정신을 가져라\n| 세계의 대통령 UN 사무총장 반기문\n플러스 메시지 _ 모든 위대한 일의 시작\n- 남과 다른 생각 | 기존의 방식과 법칙을 거부한 아오야마 고로\n플러스 메시지 _ 세상에 정답은 없다! 당신만의 정답을 만들어라\n- 계속 두드려라! 언젠가는 열릴 것이다\n| 파산의 늪에 빠진 제록스를 살려낸 엔 멀케이\n플러스 메시지 _ 나를 더욱 돋보이게 하는 방법\n- 딱 한 걸음만 앞서가라 | 중국 인터넷 업계의 신적인 존재 마윈\n플러스 메시지 _ 트렌드를 읽는 법\n3장 마음이 시키는 대로 하라\n- 마음을 흔드는 유혹에서 벗어나라\n| 세계 축구사를 다시 쓴 축구 황제 펠레\n플러스 메시지 _ 처음처럼, 늘 변함없이……\n- 아버지의 이름으로 | 암 투병 아버지에게 간 이식을 해준 탤런트 최성준\n플러스 메시지 _ ‘부모’라는 사람들\n- 마음을 담은 선물은 눈사람도 녹인다 | 로큰롤의 제왕 엘비스 프레슬리\n플러스 메시지 _ 마음의 거리를 좁히는 방법\n- 먼훗날 기억될 아름답고 가슴 떨리는 사랑\n| 소설 『데미안』의 작가 헤르만 헤세\n플러스 메시지 _ 아름다운 ‘첫’ 추억들\n- 날개 부러진 슈퍼맨 부부의 사랑\n| 영화 「슈퍼맨」의 주인공 크리스토퍼 리브\n플러스 메시지 _ 사랑보다 더 큰 기적은 없다\n- 하늘이 정해준 운명 | 작곡가 멘델스존의 할아버지 모세 멘델스존\n플러스 메시지 _ 그 사람의 향기, 그 사람의 진심을 읽어라\n- 멀리 있어 더 아름다운 사랑 | 동화의 아버지 안데르센\n플러스 메시지 _ 사랑의 완성","recs":[["sejong","2011"]],"shorts":["세종도서"],"univ":[],"au":{},"eb":[],"full":{},"rel":[],"star":7.6,"y24":"https://www.yes24.com/product/goods/4456460","daum":"https://search.daum.net/search?w=bookpage&bookId=1468907&q=%EA%B0%80%EC%8A%B4%EC%9D%B4+%EC%8B%9C%ED%82%A4%EB%8A%94+%EC%9D%BC","links":{"google":"https://www.google.com/search?q=%22%EA%B0%80%EC%8A%B4%EC%9D%B4%20%EC%8B%9C%ED%82%A4%EB%8A%94%20%EC%9D%BC%22%20%EA%B9%80%EC%9D%B4%EC%9C%A8","lib":"https://www.data4library.kr/srch?srchText=9788996439394","millie":"https://www.millie.co.kr/v3/search/result/%EA%B0%80%EC%8A%B4%EC%9D%B4%20%EC%8B%9C%ED%82%A4%EB%8A%94%20%EC%9D%BC","ridi":"https://ridibooks.com/search?q=%EA%B0%80%EC%8A%B4%EC%9D%B4%20%EC%8B%9C%ED%82%A4%EB%8A%94%20%EC%9D%BC","welaaa":"https://www.welaaa.com/search?keyword=%EA%B0%80%EC%8A%B4%EC%9D%B4%20%EC%8B%9C%ED%82%A4%EB%8A%94%20%EC%9D%BC","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788996439394","yes24":"https://www.yes24.com/product/search?query=9788996439394","elib":"https://www.google.com/search?q=%EA%B0%80%EC%8A%B4%EC%9D%B4%20%EC%8B%9C%ED%82%A4%EB%8A%94%20%EC%9D%BC%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfab1a4fd6":{"id":"bfab1a4fd6","t":"우르비노의 비너스","a":"윤혜준","tr":[],"pub":"나남","y":"2009","isbn":"9788930005852","isbns":["9788930005852"],"cv":"https://image.yes24.com/goods/3369249/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788930005852.jpg","f":"문학","n":"한국","e":"미상","l":"쉽게","pg":"334","ot":"","intro":"현직 영문과 교수로 재직 중인 작가가 야수성이 설쳐대는 이 시대에 마냥 침묵할 수만은 없다는 절박함으로 쓴 소설. 현실에 바탕을 두고, 우리가 매일 쓰는 이메일 형식을 빌려 쓴 서간체 형식이어서 읽다 보면 우리가 알고 있는 사람들이 철인, 우정, 상희의 얼굴 위로 스쳐 지나간다. 아니 우리의 모습과 닮아 있다. 작가가 서양 미술사에 대해서도 논문을 쓸 수 있을 만큼 박학한 지식을 가지고 써서 이 소설은 일종의 미술사 연구서이기도 하다.","icut":false,"toc":"머리말\n연구실\n런던\n파리\n마드리드\n로마\n피렌체\n베네치아\n동두천\n피날레","recs":[["sejong","2009"]],"shorts":["세종도서"],"univ":[],"au":{},"eb":[],"full":{},"rel":[],"star":5,"y24":"https://www.yes24.com/product/goods/3369249","daum":"https://search.daum.net/search?w=bookpage&bookId=468842&q=%EC%9A%B0%EB%A5%B4%EB%B9%84%EB%85%B8%EC%9D%98+%EB%B9%84%EB%84%88%EC%8A%A4","links":{"google":"https://www.google.com/search?q=%22%EC%9A%B0%EB%A5%B4%EB%B9%84%EB%85%B8%EC%9D%98%20%EB%B9%84%EB%84%88%EC%8A%A4%22%20%EC%9C%A4%ED%98%9C%EC%A4%80","lib":"https://www.data4library.kr/srch?srchText=9788930005852","millie":"https://www.millie.co.kr/v3/search/result/%EC%9A%B0%EB%A5%B4%EB%B9%84%EB%85%B8%EC%9D%98%20%EB%B9%84%EB%84%88%EC%8A%A4","ridi":"https://ridibooks.com/search?q=%EC%9A%B0%EB%A5%B4%EB%B9%84%EB%85%B8%EC%9D%98%20%EB%B9%84%EB%84%88%EC%8A%A4","welaaa":"https://www.welaaa.com/search?keyword=%EC%9A%B0%EB%A5%B4%EB%B9%84%EB%85%B8%EC%9D%98%20%EB%B9%84%EB%84%88%EC%8A%A4","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788930005852","yes24":"https://www.yes24.com/product/search?query=9788930005852","elib":"https://www.google.com/search?q=%EC%9A%B0%EB%A5%B4%EB%B9%84%EB%85%B8%EC%9D%98%20%EB%B9%84%EB%84%88%EC%8A%A4%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfa40bb15f":{"id":"bfa40bb15f","t":"지구의 경고 시리즈 1: 코로나19","a":"김난영","tr":[],"pub":"대원키즈","y":"2020","isbn":"9791136245052","isbns":["9791136245052"],"cv":"https://image.yes24.com/goods/95788061/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9791136245052.jpg","f":"언어·교양","n":"한국","e":"20세기","l":"쉽게","pg":"172","ot":"","intro":"마스크는 왜 써야 하나요? 코로나19에 걸렸던 친구와 가까이 지내면 안 되나요? 바이러스, 팬데믹에 대해 알고 싶어요. 우리가 할 수 있는 일은 무엇인가요? 막연하게 두려워하지 말고, 정확한 정보를 알고 대비해 봐요. 초등학생들이 코로나19에 대해 갖고 있는 궁금증을 시원하게 풀어보는 『코로나19』입니다.","icut":false,"toc":"마스크 착용과 사회적 거리 두기\n세균과 바이러스\n바이러스와 질병\n개인위생과 생활 속 방역\n코로나19 바이러스의 특징과 감염 경로\n백신과 집단면역\n팬데믹\n백신의 역할과 개","recs":[["sejong","2021"]],"shorts":["세종도서"],"univ":[],"au":{"b":1943,"kw":"김난영 (1943년)","en":"Kim Nan-yeong"},"eb":[],"full":{},"rel":[],"star":10,"y24":"https://www.yes24.com/product/goods/95788061","daum":"https://search.daum.net/search?w=bookpage&bookId=5528135&q=%EC%A7%80%EA%B5%AC%EC%9D%98+%EA%B2%BD%EA%B3%A0+%EC%8B%9C%EB%A6%AC%EC%A6%88+1%3A+%EC%BD%94%EB%A1%9C%EB%82%9819","links":{"google":"https://www.google.com/search?q=%22%EC%A7%80%EA%B5%AC%EC%9D%98%20%EA%B2%BD%EA%B3%A0%20%EC%8B%9C%EB%A6%AC%EC%A6%88%201%22%20%EA%B9%80%EB%82%9C%EC%98%81","lib":"https://www.data4library.kr/srch?srchText=9791136245052","millie":"https://www.millie.co.kr/v3/search/result/%EC%A7%80%EA%B5%AC%EC%9D%98%20%EA%B2%BD%EA%B3%A0%20%EC%8B%9C%EB%A6%AC%EC%A6%88%201","ridi":"https://ridibooks.com/search?q=%EC%A7%80%EA%B5%AC%EC%9D%98%20%EA%B2%BD%EA%B3%A0%20%EC%8B%9C%EB%A6%AC%EC%A6%88%201","welaaa":"https://www.welaaa.com/search?keyword=%EC%A7%80%EA%B5%AC%EC%9D%98%20%EA%B2%BD%EA%B3%A0%20%EC%8B%9C%EB%A6%AC%EC%A6%88%201","kyobo":"https://search.kyobobook.co.kr/search?keyword=9791136245052","yes24":"https://www.yes24.com/product/search?query=9791136245052","elib":"https://www.google.com/search?q=%EC%A7%80%EA%B5%AC%EC%9D%98%20%EA%B2%BD%EA%B3%A0%20%EC%8B%9C%EB%A6%AC%EC%A6%88%201%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfa4676441":{"id":"bfa4676441","t":"미치지도 죽지도 않았다","a":"김소연","tr":[],"pub":"효형출판","y":"2019","isbn":"9788958721680","isbns":["9788958721680"],"cv":"https://image.yes24.com/goods/84816147/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788958721680.jpg","f":"문학","n":"한국","e":"현대","l":"쉽게","pg":"240","ot":"","intro":"비주류 여성이 인생 역전의 공간을 만났다. 가부장제가 만연한 땅에서 자신의 길을 걸어간 근대 여성들. 전통과 근대, 제국과 식민지, 동양과 서양이 충돌하는 울퉁불퉁한 땅을 지나며 목소리를 내기까지 기어코 미치지도 죽지도 않았다. 그리고 다른 무엇도 아닌 자기 자신을 믿었다.","icut":false,"toc":"프롤로그\n사람대접을 받게 해주고 싶어요\nSpace #1 이화학당\nWoman #1 메리 스크랜턴\n여성이 여성에게 의술을 전한다\nSpace #2 보구여관\nWoman #2 로제타 셔우드 홀 & 박에스더\n살되, 네 생명을 살아라\nSpace #3 상동교회\nWoman #3 차미리사\n조선 여자의 지위 향상과 단결을 주장하오\nSpace #4 세브란스병원 간호부 양성소\nWoman #4 정종명\n당당해야 삶이 바뀐다\nSpace #5 조선일보 & 동아일보\nWoman #5 최은희 & 허정숙\n내 밥벌이는 내 손으로\nSpace #6 조지아백화점 & 화신백화점\nWoman #6 송계월 & 임형선\n죽을 각오로 싸운다\nSpace #7 평원고무공장 & 대동방적공장\nWoman #7 강주룡 & 강경애\n그 후, 그 장소, 그 사람\n에필로그\n미주\n참고문헌","recs":[["sejong","2020"]],"shorts":["세종도서"],"univ":[],"au":{"b":1980,"kw":"김소연 (1980년)","en":"Kim So-yeon"},"eb":[],"full":{},"rel":[],"star":9.4,"y24":"https://www.yes24.com/product/goods/84816147","daum":"https://search.daum.net/search?w=bookpage&bookId=5154386&q=%EB%AF%B8%EC%B9%98%EC%A7%80%EB%8F%84+%EC%A3%BD%EC%A7%80%EB%8F%84+%EC%95%8A%EC%95%98%EB%8B%A4","links":{"google":"https://www.google.com/search?q=%22%EB%AF%B8%EC%B9%98%EC%A7%80%EB%8F%84%20%EC%A3%BD%EC%A7%80%EB%8F%84%20%EC%95%8A%EC%95%98%EB%8B%A4%22%20%EA%B9%80%EC%86%8C%EC%97%B0","lib":"https://www.data4library.kr/srch?srchText=9788958721680","millie":"https://www.millie.co.kr/v3/search/result/%EB%AF%B8%EC%B9%98%EC%A7%80%EB%8F%84%20%EC%A3%BD%EC%A7%80%EB%8F%84%20%EC%95%8A%EC%95%98%EB%8B%A4","ridi":"https://ridibooks.com/search?q=%EB%AF%B8%EC%B9%98%EC%A7%80%EB%8F%84%20%EC%A3%BD%EC%A7%80%EB%8F%84%20%EC%95%8A%EC%95%98%EB%8B%A4","welaaa":"https://www.welaaa.com/search?keyword=%EB%AF%B8%EC%B9%98%EC%A7%80%EB%8F%84%20%EC%A3%BD%EC%A7%80%EB%8F%84%20%EC%95%8A%EC%95%98%EB%8B%A4","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788958721680","yes24":"https://www.yes24.com/product/search?query=9788958721680","elib":"https://www.google.com/search?q=%EB%AF%B8%EC%B9%98%EC%A7%80%EB%8F%84%20%EC%A3%BD%EC%A7%80%EB%8F%84%20%EC%95%8A%EC%95%98%EB%8B%A4%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfa9bb491e":{"id":"bfa9bb491e","t":"한국인이 좋아하는 중국사","a":"구성희","tr":[],"pub":"민속원","y":"2020","isbn":"9788928513932","isbns":["9788928513932"],"cv":"https://image.yes24.com/goods/86667300/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788928513932.jpg","f":"역사·지리","n":"한국","e":"미상","l":"보통","pg":"526","ot":"","intro":"중국인들은 누구이고, 무슨 생각을 하며, 어떤 미래를 만들어가려 하는지에 대한 대답을 중국 역사 속에서 찾을 수 있다\n\n이 책은 총 15장으로 중국 고대문명에서 중국의 현대 동향까지 정치적 흐름을 설명하면서 당시의 사회와 문화에 대해서도 소개하고 있어 중국사와 중국학 강의 교재로 활용할 수 있다. 또한 중국의 역사와 문화를 이해하고자 하는 일반 독자에게도 부담 없이 재미있게 읽을 수 있는 대중적인 교양서가 될 것이다. 그동안 한국의 학생들이나 독자들이 어렵게 생각했던 중국사를 쉽고도 재미있게 이해할 수 있도록 저술했다. 물론 모든 역사적 사실을 두루 자세하게 거론하고 있다고 할 수는 없지만, 중국사의 큰 흐름을 파악하면서 각 시대의 특색을 이해할 수 있도록 소개했다. 이 책을 통해 중국과 중국인의 진면목을 만나고, 우리 사회가 그들과 어떻게 관계를 맺어야할지 생각하는 계기가 되기를 기대한다.","icut":false,"toc":"머리말\n중국 역대 왕조표\n중국인의 역사인식\n중국에 대한 공간·시간·인간개념\n제1장\n중국의 자연환경과 민족\n1. 중국의 국토\n2. 중국의 자연자원\n3. 중국의 행정구역\n4. 다양한 민족구성\n5. 중국 민족성의 특징\n제2장\n중국문명의 기원과 신화시대\n1. 중국 원시인류의 기원\n2. 황하문명-앙소문화·용산문화\n3. 신화의 세계와 하왕조의 실재\n제3장\n은·주시대의 사회와 문화\n1. 은왕조의 흥망\n2. 은허와 갑골문\n3. 은왕조의 국가 기구와 사회 경제\n4. 주나라의 봉건 제도·종법 제도\n5. 서주의 경제활동\n6. 제후의 강성과 서주의 멸망\n7. 은·주대 문화의 발달\n제4장\n춘추 전국시대의 사회와 군웅의 각축\n1. 춘추전국시대의 특징\n2. 전국각국의 변법\n3. 춘추전국시대의 사회와 경제 변화\n4. 춘추전국시대의 학술과 문화\n5. 춘추전국시대 제자백가의 주요 사상과 내용\n제5장\n진시황의 천하통일\n1. 중국을 최초로 통일한 진시황\n2. 황제 제도와 중앙집권체제의 수립\n3. 진시황이 이룩한 최대의 업적\n4. 2세 황제 호해와 조고의 전횡\n5. 진승과 오광의 난\n6. 항우와 유방의 최후결전\n제6장\n한漢의 통일과 중앙집권체제의 구축\n1. 한대 초기의 국가조직과 정책\n2. 한무제시대의 빛과 그림자\n3. 실크로드의 개통\n4. 왕망정권의 등장과 좌절\n5. 후한의 건국과 정치적 전개\n6. 후한 말 외척과 환관의 권력투쟁\n7. 한대의 생활과 문화\n제7장\n위진남북조시대 다양한 문화의 융합\n1. 삼국의 분열과 서진의 통일\n2. 5호 16국 시대\n3. 강남의 실력자 귀족\n4. 북위의 화북통일과 한화정책\n5. 분열과 항쟁을 지나 다시 통일의 시대로\n6. 위진남북조의 사상과 문화\n제8장\n수·당시대, 동아시아 문화권의 형성\n1. 수나라, 중원을 다시 통일하다\n2. 당의 건국과 발전\n3. 당태종, 정관의 치\n4. 100만 인구의 세계 최대 도시 장안\n5. 중국 최초의 여황제 측천무후\n6. 세계 예술의 보물창고 돈황\n7. 현종과 양귀비 그리고 당나라의 쇠퇴\n8. 안사의 난과 황소의 난\n9. 당대의 문화\n제9장\n송대의 독재 군주체제와 사대부 서민 사회\n1. 오대십국-‘황소의 난’을 지나 정국은 난세로\n2. 송의 건국 - 문치주의와 군주독제체제의 확립\n3. 귀족사회는 망하고 황제의 권력은 절대화\n4. 송의 수도 개봉과 장안의 차이점\n5. 송의 문치주의로 요·서하·금이 일어서다\n6. 북송의 개혁가 왕안석의 신법\n7. 사마광의 자치통감\n8. 남송의 건국과 멸망\n9. 상업도시의 발달과 서민 문화의 대두\n제10장\n원나라의 중국지배\n1. 초원의 폭풍 칭기즈칸\n2. 약탈자에서 지배자로\n3. 원의 침입과 고려, 일본, 베트남\n4. 원나라에 널리 퍼진 티베트 불교와 기독교\n5. 원대의 사회와 경제\n6. 동서 교류의 확대\n7. 원대 서민문화의 발달\n제11장\n명나라의 흥망성쇠\n1. 한족, 다시 중국대륙의 주인으로\n2. 천하의 영웅 영락제\n3. 일곱 번에 걸친 정화의 대 원정\n4. 명나라 300년을 지탱한 경제 발전\n5. 운하와 만리장성의 대 보수 공사\n6. 명나라의 대외문제\n7. 내부에서 붕괴되기 시작하는 중화제국\n8. 장거정의 개혁과 이자성의 난\n9. 양명학의 성립\n10. 명대의 문화\n제12장\n청제국의 건설과 중화 제국\n1. 후금에서 대청제국으로\n2. 청조의 한족 지배\n3. ‘삼번의 난’과 대만의 항거\n4. 위대한 황제 강희제가 취한 정책\n5. 옹정제와 건륭제의 치세\n6. 난숙에서 쇠퇴로 향하는 청 제국\n7. 청의 사회와 경제\n8. 청대의 문화\n제13장\n서구열강의 진출과 무너지는 대청제국\n1. 역사상 가장 부도덕한 전쟁-아편전쟁\n2. 태평천국운동(1851~1864)\n3. 2차 아편전쟁(애로호사건)과 북경조약\n4. 격동의 청나라 말, 서태후의 등장\n5. 양무운동의 추진(1860~1894)\n6. 변법자강운동\n7. 청나라의 멸망\n제14장\n중화민국의 고뇌\n1. 신해혁명의 발발과 중화민국의 성립\n2. 군벌시대\n3. 민족해방투쟁의 불을 당긴 ‘5·4 운동’\n4. 국민당과 공산당\n5. 국민혁명군의 북벌, 공산당의 대장정\n6. 항일 민족 통일 전선과 제2차 국·공 합작\n7. 8년의 항전과 국·공 내전\n제15장\n중화인민 공화국의 빛과 그림자\n1. 중화인민공화국의 수립, 국민당정부는 대만으로 이주\n2. 중·소 우호동맹과 미·소 냉전시대\n3. 중국의 한국전쟁 참전\n4. 주은래의 외교수완과 국제관계\n5. 모택동의 ‘대약진운동’이 실패한 이유\n6. 문화대혁명이 중국역사에 남긴 폐해\n7. 사인방 시대가 중국에 남긴 상처\n8. 등소평의 개혁개방 정책\n9. 중국에 남겨진 과제\n참고문헌\n찾아보기","recs":[["sejong","2020"]],"shorts":["세종도서"],"univ":[],"au":{},"eb":[],"full":{},"rel":[],"star":10,"y24":"https://www.yes24.com/product/goods/86667300","daum":"https://search.daum.net/search?w=bookpage&bookId=5221548&q=%ED%95%9C%EA%B5%AD%EC%9D%B8%EC%9D%B4+%EC%A2%8B%EC%95%84%ED%95%98%EB%8A%94+%EC%A4%91%EA%B5%AD%EC%82%AC","links":{"google":"https://www.google.com/search?q=%22%ED%95%9C%EA%B5%AD%EC%9D%B8%EC%9D%B4%20%EC%A2%8B%EC%95%84%ED%95%98%EB%8A%94%20%EC%A4%91%EA%B5%AD%EC%82%AC%22%20%EA%B5%AC%EC%84%B1%ED%9D%AC","lib":"https://www.data4library.kr/srch?srchText=9788928513932","millie":"https://www.millie.co.kr/v3/search/result/%ED%95%9C%EA%B5%AD%EC%9D%B8%EC%9D%B4%20%EC%A2%8B%EC%95%84%ED%95%98%EB%8A%94%20%EC%A4%91%EA%B5%AD%EC%82%AC","ridi":"https://ridibooks.com/search?q=%ED%95%9C%EA%B5%AD%EC%9D%B8%EC%9D%B4%20%EC%A2%8B%EC%95%84%ED%95%98%EB%8A%94%20%EC%A4%91%EA%B5%AD%EC%82%AC","welaaa":"https://www.welaaa.com/search?keyword=%ED%95%9C%EA%B5%AD%EC%9D%B8%EC%9D%B4%20%EC%A2%8B%EC%95%84%ED%95%98%EB%8A%94%20%EC%A4%91%EA%B5%AD%EC%82%AC","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788928513932","yes24":"https://www.yes24.com/product/search?query=9788928513932","elib":"https://www.google.com/search?q=%ED%95%9C%EA%B5%AD%EC%9D%B8%EC%9D%B4%20%EC%A2%8B%EC%95%84%ED%95%98%EB%8A%94%20%EC%A4%91%EA%B5%AD%EC%82%AC%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfa3408644":{"id":"bfa3408644","t":"공룡알 화석의 비밀","a":"장순근","tr":[],"pub":"지성사","y":"2019","isbn":"9788978894111","isbns":["9788978894111"],"cv":"https://image.yes24.com/goods/69617051/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788978894111.jpg","f":"언어·교양","n":"한국","e":"미상","l":"쉽게","pg":"184","ot":"","intro":"1억 6천만 년 동안 지구를 지배한 극강의 생물, 공룡. 공룡은 놀랍게도 악어나 거북, 새처럼 알에서 깨어 나왔다. 한때 공룡은 알을 낳기만 하고 돌보지는 않았던 것으로 알려져 있었다. 하지만 시간이 지나면서 그런 생각은 크게 바뀌었다. 결정적인 공룡의 둥지 화석이 발견되었기 때문이다. 어떤 공룡은 적으로부터의 위험이 없는, 부드럽고 물이 잘 빠지는 땅을 찾아 알을 낳고 새끼가 어느 정도 자랄 때까지 보살펴 주었다.  『공룡알 화석의 비밀』은 각","icut":true,"toc":"들어가는 말\n공룡알 화석의 비밀을 찾아서\n1장 공룡은 알을 낳았어!\n1 공룡알의 모습은\n[둥지 탐정의 비밀 수첩] 공룡 알 화석은 누가 처음 발견했을까?\n2 공룡알과 새알은\n[둥지 탐정의 비밀 수첩] ‘알 도둑’ 오비랍토르는 사실은 ‘알을 지키던 어미’였다!\n3 알의 모든 것\n4 동물은 어떻게 늘어날까?\n[둥지 탐정의 비밀 수첩] 실러캔스의 비밀\n[둥지 탐정의 비밀 수첩] 공룡은 악어와 달라!\n2장 공룡은 둥지를 지었어!\n1 경기도 화성군 시화호의 둥지 화석은\n2 경상남도 통영시 따박섬의 둥지 화석은\n[둥지 탐정의 비밀 수첩] 공룡이 알을 낳는 방식은?\n3 전라남도 신안군 압해도의 둥지 화석은\n[둥지 탐정의 비밀 수첩] 중생대의 우리나라 남쪽 지방을 상상하면\n3장 공룡은 알을 품었어!\n1 알과 어미의 뼈가 함께 있어: 내몽골\n[둥지 탐정의 비밀 수첩] 모래 폭풍이 부는 광경은\n[둥지 탐정의 비밀 수첩] 공룡이 살았던 곳은\n2 알과 어미의 뼈가 함께 있어: 고비사막\n[둥지 탐정의 비밀 수첩] 깃털의 구조와 성분은\n[둥지 탐정의 비밀 수첩] 고비사막은 공룡 화석의 보물 창고!\n4장 새끼 공룡이 알에서 깨어 나왔어!\n1 몇몇 공룡의 어미와 새끼는\n[둥지 탐정의 비밀 수첩] 암수의 모양이 같은 새는\n2 알에서 깨어 나오는 새끼 공룡들\n[둥지 탐정의 비밀 수첩] 알니로 알껍데기를 깨고\n3 새끼 공룡이 클 때\n[둥지 탐정의 비밀 수첩] 뼈의 비밀\n[둥지 탐정의 비밀 수첩] 호너 박사의 추정\n[둥지 탐정의 비밀 수첩] 초식 공룡이 무리를 이룬 이유는\n5장 깨어 나오지 못한 새끼 공룡도 있어!\n1 발견된 태아 화석들은\n[둥지 탐정의 비밀 수첩] 태아의 화석을 살리기도\n[둥지 탐정의 비밀 수첩] 벨로키랍토르는\n2 태아 화석의 특징과 가치는\n[둥지 탐정의 비밀 수첩] 태아 화석은 아주 드물어\n[둥지 탐정의 비밀 수첩] 생물은 발달한다!\n6장 실력 있는 공룡 둥지 화석 탐정이 되려면\n1 공룡을 좋아하고 호기심이 있어야\n2 대자연을 좋아해야\n3 둥지 화석과 그 부근을 잘 보고 기록해야\n4 상상력과 창의력을 발휘해야\n5 도와주는 사람이 있어야\n[둥지 탐정의 비밀 수첩] 아직도 모르는 게 많아!\n용어 풀이\n찾아보기\n사진 출처","recs":[["sejong","2019"]],"shorts":["세종도서"],"univ":[],"au":{},"eb":[],"full":{},"rel":[],"star":9.9,"y24":"https://www.yes24.com/product/goods/69617051","daum":"https://search.daum.net/search?w=bookpage&bookId=4879367&q=%EA%B3%B5%EB%A3%A1%EC%95%8C+%ED%99%94%EC%84%9D%EC%9D%98+%EB%B9%84%EB%B0%80","links":{"google":"https://www.google.com/search?q=%22%EA%B3%B5%EB%A3%A1%EC%95%8C%20%ED%99%94%EC%84%9D%EC%9D%98%20%EB%B9%84%EB%B0%80%22%20%EC%9E%A5%EC%88%9C%EA%B7%BC","lib":"https://www.data4library.kr/srch?srchText=9788978894111","millie":"https://www.millie.co.kr/v3/search/result/%EA%B3%B5%EB%A3%A1%EC%95%8C%20%ED%99%94%EC%84%9D%EC%9D%98%20%EB%B9%84%EB%B0%80","ridi":"https://ridibooks.com/search?q=%EA%B3%B5%EB%A3%A1%EC%95%8C%20%ED%99%94%EC%84%9D%EC%9D%98%20%EB%B9%84%EB%B0%80","welaaa":"https://www.welaaa.com/search?keyword=%EA%B3%B5%EB%A3%A1%EC%95%8C%20%ED%99%94%EC%84%9D%EC%9D%98%20%EB%B9%84%EB%B0%80","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788978894111","yes24":"https://www.yes24.com/product/search?query=9788978894111","elib":"https://www.google.com/search?q=%EA%B3%B5%EB%A3%A1%EC%95%8C%20%ED%99%94%EC%84%9D%EC%9D%98%20%EB%B9%84%EB%B0%80%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfabda7538":{"id":"bfabda7538","t":"내 멋대로 혁명","a":"서화교","tr":[],"pub":"낮은산","y":"2017","isbn":"9791155250877","isbns":["9791155250877"],"cv":"https://image.yes24.com/goods/49867003/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9791155250877.jpg","f":"언어·교양","n":"한국","e":"미상","l":"쉽게","pg":"204","ot":"","intro":"나도 혁명하기로 했다. 내 멋대로 즐거운 혁명이다. 낮은산 청소년문학 키큰나무 시리즈 15권 『내 멋대로 혁명』은 내 멋대로 혁명을 시작하기로 한 열네 살 우연이의 씩씩한 성장을 담은 이야기다. 서화교 작가는 『유령 놀이』『굿 파이트』 등의 작품을 통해 어두운 현실에서도 세상을 똑바로 보고 스스로 살아갈 힘을 키워 가는 용감한 아이들의 이야기를 선보여 왔다. 이번 작품에서는 개성 있고 유쾌한 여성 캐릭터들이 만들어 가는 따뜻한 연대와 그 속에서 마음이 훌쩍 큰 우연이의 이야기를 그려 냈다. 시시하고 비겁한 어른이 되지 않기 위해 ‘혁명’의 순간을 만들어 가는 용감한 아이들의 이야기는 아직 크고 있는 청소년뿐 아니라, 여전히 크지 못한 어른들에게도 큰 울림을 전해 줄 것이다.","icut":false,"toc":"1. 아빠를 만나야 한다\n2. 용감한 엄마랑 사는 일\n3. 9회 말 투아웃의 기적\n4. 우리 아가가 고생이 많구먼\n5. 해야 할 일은 하고 살자\n6. 선샤인 게스트하우스\n7. 질문에 답할 사람은 아빠다\n8. 오래오래 행복하게\n9. 두 번째 소원\n10. 엄마가 엄마 같지 않아\n11. 울고 싶을 때는 울어\n12. 미안한 거는 미안하다고 하고\n13. 우리는 모두 같은 휴먼\n14. 사람한테 반하는 순간\n15. 힘들었지만, 그래도 행복했어\n16. 즐거운 혁명","recs":[["sejong","2018"]],"shorts":["세종도서"],"univ":[],"au":{},"eb":[["YES24 eBook","https://www.yes24.com/product/goods/60717896"]],"full":{},"rel":[],"star":8,"y24":"https://www.yes24.com/product/goods/49867003","daum":"https://search.daum.net/search?w=bookpage&bookId=1548250&q=%EB%82%B4+%EB%A9%8B%EB%8C%80%EB%A1%9C+%ED%98%81%EB%AA%85%28%EB%82%AE%EC%9D%80%EC%82%B0+%ED%82%A4%ED%81%B0%EB%82%98%EB%AC%B4+15%29","links":{"google":"https://www.google.com/search?q=%22%EB%82%B4%20%EB%A9%8B%EB%8C%80%EB%A1%9C%20%ED%98%81%EB%AA%85%22%20%EC%84%9C%ED%99%94%EA%B5%90","lib":"https://www.data4library.kr/srch?srchText=9791155250877","millie":"https://www.millie.co.kr/v3/search/result/%EB%82%B4%20%EB%A9%8B%EB%8C%80%EB%A1%9C%20%ED%98%81%EB%AA%85","ridi":"https://ridibooks.com/search?q=%EB%82%B4%20%EB%A9%8B%EB%8C%80%EB%A1%9C%20%ED%98%81%EB%AA%85","welaaa":"https://www.welaaa.com/search?keyword=%EB%82%B4%20%EB%A9%8B%EB%8C%80%EB%A1%9C%20%ED%98%81%EB%AA%85","kyobo":"https://search.kyobobook.co.kr/search?keyword=9791155250877","yes24":"https://www.yes24.com/product/search?query=9791155250877","elib":"https://www.google.com/search?q=%EB%82%B4%20%EB%A9%8B%EB%8C%80%EB%A1%9C%20%ED%98%81%EB%AA%85%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfa5a483c8":{"id":"bfa5a483c8","t":"지구촌 음악과 놀다","a":"김선호","tr":[],"pub":"여행마인드","y":"2015","isbn":"9788988125373","isbns":["9788988125373"],"cv":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788988125373.jpg","cv2":"https://search1.kakaocdn.net/thumb/R120x174.q85/?fname=http%3A%2F%2Ft1.daumcdn.net%2Flbook%2Fimage%2F1271215%3Ftimestamp%3D20251016110420","f":"예술","n":"한국","e":"현대","l":"쉽게","pg":"","ot":"","intro":"『지구촌 음악과 놀다』는 지구촌 음악의 다양성을 다각도로 들여다보고 있다. 책장을 넘기다 보면 흥미진진한 지구촌 음악의 다양하고 심오한 에피소드 이야기 속으로 흠뻑 빠져들게 된다. 유럽 대륙은 물론 아프리카·북아메리카·중남미·중동 음악과 중국 음악, 호주의 원주민 음악에 이르기까지 다양한 지구촌의 음악을 유명 가수의 이야기를 중심으로 역사·문화적으로 깊이 있게 파헤치고 있다.","icut":true,"toc":"","recs":[["sejong","2016"]],"shorts":["세종도서"],"univ":[],"au":{"b":1986,"kw":"김선호 (배우)","en":"Kim Seon-ho"},"eb":[],"full":{},"rel":[],"star":null,"y24":"","daum":"https://search.daum.net/search?w=bookpage&bookId=1271215&q=%EC%A7%80%EA%B5%AC%EC%B4%8C+%EC%9D%8C%EC%95%85%EA%B3%BC+%EB%86%80%EB%8B%A4","links":{"google":"https://www.google.com/search?q=%22%EC%A7%80%EA%B5%AC%EC%B4%8C%20%EC%9D%8C%EC%95%85%EA%B3%BC%20%EB%86%80%EB%8B%A4%22%20%EA%B9%80%EC%84%A0%ED%98%B8","lib":"https://www.data4library.kr/srch?srchText=9788988125373","millie":"https://www.millie.co.kr/v3/search/result/%EC%A7%80%EA%B5%AC%EC%B4%8C%20%EC%9D%8C%EC%95%85%EA%B3%BC%20%EB%86%80%EB%8B%A4","ridi":"https://ridibooks.com/search?q=%EC%A7%80%EA%B5%AC%EC%B4%8C%20%EC%9D%8C%EC%95%85%EA%B3%BC%20%EB%86%80%EB%8B%A4","welaaa":"https://www.welaaa.com/search?keyword=%EC%A7%80%EA%B5%AC%EC%B4%8C%20%EC%9D%8C%EC%95%85%EA%B3%BC%20%EB%86%80%EB%8B%A4","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788988125373","yes24":"https://www.yes24.com/product/search?query=9788988125373","elib":"https://www.google.com/search?q=%EC%A7%80%EA%B5%AC%EC%B4%8C%20%EC%9D%8C%EC%95%85%EA%B3%BC%20%EB%86%80%EB%8B%A4%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfa869e773":{"id":"bfa869e773","t":"이야기 케이크","a":"정혜원","tr":[],"pub":"미학사","y":"2015","isbn":"9788989010876","isbns":["9788989010876"],"cv":"https://image.yes24.com/goods/17188984/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788989010876.jpg","f":"언어·교양","n":"한국","e":"현대","l":"쉽게","pg":"241","ot":"","intro":"어린이 여러분! 여러분은 헤리포터의 작가 조엔롤링이 어떻게 세계적인 작가가 되었는지 궁금하지 않으세요? 위대한 작가들이 첫 작품은 어떤 것이었는지 궁금하지 않으세요? 이 책은 미래의 위대한 작가들이 처음으로 만들어 어린이 여러분에게 선물하는 세상에서 가장 따뜻한 동화『이야기 케이크』입니다.","icut":true,"toc":"책 머리에\n〈이야기 케이크〉를 엮으며\n세상에서 가장 아름다운 선물\n동화\n쉿, 안 되요\n그림자와 나\n고양이 발바닥\n내 눈은 현미경\n나무 구멍 안으로 와!\n네가 있어 참 다행이야\n조금 특별한 새 가족\n빼곡빼곡 나이테가 갖고 싶어요\n행운이 적립되었습니다\n종이비행기를 타고 너에게 간 날\n진우사에서만 맛볼 수 있는 도너츠\n아마도 우리는\n너의 목소리\n지지않는 벚꽃\n평론\n열네 편 이야기들의 향연","recs":[["sejong","2015"]],"shorts":["세종도서"],"univ":[],"au":{"b":1984,"kw":"정혜원","en":"Jung Hyewon"},"eb":[],"full":{},"rel":[],"star":0,"y24":"https://www.yes24.com/product/goods/17188984","daum":"https://search.daum.net/search?w=bookpage&bookId=1290700&q=%EC%9D%B4%EC%95%BC%EA%B8%B0+%EC%BC%80%EC%9D%B4%ED%81%AC","links":{"google":"https://www.google.com/search?q=%22%EC%9D%B4%EC%95%BC%EA%B8%B0%20%EC%BC%80%EC%9D%B4%ED%81%AC%22%20%EC%A0%95%ED%98%9C%EC%9B%90","lib":"https://www.data4library.kr/srch?srchText=9788989010876","millie":"https://www.millie.co.kr/v3/search/result/%EC%9D%B4%EC%95%BC%EA%B8%B0%20%EC%BC%80%EC%9D%B4%ED%81%AC","ridi":"https://ridibooks.com/search?q=%EC%9D%B4%EC%95%BC%EA%B8%B0%20%EC%BC%80%EC%9D%B4%ED%81%AC","welaaa":"https://www.welaaa.com/search?keyword=%EC%9D%B4%EC%95%BC%EA%B8%B0%20%EC%BC%80%EC%9D%B4%ED%81%AC","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788989010876","yes24":"https://www.yes24.com/product/search?query=9788989010876","elib":"https://www.google.com/search?q=%EC%9D%B4%EC%95%BC%EA%B8%B0%20%EC%BC%80%EC%9D%B4%ED%81%AC%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfa320d16b":{"id":"bfa320d16b","t":"대단한 소금이야","a":"신연호","tr":[],"pub":"현암사","y":"2012","isbn":"9788932373379","isbns":["9788932373379"],"cv":"https://image.yes24.com/goods/8108917/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788932373379.jpg","f":"언어·교양","n":"한국","e":"현대","l":"쉽게","pg":"115","ot":"","intro":"소금과 관련된 과학적 사실과 함께 화폐로 쓰여 경제를 움직였다는 등 짭짤한 상식을 풍부하게 담고 있습니다. 소금 속에 우주의 역사, 생명의 신비뿐 아니라, 세계인의 눈물과 한숨, 그리고 간절한 소망까지 녹아 있음을 밝혀줍니다. 특히 인체에서의 소금의 기능과 역할 등에 대해 과학적으로 설명하고 있습니다. 우리 생활에 꼭 필요한 소금을 건강하게 사용하는 방법을 배우게 된답니다.","icut":false,"toc":"머리말\n1 소금은 힘이 세다\n- 소금으로 일어선 나라\n- 황금과 맞바꾼 소금\n- 소금의 주인은 누구일까?\n- 못 참겠다, 무거운 소금세\n2 자연이 준 선물, 소금\n- 소금이 없으면 못 살아\n- 소금은 어디에나 있다\n- 산업의 밑거름이 된 소금\n3 문화를 꽃피운 소금\n- 소금이 실어 나른 문화\n- 소금아 재미있는 이야기를 들어줘\n- 악마와 귀신은 소금을 무서워해\n- 맛과 영양을 완성한 소금\n- 우리나라 소금의 역사\n참고한 자료","recs":[["sejong","2013"]],"shorts":["세종도서"],"univ":[],"au":{"b":1964,"kw":"신연호","en":"Shin Yon-ho"},"eb":[],"full":{},"rel":[],"star":10,"y24":"https://www.yes24.com/product/goods/8108917","daum":"https://search.daum.net/search?w=bookpage&bookId=501067&q=%EB%8C%80%EB%8B%A8%ED%95%9C+%EC%86%8C%EA%B8%88%EC%9D%B4%EC%95%BC%28%EC%84%B8%EB%AA%A8+%EC%A7%80%EC%8B%9D+%EB%B0%95%EB%AC%BC%EA%B4%80+5%29%28%EB%B0%98%EC%96%91%EC%9E%A5%29","links":{"google":"https://www.google.com/search?q=%22%EB%8C%80%EB%8B%A8%ED%95%9C%20%EC%86%8C%EA%B8%88%EC%9D%B4%EC%95%BC%22%20%EC%8B%A0%EC%97%B0%ED%98%B8","lib":"https://www.data4library.kr/srch?srchText=9788932373379","millie":"https://www.millie.co.kr/v3/search/result/%EB%8C%80%EB%8B%A8%ED%95%9C%20%EC%86%8C%EA%B8%88%EC%9D%B4%EC%95%BC","ridi":"https://ridibooks.com/search?q=%EB%8C%80%EB%8B%A8%ED%95%9C%20%EC%86%8C%EA%B8%88%EC%9D%B4%EC%95%BC","welaaa":"https://www.welaaa.com/search?keyword=%EB%8C%80%EB%8B%A8%ED%95%9C%20%EC%86%8C%EA%B8%88%EC%9D%B4%EC%95%BC","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788932373379","yes24":"https://www.yes24.com/product/search?query=9788932373379","elib":"https://www.google.com/search?q=%EB%8C%80%EB%8B%A8%ED%95%9C%20%EC%86%8C%EA%B8%88%EC%9D%B4%EC%95%BC%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfa6897037":{"id":"bfa6897037","t":"겁쟁이 늑대 칸","a":"임정진","tr":[],"pub":"뜨인돌어린이","y":"2013","isbn":"9788958074403","isbns":["9788958074403"],"cv":"https://image.yes24.com/goods/9176390/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788958074403.jpg","f":"언어·교양","n":"한국","e":"미상","l":"쉽게","pg":"88","ot":"","intro":"현대 사회에는 몸이 불편한 지체장애 말고도 경쟁 사회에서 발생하는 심리나 정서장애가 늘고 있습니다. 해마다 늘어나는 아이들의 정서장애는 이제 사회 문제가 되어 버릴 정도이지요. 이런 시점에서 푸르메 놀이터는 정신적, 심리적 상처도 보듬는 다양한 내용과 장애에 대한 새로운 시각을 담은 그림책으로 아이의 아픈 곳을 어루만져 줄 수 있는동화책이 될 것입니다.","icut":false,"toc":"","recs":[["sejong","2013"]],"shorts":["세종도서"],"univ":[],"au":{},"eb":[],"full":{},"rel":[],"star":10,"y24":"https://www.yes24.com/product/goods/9176390","daum":"https://search.daum.net/search?w=bookpage&bookId=772010&q=%EA%B2%81%EC%9F%81%EC%9D%B4+%EB%8A%91%EB%8C%80+%EC%B9%B8%28%ED%91%B8%EB%A5%B4%EB%A9%94%EB%86%80%EC%9D%B4%ED%84%B0+2%29","links":{"google":"https://www.google.com/search?q=%22%EA%B2%81%EC%9F%81%EC%9D%B4%20%EB%8A%91%EB%8C%80%20%EC%B9%B8%22%20%EC%9E%84%EC%A0%95%EC%A7%84","lib":"https://www.data4library.kr/srch?srchText=9788958074403","millie":"https://www.millie.co.kr/v3/search/result/%EA%B2%81%EC%9F%81%EC%9D%B4%20%EB%8A%91%EB%8C%80%20%EC%B9%B8","ridi":"https://ridibooks.com/search?q=%EA%B2%81%EC%9F%81%EC%9D%B4%20%EB%8A%91%EB%8C%80%20%EC%B9%B8","welaaa":"https://www.welaaa.com/search?keyword=%EA%B2%81%EC%9F%81%EC%9D%B4%20%EB%8A%91%EB%8C%80%20%EC%B9%B8","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788958074403","yes24":"https://www.yes24.com/product/search?query=9788958074403","elib":"https://www.google.com/search?q=%EA%B2%81%EC%9F%81%EC%9D%B4%20%EB%8A%91%EB%8C%80%20%EC%B9%B8%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfaf16675b":{"id":"bfaf16675b","t":"우글 와글 미생물을 찾아봐","a":"최향숙","tr":[],"pub":"대교출판","y":"2008","isbn":"9788939522701","isbns":["9788939522701"],"cv":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788939522701.jpg","cv2":"https://search1.kakaocdn.net/thumb/R120x174.q85/?fname=http%3A%2F%2Ft1.daumcdn.net%2Flbook%2Fimage%2F557008%3Ftimestamp%3D20220728203205","f":"언어·교양","n":"한국","e":"미상","l":"쉽게","pg":"","ot":"","intro":"우리 몸속에는 미생물이 참 많습니다. '비피더스'와 '유산균'이라는 몸에 좋은 미생물도 있고, '살모넬라', '무탄스균'과 같은 몸에 나쁜 미생물도 있지요. 『우글 와글 미생물을 찾아봐』는 우리 몸 속에 있는 미생물의 세계를 자세한 그림과 흥미진진한 동화로 쉽게 설명합니다.  어느 날 동생 혜민이가 배가 아프다며 토하고 설사를 합니다. 우성이는 자기 간식까지 뺏어먹던 혜민이가 아픈게 고소하지만 점점 걱정이 됩니다. 그런데 어디선가 갑자기 '젬'이라는","icut":true,"toc":"","recs":[["sejong","2009"]],"shorts":["세종도서"],"univ":[],"au":{},"eb":[],"full":{},"rel":[],"star":null,"y24":"","daum":"https://search.daum.net/search?w=bookpage&bookId=557008&q=%EC%9A%B0%EA%B8%80+%EC%99%80%EA%B8%80+%EB%AF%B8%EC%83%9D%EB%AC%BC%EC%9D%84+%EC%B0%BE%EC%95%84%EB%B4%90%28%EC%96%91%EC%9E%A5%EB%B3%B8+Hardcover%29","links":{"google":"https://www.google.com/search?q=%22%EC%9A%B0%EA%B8%80%20%EC%99%80%EA%B8%80%20%EB%AF%B8%EC%83%9D%EB%AC%BC%EC%9D%84%20%EC%B0%BE%EC%95%84%EB%B4%90%22%20%EC%B5%9C%ED%96%A5%EC%88%99","lib":"https://www.data4library.kr/srch?srchText=9788939522701","millie":"https://www.millie.co.kr/v3/search/result/%EC%9A%B0%EA%B8%80%20%EC%99%80%EA%B8%80%20%EB%AF%B8%EC%83%9D%EB%AC%BC%EC%9D%84%20%EC%B0%BE%EC%95%84%EB%B4%90","ridi":"https://ridibooks.com/search?q=%EC%9A%B0%EA%B8%80%20%EC%99%80%EA%B8%80%20%EB%AF%B8%EC%83%9D%EB%AC%BC%EC%9D%84%20%EC%B0%BE%EC%95%84%EB%B4%90","welaaa":"https://www.welaaa.com/search?keyword=%EC%9A%B0%EA%B8%80%20%EC%99%80%EA%B8%80%20%EB%AF%B8%EC%83%9D%EB%AC%BC%EC%9D%84%20%EC%B0%BE%EC%95%84%EB%B4%90","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788939522701","yes24":"https://www.yes24.com/product/search?query=9788939522701","elib":"https://www.google.com/search?q=%EC%9A%B0%EA%B8%80%20%EC%99%80%EA%B8%80%20%EB%AF%B8%EC%83%9D%EB%AC%BC%EC%9D%84%20%EC%B0%BE%EC%95%84%EB%B4%90%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfa5d6879e":{"id":"bfa5d6879e","t":"나는 도시에 산다","a":"박훈하","tr":[],"pub":"비온후","y":"2009","isbn":"9788990969347","isbns":["9788990969347"],"cv":"https://image.yes24.com/goods/2988822/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788990969347.jpg","f":"기술·의학","n":"한국","e":"미상","l":"쉽게","pg":"191","ot":"","intro":"도시를 바라보는 방법상의 일치를 최종적인 목표로 삼아 글과 사진이 상호간의 길항이 최대한 보장되도록 기획된 책이다. 이 책은 글과 사진이라는 두 예술매체가 가장 민주적으로 만나 어우러질 진정한 공저로서 기획되었다. 또한 이 책의 글들은 작은 이야기로 구성되어 있고, 그 대상은 부산이라는 지역이다. 저자가 부산에 시선을 집중한 보다 근본적인 이유는 무엇보다도 우리의 급속한 근대화로부터 탈근대사회로 진입하고 있는 지금까지 부산이 갖는 독특한 위상때문이다.","icut":false,"toc":"머리글\n지워지고 남은 현재들\n꽃에 무관심하기\n다리모시와 계\n매화 꽃잎을 띄우다\n속도와 윤리\n안방과 침실 사이\n장산의 울음소리\n웰빙의 허구성\n위대한 작은 것들\n거울과 휴대 전화\n육아일기\n익숙한 것들과의 결별\n지겨워, 맛있는 건\n멀리 있는 아이야!\n내셔널 지오그래픽을 보는 법\n결핍으로부터 배우기\n퀴즈 왕국\n기억의 단층\n이종격투기, 혹은 공룡시대\n세상살이의 그 천박함에 대한 변명\n시간의 옹이, 그 견고한 장소\n내 친구의 집은 어디인가\n「갯마을」로 가는 길\n세계의 끝, 영도다리\n혼종의 공간, 부산 중구\n물만골, 막힌 곳에서 길을 열다\n직선 아래 끊어진 곡선이 욕망, 사상\n콜라주로 만나는 부산의 풍경\n하나같이 똑같은 박물관\n오로지 검은 승용차뿐\n세계화와 가족로망스\n탈주의 형상들\n절망의 미학\n야생화는 꽃은 아니다\n야생화를 바로보는 그릇된 욕망-민족주의\n도심 생태 보고서\n귀신조차 떠나는 이곳\n외부를 꿈구는 인문학\n순정만화의 힘\n비평론 첫 시간, 공포의 생산\n저주의 이름, 예술가\n검어서 슬픈, 제국의 주민들","recs":[["sejong","2008"]],"shorts":["세종도서"],"univ":[],"au":{},"eb":[],"full":{},"rel":[],"star":9.7,"y24":"https://www.yes24.com/product/goods/2988822","daum":"https://search.daum.net/search?w=bookpage&bookId=1330893&q=%EB%82%98%EB%8A%94+%EB%8F%84%EC%8B%9C%EC%97%90+%EC%82%B0%EB%8B%A4%28%EB%B9%84%EC%98%A8%ED%9B%84+%EB%8F%84%EC%8B%9C%EC%9D%B4%EC%95%BC%EA%B8%B0+2%29","links":{"google":"https://www.google.com/search?q=%22%EB%82%98%EB%8A%94%20%EB%8F%84%EC%8B%9C%EC%97%90%20%EC%82%B0%EB%8B%A4%22%20%EB%B0%95%ED%9B%88%ED%95%98","lib":"https://www.data4library.kr/srch?srchText=9788990969347","millie":"https://www.millie.co.kr/v3/search/result/%EB%82%98%EB%8A%94%20%EB%8F%84%EC%8B%9C%EC%97%90%20%EC%82%B0%EB%8B%A4","ridi":"https://ridibooks.com/search?q=%EB%82%98%EB%8A%94%20%EB%8F%84%EC%8B%9C%EC%97%90%20%EC%82%B0%EB%8B%A4","welaaa":"https://www.welaaa.com/search?keyword=%EB%82%98%EB%8A%94%20%EB%8F%84%EC%8B%9C%EC%97%90%20%EC%82%B0%EB%8B%A4","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788990969347","yes24":"https://www.yes24.com/product/search?query=9788990969347","elib":"https://www.google.com/search?q=%EB%82%98%EB%8A%94%20%EB%8F%84%EC%8B%9C%EC%97%90%20%EC%82%B0%EB%8B%A4%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfa17756aa":{"id":"bfa17756aa","t":"없음의 대명사","a":"오은","tr":[],"pub":"문학과지성사","y":"2023","isbn":"9788932041520","isbns":["9788932041520"],"cv":"https://image.yes24.com/goods/118785759/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788932041520.jpg","f":"문학","n":"한국","e":"근세","l":"쉽게","pg":"156","ot":"","intro":"“없음은 있었음을 끊임없이 두드릴 것이다”\n\n‘웃음’과 ‘울음’이 나란히 놓이고\n‘무표정’으로 ‘표정’을 지을 때\n‘없다’와 ‘있었다’ 사이에서 떠오르는 ‘잃었다’의 자리\n\n시인 오은의 여섯번째 시집 『없음의 대명사』가 문학과지성사 시인선 585번째로 출간되었다. 전작 『나는 이름이 있었다』 이후 5년 만에 펴내는 시집이라 반가움이 크다. 오랜만의 새 시집이긴 하지만 그사이 시인은 다양한 앤솔러지와 산문집, 청소년 시집 등을 출간했을 뿐 아니라 2018년 4월부터 2023년 현재까지 온라인 서점 예스24의 도서 팟캐스트 책읽아웃에서 ‘오은의 옹기종기’를 맡아 현재까지 진행해오고 있으니, 읽고 쓰고 그에 대해 나누는 일을 게을리한 적은 없다.\n\n2002년 4월, 스무 살에 시인이 되었다. 올해로 데뷔한 지 20년을 꽉 채우고 21년째에 접어들었다.","icut":false,"toc":"","recs":[["munhak","2023"]],"shorts":["문학나눔"],"univ":[],"au":{"b":1583,"kw":"조창원","en":"Jo Chang-won"},"eb":[],"full":{},"rel":[["h","k726207","조창원"]],"star":9.5,"y24":"https://www.yes24.com/product/goods/118785759","daum":"https://search.daum.net/search?w=bookpage&bookId=6345644&q=%EC%97%86%EC%9D%8C%EC%9D%98+%EB%8C%80%EB%AA%85%EC%82%AC","links":{"google":"https://www.google.com/search?q=%22%EC%97%86%EC%9D%8C%EC%9D%98%20%EB%8C%80%EB%AA%85%EC%82%AC%22%20%EC%98%A4%EC%9D%80","lib":"https://www.data4library.kr/srch?srchText=9788932041520","millie":"https://www.millie.co.kr/v3/search/result/%EC%97%86%EC%9D%8C%EC%9D%98%20%EB%8C%80%EB%AA%85%EC%82%AC","ridi":"https://ridibooks.com/search?q=%EC%97%86%EC%9D%8C%EC%9D%98%20%EB%8C%80%EB%AA%85%EC%82%AC","welaaa":"https://www.welaaa.com/search?keyword=%EC%97%86%EC%9D%8C%EC%9D%98%20%EB%8C%80%EB%AA%85%EC%82%AC","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788932041520","yes24":"https://www.yes24.com/product/search?query=9788932041520","elib":"https://www.google.com/search?q=%EC%97%86%EC%9D%8C%EC%9D%98%20%EB%8C%80%EB%AA%85%EC%82%AC%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfa08df31d":{"id":"bfa08df31d","t":"빛의 이방인","a":"김광섭","tr":[],"pub":"파란","y":"2022","isbn":"9791191897159","isbns":["9791191897159"],"cv":"https://image.yes24.com/goods/107005652/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9791191897159.jpg","f":"문학","n":"한국","e":"현대","l":"쉽게","pg":"123","ot":"","intro":"두 부류의 시인이 있다. 새로운 것을 보여 주기 위해 강박적으로 자신의 스타일을 바꾸는 시인이 있고, 자신의 길을 수없이 변주해 칼을 가는 시인이 있다. 어느 부류가 좋은 시인인지는 확실하지 않으나, 적어도 하나의 길을 갈고닦는 여정은 어떤 시간을 축적하느냐에 따라 승패가 결정된다고 생각한다. 김광섭 시인은 이번 시집 〈빛의 이방인〉에서 심도 있게 한곳을 다듬는 방법을 선택했다. 그리고 이 방법은 자멸해 버린 ‘나’를 소생하는 방식으로 이뤄졌다","icut":true,"toc":"시인의 말\n성 지하 - 9\n살아 있는 나 자신 - 10\n감각 어린이 - 13\n밤을 잃은 낮은 없다 - 15\n씨앗의 얼굴 - 17\n고추꽃 - 20\n언덕에 깃대를 꽂아 - 22\n벌거벗은 피 - 24\n빛의 은유와 피의 상징 - 27\n새 기쁨 - 29\n새 사랑 - 31\n빛의 저수지 - 34\n빛의 절벽 - 35\n너와 나의 새 정의 - 37\n밤하늘에 코코넛 - 40\n미래를 잃은 사람에게 필요한 은총 - 42\n화매천 묘비 - 44\n자녀들 - 45\n신은 내가 되고 싶었던 인간 - 48\n은혜와 평강 - 51\n구원 어린이 - 55\n튤립과 어린이 - 57\n혼자 앓는 푸른빛 - 58\n우리들의 씨앗으로 들판을 불태우자 - 60\n선악산 - 63\n반란과 순장 - 66\n대물림 - 69\n빛이여 어디서 나를 비추고 있어 - 72\n천국 - 75\n아침저녁으로 슬픔을 짓는다 - 77\n네 목에 뿔을 - 78\n분열과 은총 - 79\n한마음 - 84\n거룩성 회복 - 86\n살아 있으라 - 88\n석양 - 92\n새 새벽의 광채 - 93\n우리가 노래했던 은총과 영원 - 95\n비참 - 99\n어린이들 - 100\n송가 - 104\n새 능력 - 106\n새 새싹 - 109\n광야의 합창 - 110\n뿔 위에서 - 111\n해설 문종필 빛의 변주곡 - 112","recs":[["munhak","2022"]],"shorts":["문학나눔"],"univ":[],"au":{"b":1952,"kw":"김광섭 (외교관)","en":"Kim Kwang-sop"},"eb":[],"full":{},"rel":[],"star":0,"y24":"https://www.yes24.com/product/goods/107005652","daum":"https://search.daum.net/search?w=bookpage&bookId=5964349&q=%EB%B9%9B%EC%9D%98+%EC%9D%B4%EB%B0%A9%EC%9D%B8","links":{"google":"https://www.google.com/search?q=%22%EB%B9%9B%EC%9D%98%20%EC%9D%B4%EB%B0%A9%EC%9D%B8%22%20%EA%B9%80%EA%B4%91%EC%84%AD","lib":"https://www.data4library.kr/srch?srchText=9791191897159","millie":"https://www.millie.co.kr/v3/search/result/%EB%B9%9B%EC%9D%98%20%EC%9D%B4%EB%B0%A9%EC%9D%B8","ridi":"https://ridibooks.com/search?q=%EB%B9%9B%EC%9D%98%20%EC%9D%B4%EB%B0%A9%EC%9D%B8","welaaa":"https://www.welaaa.com/search?keyword=%EB%B9%9B%EC%9D%98%20%EC%9D%B4%EB%B0%A9%EC%9D%B8","kyobo":"https://search.kyobobook.co.kr/search?keyword=9791191897159","yes24":"https://www.yes24.com/product/search?query=9791191897159","elib":"https://www.google.com/search?q=%EB%B9%9B%EC%9D%98%20%EC%9D%B4%EB%B0%A9%EC%9D%B8%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfa6b1dd92":{"id":"bfa6b1dd92","t":"깊은 일","a":"안현미","tr":[],"pub":"아시아","y":"2020","isbn":"9791156624486","isbns":["9791156624486"],"cv":"https://image.yes24.com/goods/89940024/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9791156624486.jpg","f":"문학","n":"한국","e":"현대","l":"쉽게","pg":"88","ot":"","intro":"결코 잊힐 수 없는 그 날의 슬픔을 기억하는 일 안현미 신작 시집 『깊은 일』 언제나 머리맡에 두고 읽고 싶은 한국 시의 정수를 소개하는 ‘K-포엣’ 시리즈. 시간이 흘러도 명작으로 손꼽힐 한국 시들을 독자들에게 소개함과 동시에 영문으로 번역하여 전 세계에 알리어 한국문학을 세계문학으로 발돋움시키고 있다. ‘K-포엣’ 시리즈는 삶의 보편적·특수적 문제들에 대한 통찰 또한 놓치지 않고 있다. 이 시들은 영원히 한국문학의 핵심으로서 기억되고 기록될 것이다. ‘K-포엣’ 시리즈 열한 번째는 안현미의 신작 시선집 ‘깊은 일’이다. ‘깊은 일’은 그 제목과 표지의 이미지에서처럼, 몇 해 전에 있었던, 영원히 잊힐 수 없고 잊혀서도 안 되는 ‘세월호 참사’를 중심으로 조망하는 시선집이다. 본문에 실린 스물다섯 편의 시들은 이를 아우르는 동시에 시인으로의 안현미가 살아온 족적과 삶의 형태를 그리고 또한 재생시킨다.","icut":false,"toc":"깊은 일\n세월호못봇\n#Yosoy132\n수학여행 가는 나무\n주문\n생각보다 흰\n생활문화진흥\n마래 터널\n안녕, 노랑\n장미공동체\n사랑의 계단\n무능력의 능력\n희생양\n독거\n변신-서발턴\n태백\n서푼짜리 오페라를 위한 시놉시스\n취객\n안녕, 곰\n둥근 밤\n전신거울\n갱년기\n기향 국수\n꿩\n구름있음\n시인노트\n시인 에세이\n해설\n안현미에 대해","recs":[["munhak","2020"]],"shorts":["문학나눔"],"univ":[],"au":{"b":1972,"kw":"안현미","en":"An Heon-mi"},"eb":[["YES24 eBook","https://www.yes24.com/product/goods/105409273"]],"full":{},"rel":[],"star":9.5,"y24":"https://www.yes24.com/product/goods/89940024","daum":"https://search.daum.net/search?w=bookpage&bookId=5342534&q=%EA%B9%8A%EC%9D%80+%EC%9D%BC","links":{"google":"https://www.google.com/search?q=%22%EA%B9%8A%EC%9D%80%20%EC%9D%BC%22%20%EC%95%88%ED%98%84%EB%AF%B8","lib":"https://www.data4library.kr/srch?srchText=9791156624486","millie":"https://www.millie.co.kr/v3/search/result/%EA%B9%8A%EC%9D%80%20%EC%9D%BC","ridi":"https://ridibooks.com/search?q=%EA%B9%8A%EC%9D%80%20%EC%9D%BC","welaaa":"https://www.welaaa.com/search?keyword=%EA%B9%8A%EC%9D%80%20%EC%9D%BC","kyobo":"https://search.kyobobook.co.kr/search?keyword=9791156624486","yes24":"https://www.yes24.com/product/search?query=9791156624486","elib":"https://www.google.com/search?q=%EA%B9%8A%EC%9D%80%20%EC%9D%BC%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfa1b0ac3a":{"id":"bfa1b0ac3a","t":"생활이라는 생각","a":"이현승","tr":[],"pub":"창비","y":"2021","isbn":"9788936423926","isbns":["9788936423926"],"cv":"https://image.yes24.com/goods/20510693/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788936423926.jpg","f":"문학","n":"한국","e":"현대","l":"쉽게","pg":"136","ot":"","intro":"삶의 가장자리에서 시를 길어올리다\n\n생동하는 몸의 세계를 꿰뚫는 투명하고 냉철한 현상학적 시선과 다채롭고 흥미로운 이미지로 독특한 시세계를 펼쳐온 이현승 시인의 세번째 시집 [생활이라는 생각]이 출간되었다. [친애하는 사물들](문학동네 2012) 이후 3년 만에 새롭게 펴내는 이번 시집은 “몸을 위한, 몸에 의한, 몸의 것일 수밖에 없을 나날의 삶의 육체성이 어떻게 조직되고 통제되는가를 바닥까지 들여다보려는 몸의 헌정서”(이찬, 해설)이다. 사물을 골똘하게 바라보는 날카롭고 지적인 통찰과 예민한 감성이 어우러진 가운데 논리정연하면서도 단정한 시편들이 신선한 공감을 일으키며, 새로운 각도로 일상을 들여다보며 세상의 양면적 속성과 존재의 본질을 파고드는 철학적 사유가 빛나는 위트와 유머 속에 슬픔이 깃든 삶의 아이러니가 돋보인다.","icut":false,"toc":"","recs":[["munhak","2016"]],"shorts":["문학나눔"],"univ":[],"au":{"b":1961,"kw":"이현승 (영화 감독)","en":"Lee Hyeon-seung"},"eb":[["YES24 eBook","https://www.yes24.com/product/goods/176986493"]],"full":{},"rel":[],"star":9.5,"y24":"https://www.yes24.com/product/goods/20510693","daum":"https://search.daum.net/search?w=bookpage&bookId=532195&q=%EC%83%9D%ED%99%9C%EC%9D%B4%EB%9D%BC%EB%8A%94+%EC%83%9D%EA%B0%81","links":{"google":"https://www.google.com/search?q=%22%EC%83%9D%ED%99%9C%EC%9D%B4%EB%9D%BC%EB%8A%94%20%EC%83%9D%EA%B0%81%22%20%EC%9D%B4%ED%98%84%EC%8A%B9","lib":"https://www.data4library.kr/srch?srchText=9788936423926","millie":"https://www.millie.co.kr/v3/search/result/%EC%83%9D%ED%99%9C%EC%9D%B4%EB%9D%BC%EB%8A%94%20%EC%83%9D%EA%B0%81","ridi":"https://ridibooks.com/search?q=%EC%83%9D%ED%99%9C%EC%9D%B4%EB%9D%BC%EB%8A%94%20%EC%83%9D%EA%B0%81","welaaa":"https://www.welaaa.com/search?keyword=%EC%83%9D%ED%99%9C%EC%9D%B4%EB%9D%BC%EB%8A%94%20%EC%83%9D%EA%B0%81","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788936423926","yes24":"https://www.yes24.com/product/search?query=9788936423926","elib":"https://www.google.com/search?q=%EC%83%9D%ED%99%9C%EC%9D%B4%EB%9D%BC%EB%8A%94%20%EC%83%9D%EA%B0%81%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfaaea7be2":{"id":"bfaaea7be2","t":"고향의 소나무","a":"황금찬","tr":[],"pub":"시학","y":"2008","isbn":"9788991914469","isbns":["9788991914469"],"cv":"https://image.yes24.com/goods/3387843/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788991914469.jpg","f":"문학","n":"한국","e":"20세기","l":"쉽게","pg":"311","ot":"","intro":"올해 만 90세를 맞이한 생존 중인 최고 원로 시인이자 오늘날에도 활발히 창작을 전개하고 있는 현역시인 ‘황금찬’. 그는 1947년 이래 『새사람』, 『기독교 가정』으로 시작 활동을 시작한 후, 「보릿고개」, 「촛불」 등 수많은 작품들을 통해 겨레의 상처 받고 그늘진 가슴에 서정적 진실의 따뜻함과 시의 소중함을 일깨워 주었다. 『고향의 소나무』는 시력 60여 년을 재조명해볼 수 있는 작품집으로, 오늘날에도 여전히 겸허한 생활태도로서 삶의 모범을 보여주고 있는 시인의 모습이 고스란히 담겨 있다.","icut":false,"toc":"시인의 말\n제1부 작은 소망\n네 음성\n발소리\n전화\n다뉴브 강\n말하라\n낡은 시집\n늦게 핀 장미\n5월\n가장 먼 것은\n봄날의 기도\n춤을 춘다\n몽골의 하늘\n작은 소망\n하나님의 뜻을 따라\n제2부 물푸레나무\n12개의 별이 뜬 하늘\n복숭아꽃과 달\n내 고향 사람들에게\n우주의 생명은 물이다\n우리들이 심은 연극 예술의 고향\n물푸레나무\n빈방\n여름이 가고 있다\n소나무와 아버지\n강릉 비경의 문 열리다\n시인의 선물\n늙고 병든 손\n편지\n제3부 구름\n그날을 생각하며\n가을이 오고 있다\n20년 만에 찾은 시집\n구름\n소리\n아침\n꽃\n만년필\n가고 싶던 곳\n매화나무집\n새벽 바다\n하루\n제4부 사랑하면 닮는다\n겨울 바다\n눈 내리는 소리\n물\n생명\n꿈이 있어라\n영원하라 송파\n물리학자의 말\n추상의 그림\n사랑하면 닮는다\n운명론\n변신한다\n제5부 한강\n한강·1\n한강·2\n한강·3\n한강·4\n한강·5","recs":[["munhak","2008"]],"shorts":["문학나눔"],"univ":[],"au":{"b":1918,"d":2017,"kw":"황금찬","en":"Hwang Geumchan"},"eb":[],"full":{},"rel":[["h","k948355","황금찬"]],"star":0,"y24":"https://www.yes24.com/product/goods/3387843","daum":"https://search.daum.net/search?w=bookpage&bookId=1364796&q=%EA%B3%A0%ED%96%A5%EC%9D%98+%EC%86%8C%EB%82%98%EB%AC%B4","links":{"google":"https://www.google.com/search?q=%22%EA%B3%A0%ED%96%A5%EC%9D%98%20%EC%86%8C%EB%82%98%EB%AC%B4%22%20%ED%99%A9%EA%B8%88%EC%B0%AC","lib":"https://www.data4library.kr/srch?srchText=9788991914469","millie":"https://www.millie.co.kr/v3/search/result/%EA%B3%A0%ED%96%A5%EC%9D%98%20%EC%86%8C%EB%82%98%EB%AC%B4","ridi":"https://ridibooks.com/search?q=%EA%B3%A0%ED%96%A5%EC%9D%98%20%EC%86%8C%EB%82%98%EB%AC%B4","welaaa":"https://www.welaaa.com/search?keyword=%EA%B3%A0%ED%96%A5%EC%9D%98%20%EC%86%8C%EB%82%98%EB%AC%B4","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788991914469","yes24":"https://www.yes24.com/product/search?query=9788991914469","elib":"https://www.google.com/search?q=%EA%B3%A0%ED%96%A5%EC%9D%98%20%EC%86%8C%EB%82%98%EB%AC%B4%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfa4a85122":{"id":"bfa4a85122","t":"늑대의 발톱","a":"최춘희","tr":[],"pub":"한국문연","y":"2005","isbn":"9788989885788","isbns":["9788989885788"],"cv":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788989885788.jpg","cv2":"https://search1.kakaocdn.net/thumb/R120x174.q85/?fname=http%3A%2F%2Ft1.daumcdn.net%2Flbook%2Fimage%2F1307638%3Ftimestamp%3D20231101164251","f":"문학","n":"한국","e":"미상","l":"쉽게","pg":"","ot":"","intro":"1990년 &lt;현대시&gt;로 등단한 시인의 세 번째 시집. 이 시집에서 시인은 삶의 모순으로 인해 빚어진 절망과 좌절, 삶에 대한 근원적인 의문의 다채로운 양상들을 진솔하고 그려내고 있다.","icut":true,"toc":"","recs":[["munhak","2006"]],"shorts":["문학나눔"],"univ":[],"au":{},"eb":[],"full":{},"rel":[],"star":null,"y24":"","daum":"https://search.daum.net/search?w=bookpage&bookId=1307638&q=%EB%8A%91%EB%8C%80%EC%9D%98+%EB%B0%9C%ED%86%B1","links":{"google":"https://www.google.com/search?q=%22%EB%8A%91%EB%8C%80%EC%9D%98%20%EB%B0%9C%ED%86%B1%22%20%EC%B5%9C%EC%B6%98%ED%9D%AC","lib":"https://www.data4library.kr/srch?srchText=9788989885788","millie":"https://www.millie.co.kr/v3/search/result/%EB%8A%91%EB%8C%80%EC%9D%98%20%EB%B0%9C%ED%86%B1","ridi":"https://ridibooks.com/search?q=%EB%8A%91%EB%8C%80%EC%9D%98%20%EB%B0%9C%ED%86%B1","welaaa":"https://www.welaaa.com/search?keyword=%EB%8A%91%EB%8C%80%EC%9D%98%20%EB%B0%9C%ED%86%B1","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788989885788","yes24":"https://www.yes24.com/product/search?query=9788989885788","elib":"https://www.google.com/search?q=%EB%8A%91%EB%8C%80%EC%9D%98%20%EB%B0%9C%ED%86%B1%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfa1801929":{"id":"bfa1801929","t":"여기는 괜찮아요","a":"전성태","tr":[],"pub":"창비","y":"2024","isbn":"9788936439552","isbns":["9788936439552"],"cv":"https://image.yes24.com/goods/127251987/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788936439552.jpg","f":"문학","n":"한국","e":"현대","l":"쉽게","pg":"280","ot":"","intro":"“그냥 거기 한번 가보고 싶었을 뿐이야\n잊지 않았다고 말해주고 싶었어”\n\n서정의 향연으로 일구어낸 한국소설의 빛나는 이정표\n섬세한 묘사 아래 꿈틀대는 역동적인 이야기의 힘\n\n신동엽문학상, 이효석문학상, 현대문학상 등을 수상하며 탄탄한 문학성을 널리 입증받아온 전성태가 9년 만에 소설집 『여기는 괜찮아요』를 펴내며 그의 작품을 손꼽아 기다리던 독자들을 찾아왔다. 한국어가 지닌 무궁무진한 아름다움을 올곧게 계승하면서도 토속과 세속을 종횡무진 넘나들며 풍성한 이야기를 통해 몰입감을 만들어내는 솜씨가 한층 무르익었다. 해학과 풍자적 요소 이면에서 민족의 아픔과 현대사의 비극을 느끼게 하는 특유의 서사적 기법이 여전히 시대와 공명하며 묵직한 울림을 자아내는 가운데, 간명하고도 군더더기 없는 필치로 그려낸 시간의 궤적이 더욱 선연하게 다가오며 감동을 선사한다.","icut":false,"toc":"책머리에\n깡통\n숲으로\n가족 버스\n합석\n상봉\n조용한 생활\n이웃\n섬으로 가는 엉뚱한 여행\n여기는 괜찮아요\n작가의 말\n수록작품 발표지면","recs":[["munhak","2025"]],"shorts":["문학나눔"],"univ":[],"au":{"b":1969,"kw":"전성태","en":"Jeon Sungtae"},"eb":[["YES24 eBook","https://www.yes24.com/product/goods/176969531"]],"full":{},"rel":[],"star":9.5,"y24":"https://www.yes24.com/product/goods/127251987","daum":"https://search.daum.net/search?w=bookpage&bookId=6661854&q=%EC%97%AC%EA%B8%B0%EB%8A%94+%EA%B4%9C%EC%B0%AE%EC%95%84%EC%9A%94","links":{"google":"https://www.google.com/search?q=%22%EC%97%AC%EA%B8%B0%EB%8A%94%20%EA%B4%9C%EC%B0%AE%EC%95%84%EC%9A%94%22%20%EC%A0%84%EC%84%B1%ED%83%9C","lib":"https://www.data4library.kr/srch?srchText=9788936439552","millie":"https://www.millie.co.kr/v3/search/result/%EC%97%AC%EA%B8%B0%EB%8A%94%20%EA%B4%9C%EC%B0%AE%EC%95%84%EC%9A%94","ridi":"https://ridibooks.com/search?q=%EC%97%AC%EA%B8%B0%EB%8A%94%20%EA%B4%9C%EC%B0%AE%EC%95%84%EC%9A%94","welaaa":"https://www.welaaa.com/search?keyword=%EC%97%AC%EA%B8%B0%EB%8A%94%20%EA%B4%9C%EC%B0%AE%EC%95%84%EC%9A%94","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788936439552","yes24":"https://www.yes24.com/product/search?query=9788936439552","elib":"https://www.google.com/search?q=%EC%97%AC%EA%B8%B0%EB%8A%94%20%EA%B4%9C%EC%B0%AE%EC%95%84%EC%9A%94%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfa96f3ca7":{"id":"bfa96f3ca7","t":"세련되게 해결해 드립니다, 백조 세탁소","a":"이재인","tr":[],"pub":"안전가옥","y":"2021","isbn":"9791191193152","isbns":["9791191193152"],"cv":"https://image.yes24.com/goods/103336861/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9791191193152.jpg","f":"문학","n":"한국","e":"현대","l":"쉽게","pg":"364","ot":"","intro":"아무래도 이번 생은 바닥 같지만\n그래도 살아갈 수밖에 없다\n그럼에도 불구하고 사랑할 수밖에 없다\n이 동네를, 이 사람들을, 그리고 내 인생을\n\n2019년 안전가옥 스토리 공모전 코지 미스터리 부문 대상 수상작!\n여수 토박이 세탁소집 딸내미 백은조를 중심으로 펼쳐지는 생활 밀착형 추리 드라마\n\n서울에 있는 대학만 가면, 열정적으로 부딪치다 보면 대단한 디자이너가 되어 꽃길을 걸을 줄 알았다. 그런데 다니던 대학이 한순간 망해 버렸다. 엎친 데 덮친 격으로 고향 여수에서 세탁소를 운영하던 부모님이 은퇴를 선언해 버렸다. 갑자기 낙동강 오리알 신세가 되어 버린 백은조는 울며 겨자 먹기의 심정으로 일단 세탁소를 맡기로 한다.","icut":false,"toc":"1 그랜드 오픈\n2 여수는 항구다\n3 팔로워\n4 신데렐라의 드레스\n5 잭과 콩나무\n6 데칼코마니\n7 열세 개의 성냥갑\n작가의 말\n프로듀서의 말","recs":[["munhak","2021"]],"shorts":["문학나눔"],"univ":[],"au":{"b":2004,"kw":"이재인 (배우)","en":"Lee Jae-in"},"eb":[["YES24 eBook","https://www.yes24.com/product/goods/103633264"]],"full":{},"rel":[],"star":9.3,"y24":"https://www.yes24.com/product/goods/103336861","daum":"https://search.daum.net/search?w=bookpage&bookId=5824337&q=%EC%84%B8%EB%A0%A8%EB%90%98%EA%B2%8C+%ED%95%B4%EA%B2%B0%ED%95%B4+%EB%93%9C%EB%A6%BD%EB%8B%88%EB%8B%A4%2C+%EB%B0%B1%EC%A1%B0+%EC%84%B8%ED%83%81%EC%86%8C","links":{"google":"https://www.google.com/search?q=%22%EC%84%B8%EB%A0%A8%EB%90%98%EA%B2%8C%20%ED%95%B4%EA%B2%B0%ED%95%B4%20%EB%93%9C%EB%A6%BD%EB%8B%88%EB%8B%A4%2C%20%EB%B0%B1%EC%A1%B0%20%EC%84%B8%ED%83%81%EC%86%8C%22%20%EC%9D%B4%EC%9E%AC%EC%9D%B8","lib":"https://www.data4library.kr/srch?srchText=9791191193152","millie":"https://www.millie.co.kr/v3/search/result/%EC%84%B8%EB%A0%A8%EB%90%98%EA%B2%8C%20%ED%95%B4%EA%B2%B0%ED%95%B4%20%EB%93%9C%EB%A6%BD%EB%8B%88%EB%8B%A4%2C%20%EB%B0%B1%EC%A1%B0%20%EC%84%B8%ED%83%81%EC%86%8C","ridi":"https://ridibooks.com/search?q=%EC%84%B8%EB%A0%A8%EB%90%98%EA%B2%8C%20%ED%95%B4%EA%B2%B0%ED%95%B4%20%EB%93%9C%EB%A6%BD%EB%8B%88%EB%8B%A4%2C%20%EB%B0%B1%EC%A1%B0%20%EC%84%B8%ED%83%81%EC%86%8C","welaaa":"https://www.welaaa.com/search?keyword=%EC%84%B8%EB%A0%A8%EB%90%98%EA%B2%8C%20%ED%95%B4%EA%B2%B0%ED%95%B4%20%EB%93%9C%EB%A6%BD%EB%8B%88%EB%8B%A4%2C%20%EB%B0%B1%EC%A1%B0%20%EC%84%B8%ED%83%81%EC%86%8C","kyobo":"https://search.kyobobook.co.kr/search?keyword=9791191193152","yes24":"https://www.yes24.com/product/search?query=9791191193152","elib":"https://www.google.com/search?q=%EC%84%B8%EB%A0%A8%EB%90%98%EA%B2%8C%20%ED%95%B4%EA%B2%B0%ED%95%B4%20%EB%93%9C%EB%A6%BD%EB%8B%88%EB%8B%A4%2C%20%EB%B0%B1%EC%A1%B0%20%EC%84%B8%ED%83%81%EC%86%8C%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfa9ddd011":{"id":"bfa9ddd011","t":"벌거숭이들","a":"김태용","tr":[],"pub":"문학과지성사","y":"2014","isbn":"9788932026787","isbns":["9788932026787"],"cv":"https://image.yes24.com/goods/24347303/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788932026787.jpg","f":"문학","n":"한국","e":"현대","l":"쉽게","pg":"222","ot":"","intro":"한국일보문학상, 문지문학상 수상 작가이자 2014년 올해로 등단 10년차를 맞는 소설가 김태용의 두번째 장편소설. 2005년 「세계의 문학」으로 등단한 김태용은 소설집 풀밭 위의 돼지, 포주 이야기와 장편소설 숨김없이 남김없이 등을 선보이며 '독보적인 소설, 비교 불가한 소설'이란 평단의 주목 속에 독자들은 물론 소설가들에게마저 충격을 안겨왔다.\n\n문학의 영토, 아니 게토에서 어떤 계보를 찾는 일이 무의미할 정도로 김태용의 말은 어떤 확신도 없는 말, 스스로 앞의 문장을 부정하고 지우는 말이라 할 만하다. \"촉각을 의심하고 청각을 불신하며 혀끝으로 찔끔찔끔 핥듯이 읽을 수만 있는 언어.\" 무기력하고 무능력한 작은 일부로 기적처럼 불행처럼 간신히 매달려 있는 존재. 그렇게 벌거벗은 채 김태용은 소설 앞에 불안하게 서 있거나 위태롭게 매달려 있다.\n\n\"가장 모호한 미각과 가장 확실한 생(의 감)각이 부딪치는 한 모서리에 간신히 매달려 있는 언어. 간당간당한 가난한 언어.","icut":false,"toc":"1부_ 등장\n2부_ 암전\n3부_ 퇴장\n해설_한 번쯤_조효원","recs":[["munhak","2015"]],"shorts":["문학나눔"],"univ":[],"au":{"b":1969,"kw":"김태용 (1969년)","en":"Kim Tae-yong"},"eb":[],"full":{},"rel":[],"star":2,"y24":"https://www.yes24.com/product/goods/24347303","daum":"https://search.daum.net/search?w=bookpage&bookId=494966&q=%EB%B2%8C%EA%B1%B0%EC%88%AD%EC%9D%B4%EB%93%A4","links":{"google":"https://www.google.com/search?q=%22%EB%B2%8C%EA%B1%B0%EC%88%AD%EC%9D%B4%EB%93%A4%22%20%EA%B9%80%ED%83%9C%EC%9A%A9","lib":"https://www.data4library.kr/srch?srchText=9788932026787","millie":"https://www.millie.co.kr/v3/search/result/%EB%B2%8C%EA%B1%B0%EC%88%AD%EC%9D%B4%EB%93%A4","ridi":"https://ridibooks.com/search?q=%EB%B2%8C%EA%B1%B0%EC%88%AD%EC%9D%B4%EB%93%A4","welaaa":"https://www.welaaa.com/search?keyword=%EB%B2%8C%EA%B1%B0%EC%88%AD%EC%9D%B4%EB%93%A4","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788932026787","yes24":"https://www.yes24.com/product/search?query=9788932026787","elib":"https://www.google.com/search?q=%EB%B2%8C%EA%B1%B0%EC%88%AD%EC%9D%B4%EB%93%A4%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfa9a25759":{"id":"bfa9a25759","t":"낙타","a":"이명인","tr":[],"pub":"문이당","y":"2006","isbn":"9788974563240","isbns":["9788974563240"],"cv":"https://image.yes24.com/goods/1943930/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788974563240.jpg","f":"문학","n":"한국","e":"미상","l":"쉽게","pg":"290","ot":"","intro":"1997년 장편 소설 『사랑에 대한 세 가지 생각』으로 제1회 탐라문학상을 수상하고, 『아버지의 우산』, 『집으로 가는 길』, 『치즈』 등의 작품을 통해 단아하지만 깊이 있는 문체, 짜임새 있는 이야기 솜씨를 유감없이 발휘해 온 이명인의 새 장편소설. 『낙타』는 제주 섬을 배경으로 출가한 남편의 빈자리를 홀로 채우며 살아가는 40대 중년 여성인 나 ‘야목’의 일상과 열병처럼 찾아온 사랑인 30대 ‘나무’와의 관계를 통해 ‘나’가 내면의 상처를 치유하고 드러낼 수 없는 사랑을 받아들이는 과정을 섬세하게 그려 내고 있?..","icut":false,"toc":"","recs":[["munhak","2006"]],"shorts":["문학나눔"],"univ":[],"au":{},"eb":[],"full":{},"rel":[],"star":6,"y24":"https://www.yes24.com/product/goods/1943930","daum":"https://search.daum.net/search?w=bookpage&bookId=1041468&q=%EB%82%99%ED%83%80","links":{"google":"https://www.google.com/search?q=%22%EB%82%99%ED%83%80%22%20%EC%9D%B4%EB%AA%85%EC%9D%B8","lib":"https://www.data4library.kr/srch?srchText=9788974563240","millie":"https://www.millie.co.kr/v3/search/result/%EB%82%99%ED%83%80","ridi":"https://ridibooks.com/search?q=%EB%82%99%ED%83%80","welaaa":"https://www.welaaa.com/search?keyword=%EB%82%99%ED%83%80","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788974563240","yes24":"https://www.yes24.com/product/search?query=9788974563240","elib":"https://www.google.com/search?q=%EB%82%99%ED%83%80%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfa4d43d80":{"id":"bfa4d43d80","t":"금호동의 달","a":"김정식","tr":[],"pub":"이유출판","y":"2024","isbn":"9791189534523","isbns":["9791189534523"],"cv":"https://image.yes24.com/goods/128945872/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9791189534523.jpg","f":"문학","n":"한국","e":"미상","l":"쉽게","pg":"272","ot":"","intro":"1970년대 서울의 초상 어린아이의 눈에 비친 금호동 달빛 1970~1980년대 경제개발 시기, 서울 하늘의 달빛을 바라보던 어린아이가 어른이 되어 옛 기억을 모아 에세이를 펴냈다. 외국의 대학에서 심리학과 경영학을 강의하다 현재 광운대 교수로 재직 중인 저자는 금호동 달동네에서 유년기를 보냈다. 가난했지만 이웃 간에 정이 도탑던 시절, 작가는 다리가 불편한 탓에 조금 낮은 높이에서 세상을 바라보던 아이였다. 오랜 타국 생활을 마치고 귀국한 후 어느 날, 작가는 자신의 자아가 이곳에서 비롯되었음을 깨닫고 자신을 키워낸 금호동과 그곳에 살던 사람들의 기억을 되살려 글을 쓰기로 한다. 조각보처럼 기억을 엮은『금호동의 달』에는 고단한 삶 속에서도 유머와 여유를 잃지 않는 이웃들의 모습이 생생히 그려진다. 이 책은 이들에게 바치는 저자의 고백록이자 한편의 팩션 단편집이다.","icut":false,"toc":"프롤로그\n1 유년의 기억\n새벽 수돗가\n개천\n계수나무집\n금남시장의 진석이\n서울의 달\n용순이 누나의 짐 자전거\n구루마, 휠처, 휠체어\n때로는 빌지 말고 싸워라\n얼빠진 늑대\n2 뜨겁던 청춘\n눈물\n동환이의 썬데이 서울\n추석의 차용필\n불판\n순대\n50년 그리고 한 달\n우주의 나비\n허장강 아저씨\n뽀빠이 삼촌\n선학알미늄\n3 그리운 그 집\n겨울 아침 배춧국\n구운 김\n김밥\n수두\n새벽, 삼양라면\n수제비\n음석은 쪼매 버리더라도 남는 기 낫데이\n변두리 찬스\n삼류 극장\n‘얼음’이 아니고 ‘어름’\n이발 학원\n그대 다시는 그 집에 가지 못하리!\n에필로그","recs":[["munhak","2025"]],"shorts":["문학나눔"],"univ":[],"au":{"en":"Jeongsik Kim"},"eb":[["YES24 eBook","https://www.yes24.com/product/goods/165256057"]],"full":{},"rel":[],"star":10,"y24":"https://www.yes24.com/product/goods/128945872","daum":"https://search.daum.net/search?w=bookpage&bookId=6682341&q=%EA%B8%88%ED%98%B8%EB%8F%99%EC%9D%98+%EB%8B%AC","links":{"google":"https://www.google.com/search?q=%22%EA%B8%88%ED%98%B8%EB%8F%99%EC%9D%98%20%EB%8B%AC%22%20%EA%B9%80%EC%A0%95%EC%8B%9D","lib":"https://www.data4library.kr/srch?srchText=9791189534523","millie":"https://www.millie.co.kr/v3/search/result/%EA%B8%88%ED%98%B8%EB%8F%99%EC%9D%98%20%EB%8B%AC","ridi":"https://ridibooks.com/search?q=%EA%B8%88%ED%98%B8%EB%8F%99%EC%9D%98%20%EB%8B%AC","welaaa":"https://www.welaaa.com/search?keyword=%EA%B8%88%ED%98%B8%EB%8F%99%EC%9D%98%20%EB%8B%AC","kyobo":"https://search.kyobobook.co.kr/search?keyword=9791189534523","yes24":"https://www.yes24.com/product/search?query=9791189534523","elib":"https://www.google.com/search?q=%EA%B8%88%ED%98%B8%EB%8F%99%EC%9D%98%20%EB%8B%AC%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfa167258f":{"id":"bfa167258f","t":"마음, 스밈","a":"김선규","tr":[],"pub":"기역","y":"2023","isbn":"9791191199727","isbns":["9791191199727"],"cv":"https://image.yes24.com/goods/122531960/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9791191199727.jpg","f":"문학","n":"한국","e":"현대","l":"쉽게","pg":"248","ot":"","intro":"마음의 눈, 사진을 이야기하다\n사진에 마음을 담는 법, 사진 속 마음을 읽는 법\n\n“사진을 찍을 때 한쪽 눈을 감는 이유는?” 세계적인 사진작가 앙리 카르티 브레송은 이렇게 답한다. 마음의 눈에 양보하기 위해서라고. 마음 눈으로 현장을 바라보고 대한민국 현대사 곳곳을 누비며 기록해온 저자가 만난 의미심장 한마디이다. 그 한마디로 이 책이 첫마음, 첫걸음을 떼었으니 말이다. 이 책은 ‘마음 눈’으로 바라본 프레임 속 세상과 스미듯 만나온 저자의 사진 인생 온통의 자취이기 때문이다.\n\n한겨레신문과 문화일보에서 35년간 사진기자로 현장을 지킨 김선규 작가의 새 책, 사진명상에세이 『마음, 스밈』이 독자와 만난다. 작가는 사진을 찍을 때 마음의 눈으로 피사체를 담아야 한다고 방점을 두어 말해왔다. 기자 생활 동안 본 사건사고뿐만 아니라, 일상생활에서 만난 나무, 꽃, 풍경, 고양이, 별, 사랑하는 가족까지.","icut":false,"toc":"펴내는 글 ……4\n생명, 그 아름다운 여정\n마음의 눈을 뜨다 …… 12\n모든 생명은 다 귀하다 …… 29\n작은 것을 내치지 않는 마음 …… 35\n세상의 모든 사진은 곧 누군가의 마음 …… 39\n사진, 마음을 담다\n사진, 자기만의 이름을 붙이는 작업 …… 52\n사진에 마음을 담는 여덟 가지 방법 …… 58\n사진의 문법\n1) 빛 …… 89\n2) 프레임 …… 124\n3) 눈높이 …… 138\n4) 초점과 심도 …… 144\n5) 원근감 …… 157\n일상에서 사진을 통해 마음 찾기\n1) 사진산책 …… 168\n2) 숲에서 놀기 …… 170\n3) 숲, 사진에 담기 …… 172\n4) 도심에 핀 희망 …… 180\n5) '오늘도 수고했어' …… 196\n6) 일상 속 무의식 발견 …… 219\n7) 계절의 변화 …… 202\n8) 일상의 작은 변화 …… 206\n포토에세이\n마음을 움직이는 포토에세이 작성법 …… 210\n포노 사피엔스\n사진 찍는 인류, 포노 사피엔스 …… 226\n1) 사진은 '놀이' …… 228\n2) 일상 속 얼굴 찾기 …… 232\n3) 스마트폰 하나면 누구나 사진작가 …… 235\n4) 좋은 사진이란? …… 243","recs":[["munhak","2024"]],"shorts":["문학나눔"],"univ":[],"au":{"b":1987,"kw":"김선규 (축구 선수)","en":"Kim Sun-kyu"},"eb":[],"full":{},"rel":[],"star":10,"y24":"https://www.yes24.com/product/goods/122531960","daum":"https://search.daum.net/search?w=bookpage&bookId=6441561&q=%EB%A7%88%EC%9D%8C%2C+%EC%8A%A4%EB%B0%88","links":{"google":"https://www.google.com/search?q=%22%EB%A7%88%EC%9D%8C%2C%20%EC%8A%A4%EB%B0%88%22%20%EA%B9%80%EC%84%A0%EA%B7%9C","lib":"https://www.data4library.kr/srch?srchText=9791191199727","millie":"https://www.millie.co.kr/v3/search/result/%EB%A7%88%EC%9D%8C%2C%20%EC%8A%A4%EB%B0%88","ridi":"https://ridibooks.com/search?q=%EB%A7%88%EC%9D%8C%2C%20%EC%8A%A4%EB%B0%88","welaaa":"https://www.welaaa.com/search?keyword=%EB%A7%88%EC%9D%8C%2C%20%EC%8A%A4%EB%B0%88","kyobo":"https://search.kyobobook.co.kr/search?keyword=9791191199727","yes24":"https://www.yes24.com/product/search?query=9791191199727","elib":"https://www.google.com/search?q=%EB%A7%88%EC%9D%8C%2C%20%EC%8A%A4%EB%B0%88%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfa642828e":{"id":"bfa642828e","t":"무채색 아저씨, 행복의 도구를 찾다","a":"이경주","tr":[],"pub":"아날로그(글담)","y":"2022","isbn":"9791187147930","isbns":["9791187147930"],"cv":"https://image.yes24.com/goods/108461796/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9791187147930.jpg","f":"문학","n":"한국","e":"현대","l":"쉽게","pg":"224","ot":"","intro":"“모두들 아저씨가 무슨 그림이냐고 했지만, 나는 필사적으로 취미를 갖고 싶었다.”\n나이가 들어도 사는 게 여전히 갈팡질팡이라면 공감할 수밖에 없는\n40대 평범한 직장인의 일과 삶, 취미에 관한 이야기\n\n[서울신문] 이경주 기자는 몇 년째 미술을 배울까 말까 고민하다가 주 52시간 근무제를 기회로, 용기를 내 아들이 다니는 화실에 등록했다. 처음에는 어색했지만 점점 선 하나를 긋는 데도 온 신경을 집중해야 하는 과정 속에서 온전히 무언가에 집중하고 몰입하는 즐거움과 기쁨을 느꼈다. 그림을 그릴 때만큼은 가족과 일이 우선이던 삶에서 ‘자기 자신’을 중심에 놓을 수 있었다. 그림은 ‘자기만의 방’이 되어주었고, 그 안에서 누구 눈치도 안 보고 자유롭게 생각을 표현했다. 단조로운 무채색 같던 40대 아저씨의 삶이 다채로워졌다.\n\n이 책은 저자가 그림을 그리며 생각한 것들에 관한 1년간의 기록이다.","icut":false,"toc":"프롤로그 | 무채색 삶을 살던 마흔셋 직장인에게 그림 그리는 취미가 생겼습니다\n마젠타 - 열정과 설렘이 되살아나다\n마흔셋, 미술학원에 등록하다\n칭찬은 고래도, 아이도, 다 큰 어른도 춤추게 한다\n아내를 그리며 결혼생활에 대해 생각하다\n수채화의 본질은 물, 삶의 본질은 단순함\n우리는 얼마나 많은 좋은 때를 놓치며 사는 걸까?\n의미 있는 무의미함의 시간\n자기 몸에 관심 가져본 적이 있나요?\n그림의 여백, 말에도 필요하다\n옐로우 - 애쓰기보다는 즐기는 마음으로\n튼실한 열매는 때가 되어야 맺힌다\n‘진짜 같은 것’은 결코 ‘진짜’가 될 수 없다\n어른의 머릿속에서 생각을 몰아낸다는 것\n오래된 것들은 모두 다 아름답다\n열정은 뜨겁기보다는 뭉근한 것\n수많은 개성이 모여 거대한 흐름을 만든다\n생의 한가운데에서 어떤 뿌리를 내리고 있는가?\n사이언 - 자유로움에 이르다\n우리 모두에게 자기만의 방이 필요한 이유\n원데이가 아닌 꾸준한 취미를 갖고 싶다면\n익숙한 길을 벗어나야 새로운 길을 만날 수 있다\n밥벌이와 소명의 차이\n마흔 중반, 냉소와 열정 사이 어딘가\n금방 1년, 그림을 그리며 생각한 것","recs":[["munhak","2022"]],"shorts":["문학나눔"],"univ":[],"au":{"b":1952,"kw":"이경주"},"eb":[["YES24 eBook","https://www.yes24.com/product/goods/109161883"]],"full":{},"rel":[],"star":9.8,"y24":"https://www.yes24.com/product/goods/108461796","daum":"https://search.daum.net/search?w=bookpage&bookId=6045096&q=%EB%AC%B4%EC%B1%84%EC%83%89+%EC%95%84%EC%A0%80%EC%94%A8%2C+%ED%96%89%EB%B3%B5%EC%9D%98+%EB%8F%84%EA%B5%AC%EB%A5%BC+%EC%B0%BE%EB%8B%A4","links":{"google":"https://www.google.com/search?q=%22%EB%AC%B4%EC%B1%84%EC%83%89%20%EC%95%84%EC%A0%80%EC%94%A8%2C%20%ED%96%89%EB%B3%B5%EC%9D%98%20%EB%8F%84%EA%B5%AC%EB%A5%BC%20%EC%B0%BE%EB%8B%A4%22%20%EC%9D%B4%EA%B2%BD%EC%A3%BC","lib":"https://www.data4library.kr/srch?srchText=9791187147930","millie":"https://www.millie.co.kr/v3/search/result/%EB%AC%B4%EC%B1%84%EC%83%89%20%EC%95%84%EC%A0%80%EC%94%A8%2C%20%ED%96%89%EB%B3%B5%EC%9D%98%20%EB%8F%84%EA%B5%AC%EB%A5%BC%20%EC%B0%BE%EB%8B%A4","ridi":"https://ridibooks.com/search?q=%EB%AC%B4%EC%B1%84%EC%83%89%20%EC%95%84%EC%A0%80%EC%94%A8%2C%20%ED%96%89%EB%B3%B5%EC%9D%98%20%EB%8F%84%EA%B5%AC%EB%A5%BC%20%EC%B0%BE%EB%8B%A4","welaaa":"https://www.welaaa.com/search?keyword=%EB%AC%B4%EC%B1%84%EC%83%89%20%EC%95%84%EC%A0%80%EC%94%A8%2C%20%ED%96%89%EB%B3%B5%EC%9D%98%20%EB%8F%84%EA%B5%AC%EB%A5%BC%20%EC%B0%BE%EB%8B%A4","kyobo":"https://search.kyobobook.co.kr/search?keyword=9791187147930","yes24":"https://www.yes24.com/product/search?query=9791187147930","elib":"https://www.google.com/search?q=%EB%AC%B4%EC%B1%84%EC%83%89%20%EC%95%84%EC%A0%80%EC%94%A8%2C%20%ED%96%89%EB%B3%B5%EC%9D%98%20%EB%8F%84%EA%B5%AC%EB%A5%BC%20%EC%B0%BE%EB%8B%A4%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfa8486b72":{"id":"bfa8486b72","t":"쿼런틴","a":"김어제","tr":[],"pub":"마음의숲","y":"2020","isbn":"9791162850626","isbns":["9791162850626"],"cv":"https://image.yes24.com/goods/91888052/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9791162850626.jpg","f":"문학","n":"한국","e":"미상","l":"쉽게","pg":"316","ot":"","intro":"이 책은 뉴욕의 한국인 부부가 코로나19를 직접 겪으며, 검사도 치료도 받을 수 없는 미국의 의료 상황 속에서 해열제만으로 이겨낸 생존기다. 어떻게 살아냈는지, 어떤 약과 음식을 먹었는지, 부부 중 간호를 도맡은 쪽은 어떻게 확진자를 관리했기에 감염되지 않았는지에 대해 상세히 기록했다. 이외에도 적나라한 미국의 의료 실태, 팬데믹으로 인해 벌어지는 사재기, 종교 근본주의와 인종 차별, 가정 폭력과 같은 사회 문제, 그리고 한국으로 돌아온 후 생활 치료 센터와 자가 격리의 시간까지 그 40일간의 기록을 생생한 현장의 목소리로 담았다.\n\n이 책의 제목인 '쿼런틴Quarantine'은 격리, 검역을 일컫는 말로, 14세기 유럽 인구의 3분의 1가량을 감소시킨 흑사병이 대유행할 당시 베네치아 의회가 외부에서 입항하는 선박과 선원들을 40일 동안 격리 및 검역한 일에서 유래한 단어다.","icut":false,"toc":"서문│끝나지 않은 팬데믹의 한가운데서 4\n1장. 2019년 12월\n뉴욕의 네 번째 겨울 13\n2장. 2020년 1월\n아플 땐 집에서 넷플릭스│Netflix and ill 19\n모든 이를 위한 건강 보험│Medicare for all 27\n다가오는 위협 37\n3장. 2020년 2월\n확산되는 질병 47\n누구보다 빠르게 남들과는 다르게, 사재기 54\n아카데미 시상식과 인종 차별의 전조 59\n종교 근본주의와 31번 확진자 69\n4장. 2020년 3월\n뉴욕 상황과 칩거 생활 92\n마스크, 쓰느냐 마느냐 그것이 문제로다 102\n네 나라로 돌아가 107\n공포의 사재기 121\n5장. 2020년 4월: 코로나19 생존 일지 153\n6장. 2020년 5월\n들어가기 앞서 219\n귀국 220\n생활 치료 센터와 자가 격리 238\n7장. 코로나19 이전과 이후의 세계\n기후 변화와 인수공통감염병, 다음 팬데믹 274\n마치며│어떻게 살 것인가 284\n부록│셧다운에 대비하는 자세 287","recs":[["munhak","2020"]],"shorts":["문학나눔"],"univ":[],"au":{},"eb":[],"full":{},"rel":[],"star":9.5,"y24":"https://www.yes24.com/product/goods/91888052","daum":"https://search.daum.net/search?w=bookpage&bookId=5453592&q=%EC%BF%BC%EB%9F%B0%ED%8B%B4","links":{"google":"https://www.google.com/search?q=%22%EC%BF%BC%EB%9F%B0%ED%8B%B4%22%20%EA%B9%80%EC%96%B4%EC%A0%9C","lib":"https://www.data4library.kr/srch?srchText=9791162850626","millie":"https://www.millie.co.kr/v3/search/result/%EC%BF%BC%EB%9F%B0%ED%8B%B4","ridi":"https://ridibooks.com/search?q=%EC%BF%BC%EB%9F%B0%ED%8B%B4","welaaa":"https://www.welaaa.com/search?keyword=%EC%BF%BC%EB%9F%B0%ED%8B%B4","kyobo":"https://search.kyobobook.co.kr/search?keyword=9791162850626","yes24":"https://www.yes24.com/product/search?query=9791162850626","elib":"https://www.google.com/search?q=%EC%BF%BC%EB%9F%B0%ED%8B%B4%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfa0ab162c":{"id":"bfa0ab162c","t":"꽃을 품다","a":"한복용","tr":[],"pub":"인간과문학사","y":"2019","isbn":"9791160841008","isbns":["9791160841008"],"cv":"https://image.yes24.com/goods/75517853/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9791160841008.jpg","f":"문학","n":"한국","e":"미상","l":"쉽게","pg":"216","ot":"","intro":"2007년 격월간 『에세이스트』에 수필, 2016년에 계간 『인간과문학』에 문학평론으로 등단하여 수필과 평론 등 활발한 글쓰기를 펼치는 한복용 작가가 2014년부터 『여행작가』에 4년 동안 꽃을 주제로 연재한 에세이를 모아 『꽃을 품다』(부제, 꽃과 함께 하는 영혼의 쉼터)를 출간했다 한복용 작가는 어릴 때 나무일을 했던 아버지 덕분에 꽃의 이름을 알게 되었고 어머니를 통해 꽃을 품는 법을 배웠으며 30대 중반을 넘어, 운명처럼 플로리스트가 되었다고 말한다. 그는 지난 4년 간 연재를 통해 꽃의 사계(四季)를 보며 꽃과 자연과 인간은 하나라는 것을 깨달았다고 고백한다. 꽃 에세이 『꽃을 품다』는 봄, 여름, 가을, 겨울 네 계절에 도시와 농촌 등에서 눈만 돌리면 만날 수 있는 꽃들의 사생활을 훔쳐보는 듯한 느낌을 갖게 한다.","icut":false,"toc":"Part Ⅰ 솟아나다_봄\n천리향처럼 사는 법·11 | 목련의 꽃그늘 한 뼘·16\n매화, 세상을 바꾸다·21 | 그대에게 바치다·26\n나르시스의 미소·31 | 민들레 그녀·36 | 개나리·41\n산수유 꽃 필 때면·46 프리지어가 있는 풍경·51\n아마릴리스의 사랑·56 | 튤립, 완벽한 행복을 꿈꾸다·61\nPart Ⅱ 피어나다_여름\n찔레꽃 필 무렵·69 | 개망초 꽃·74\n당신은 수국 꽃을 좋아하나요?·79 | 뚱딴지 꽃 핀 날·84\n사랑나무 자귀·89 | 오죽헌의 맨드라미·94\n백일 간의 여름사랑, 배롱나무·99 | 감자꽃·103\n그 남자의 넋, 나팔꽃·108 | 카네이션·113\n형주 씨의 정원·119 | 변함없는 마음, 백일홍·125\nPart Ⅲ 모으다_가을\n지금은 칸나의 계절·133 | 은행나무의 가을·138\n코스모스와의 작별·143 | 꽃무릇, 만날 수 없지만 늘 함께하는·148\n향기가 있는 언덕, ‘허브힐’·152 | 화방사우(花房四友)·159\n화분·164 | 해피트리·168\nPart Ⅳ 준비하다_겨울\n12월의 꽃, 포인세티아·179 | 동백꽃이 피었다·184\n꽃을 자르다·190 | 멋진 놈, 굿바이·195\n제라늄·201 | 행복한 사람들·207 | 향기 없는 질투·211\n책을 펴내며 | 꽃을 품다 · 4","recs":[["munhak","2019"]],"shorts":["문학나눔"],"univ":[],"au":{},"eb":[],"full":{},"rel":[],"star":10,"y24":"https://www.yes24.com/product/goods/75517853","daum":"https://search.daum.net/search?w=bookpage&bookId=4987789&q=%EA%BD%83%EC%9D%84+%ED%92%88%EB%8B%A4","links":{"google":"https://www.google.com/search?q=%22%EA%BD%83%EC%9D%84%20%ED%92%88%EB%8B%A4%22%20%ED%95%9C%EB%B3%B5%EC%9A%A9","lib":"https://www.data4library.kr/srch?srchText=9791160841008","millie":"https://www.millie.co.kr/v3/search/result/%EA%BD%83%EC%9D%84%20%ED%92%88%EB%8B%A4","ridi":"https://ridibooks.com/search?q=%EA%BD%83%EC%9D%84%20%ED%92%88%EB%8B%A4","welaaa":"https://www.welaaa.com/search?keyword=%EA%BD%83%EC%9D%84%20%ED%92%88%EB%8B%A4","kyobo":"https://search.kyobobook.co.kr/search?keyword=9791160841008","yes24":"https://www.yes24.com/product/search?query=9791160841008","elib":"https://www.google.com/search?q=%EA%BD%83%EC%9D%84%20%ED%92%88%EB%8B%A4%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfafa0ccca":{"id":"bfafa0ccca","t":"죽기 전에 시 한 편 쓰고 싶다","a":"나태주","tr":[],"pub":"리오북스","y":"2016","isbn":"9791195729562","isbns":["9791195729562"],"cv":"https://image.yes24.com/goods/25537525/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9791195729562.jpg","f":"철학·사상","n":"한국","e":"현대","l":"보통","pg":"345","ot":"","intro":"당신도 시인이 될 수 있습니다!\n\n“오래 보아야 예쁘다. 너도 그렇다.”\n이 한 문장만 보고도 우리는 금방 알 수 있다. 그렇습니다. ‘풀꽃 시인’ 나태주의 시이다. 그는 이 두 문장만으로도 수많은 사람들의 가슴을 따뜻하게 했고, 그의 시는 지금도 많은 사람들의 사랑을 받고 있다. 그런 나태주 시인이 사람들에게 말한다. 우리는 누구나 ‘시인’이 될 수 있다고. 당신 안의 그 시인을 끄집어내 보자고.\n\n주변을 둘러보면 ‘내 글’을 쓰고 싶어 하는 사람이 너무나 많다. 죽기 전에 자신의 이야기를 남기고 싶어 하는 사람, 직접 노래 가사를 써보고 싶은 사람……. 이 중에서도 가장 매력적인 글쓰기는 단연 ‘시 쓰기’이다. 내 마음을 몇 줄의 문장으로 표현한다는 것, 이 얼마나 멋진 일입니까! 재미있고, 놀라우며, 아름다운 시 쓰기 수업.","icut":false,"toc":"책머리에\n가슴이 설레어 눈물 글썽이기도 하는 당신\n1부 시 속엔 시가 없다\n나마스떼/ 버킷리스트로서의 시 쓰기/ 마음의 반창고/ 포기할 수 없는 인생/ 인간이란 존재/ 도구로서의 언어/ 입말과 글말/ 시 속엔 시가 없다/ 시란 어떤 글인가/ 시와 산문/ 시에 쓰이는 언어\n2부 시에 대해서\n좋은 시/ 찾아오는 시/ 사람을 살리는 시/ 신이 주시는 문장/ 모르는 만큼 느낀다/ 민들레 씨처럼/ 모든 시는 자서전이다/ 마음 들여다보기/ 시의 출발은 중얼거림이다/ 사물에게 말 기/ 시의 첫 문장 떠올리기/ 시인이라는 이름/ 시인, 감정집단의 대변인/ 왜 시인을 부르나/ 시를 쓰게 하는 마음/ 마음의 블랙박스/ 꿀벌의 언어/ 물 보면 흐르고/ 보리밥으로서의 시/ 시한테 진 빚\n3부 아내와 시 쓰기\n글씨 쓰기와 글쓰기/ 귀시인, 입시인, 글시인/ 우리 남편/ 꽃잎 눈/ ‘비단강’을 첫 글자 운으/ 연/ 영산홍/ 가을/ 겨울 오리/ 개처럼/ 개밥/ 아파트 9층/ 시 할아버지\n4부 나의 시 이렇게 썼다\n소년시 두 편/ 대숲 아래서/ 돌계단/ 내가 너를/ 비단강/ 사랑하는 마음 내게 있어도/ 시/ 기쁨/ 행복/ 풀꽃/ 오늘도 그대는 멀리 있다/ 선물/ 너무 그러지 마시어요/ 부탁/ 멀리서 빈다/ 황홀극치/ 아끼지 마세요/ 이 가을에/ 꽃그늘/ 묘비명\n함께 읽는 글\n맺는 글","recs":[["munhak","2016"]],"shorts":["문학나눔"],"univ":[],"au":{"b":1990,"kw":"나태주 (연예인)","en":"Na Tae-joo"},"eb":[["YES24 eBook","https://www.yes24.com/product/goods/27580937"]],"full":{},"rel":[],"star":9.6,"y24":"https://www.yes24.com/product/goods/25537525","daum":"https://search.daum.net/search?w=bookpage&bookId=1668197&q=%EC%A3%BD%EA%B8%B0+%EC%A0%84%EC%97%90+%EC%8B%9C+%ED%95%9C+%ED%8E%B8+%EC%93%B0%EA%B3%A0+%EC%8B%B6%EB%8B%A4","links":{"google":"https://www.google.com/search?q=%22%EC%A3%BD%EA%B8%B0%20%EC%A0%84%EC%97%90%20%EC%8B%9C%20%ED%95%9C%20%ED%8E%B8%20%EC%93%B0%EA%B3%A0%20%EC%8B%B6%EB%8B%A4%22%20%EB%82%98%ED%83%9C%EC%A3%BC","lib":"https://www.data4library.kr/srch?srchText=9791195729562","millie":"https://www.millie.co.kr/v3/search/result/%EC%A3%BD%EA%B8%B0%20%EC%A0%84%EC%97%90%20%EC%8B%9C%20%ED%95%9C%20%ED%8E%B8%20%EC%93%B0%EA%B3%A0%20%EC%8B%B6%EB%8B%A4","ridi":"https://ridibooks.com/search?q=%EC%A3%BD%EA%B8%B0%20%EC%A0%84%EC%97%90%20%EC%8B%9C%20%ED%95%9C%20%ED%8E%B8%20%EC%93%B0%EA%B3%A0%20%EC%8B%B6%EB%8B%A4","welaaa":"https://www.welaaa.com/search?keyword=%EC%A3%BD%EA%B8%B0%20%EC%A0%84%EC%97%90%20%EC%8B%9C%20%ED%95%9C%20%ED%8E%B8%20%EC%93%B0%EA%B3%A0%20%EC%8B%B6%EB%8B%A4","kyobo":"https://search.kyobobook.co.kr/search?keyword=9791195729562","yes24":"https://www.yes24.com/product/search?query=9791195729562","elib":"https://www.google.com/search?q=%EC%A3%BD%EA%B8%B0%20%EC%A0%84%EC%97%90%20%EC%8B%9C%20%ED%95%9C%20%ED%8E%B8%20%EC%93%B0%EA%B3%A0%20%EC%8B%B6%EB%8B%A4%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfaa6a6bba":{"id":"bfaa6a6bba","t":"일인용 책","a":"신해욱","tr":[],"pub":"봄날의책","y":"2015","isbn":"9788996997900","isbns":["9788996997900"],"cv":"https://image.yes24.com/goods/16858994/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788996997900.jpg","f":"문학","n":"한국","e":"현대","l":"쉽게","pg":"368","ot":"","intro":"『일인용 책』은 저자 신해욱의 산문집으로 이 책에 실린 글은 편편의 용적이 적으니 아무래도 미미한 파동 쪽에 집중한 편이다. 무심하게 스쳐 지나갈 뻔한 것들을 붙잡아 집중할 수 있게 만드는 형식, 그것이 700자라는 정해진 형식이었다. 700자가 아니었다면 다른 이야기가 씌어졌을 것이다. 형식이 내용을 창조한 셈이다. 어쩌면 삶도 그러하지 않을까. 주어진 형식에 우리는 그저 얽매이는 것이 아니라, 얽매임을 통해 자기만의 고유한 빛과 결을 만들어","icut":true,"toc":"season 1\n드림캐처\n소울푸드\n다이달로스의 골목\n머리칼의 시간\n남도의 맛\n새벽의 흐느낌\n고향의 말\n사이에서\n지우개 도장\n광주극장의 겨울\n12월 32일\n자라는 팔을 위한 선물\n제논의 역설\n가면과 얼굴\nimmediately\n4주기\n고객님의 실수\n길을 잃을 자유\n잃어버림에 대하여\n맥심 오리지널\n라구아르디나 엘샤를 위하여\n형제의 생선가게, 모녀의 반찬가게\n먹는 곳, 싸는 곳\n지구가 작아진다\n‘ㅢ자’에 앉다\nseason 2\n유관순 괴담\n봄의 정령\n감나무집\n세상의 모든 아이들\n점프\n단지 남자라는 이유만으로\n가위소리\n귀신을 업고 있는 자화상\n탈옥\n피아노의 외로움\n어쩌지?\n독서의 푸가\n속초의 돌\n동백 하트\n도둑들\n배탈\n젖니의 세계\n환생\n바이크라이더\n소풍 가던 마음\nseason 3\n첫사랑\n시골뜨기\n맛의 기록에 대한 상상\n지름길\n복기하는 시간\n귀를 기울이면\n헨젤과 그레텔\n열대야\n블랙박스\n아름다운 공\n시간화폐\n머저리와 예술가\n꽃 장식\n인어 이야기\n여름의 끝\n끝물 가지\nseason 4\n영혼의 어떤 흔적\n어제 또 어제\n비밀\n이름의 규격\n일 년간의 햇빛\n‘명왕성스러움’을 위하여\n등의 표정\n흰 봉투\n한줄 김밥\n태풍 전날\n스케일링\n몰카\n천사가 지나갔다\n어쩌면 풍요일風曜日\n토끼인형\n물고기\n꼬마귀신들의 세계\n시간의 흔적\n훔쳐보기\n심드렁 식당\n점자에 담고픈 마음\nseason 5\n손에서 피는 꽃\n그 사람의 안부\n나무의 시간, 사람의 시간\n황금기\n그 겨울의 아기 뱀\n빈집\n9시와 10시 사이\n윷놀이\n핸드메이드\n저기요!\n양말공장의 불길\n그 이름, 그 언덕\n메리제인 펌프스\n이것이 인간인가\n각자의 레시피\n심청가\n중2 방위대\n칼갈이\n언니의 말씨\n곰발 실내화\nseason 6\n기억 편집\n음력의 겨울\n뿌리의 힘\n마흔하나\n거꾸로\n천사의 손톱\n구멍 속으로\n집의 유령들\n왁자지껄 외국어\n건망증\n다른 살구의 세계\n손맛, 종이맛\n나의 좌판\n아기다리고기다리던\n잔머리 인상\n홀씨 공포\n마림바\n카드 한 장 동전 한 닢\n벌레들\n그녀\n매직박스\n밤의 고양이\n2014. 4. 16.\n생명의 전화\n토성과 멜랑콜리\n부러움의 저울\n기울기\n블루칼라 판타지\n단원 김홍도\n히드라\n零\n양 한 마리\nseason 7\n우산을 위한 비\n고야\n그 집\n이토록 사소한 흔적\n잃어버린 꿈\n조삼모사\n버스 정류장\n참을 수 없는 가려움의 가벼움\n고뫄스\n카드 키\n우표의 맛\n파마하는 남자\n속사정\n운동화 끈\n단수\n단 한 권의 책\n닭발 먹기\n감쪽같이\n와글와글 사운드\n내가 쓰레기통으로 보이냐\n힘 빼기\n간판들\n그래도요\n그대로 가만히","recs":[["munhak","2015"]],"shorts":["문학나눔"],"univ":[],"au":{"b":1974,"kw":"신해욱"},"eb":[],"full":{},"rel":[],"star":9.1,"y24":"https://www.yes24.com/product/goods/16858994","daum":"https://search.daum.net/search?w=bookpage&bookId=1476370&q=%EC%9D%BC%EC%9D%B8%EC%9A%A9+%EC%B1%85","links":{"google":"https://www.google.com/search?q=%22%EC%9D%BC%EC%9D%B8%EC%9A%A9%20%EC%B1%85%22%20%EC%8B%A0%ED%95%B4%EC%9A%B1","lib":"https://www.data4library.kr/srch?srchText=9788996997900","millie":"https://www.millie.co.kr/v3/search/result/%EC%9D%BC%EC%9D%B8%EC%9A%A9%20%EC%B1%85","ridi":"https://ridibooks.com/search?q=%EC%9D%BC%EC%9D%B8%EC%9A%A9%20%EC%B1%85","welaaa":"https://www.welaaa.com/search?keyword=%EC%9D%BC%EC%9D%B8%EC%9A%A9%20%EC%B1%85","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788996997900","yes24":"https://www.yes24.com/product/search?query=9788996997900","elib":"https://www.google.com/search?q=%EC%9D%BC%EC%9D%B8%EC%9A%A9%20%EC%B1%85%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfa3222216":{"id":"bfa3222216","t":"친애하는 청춘에게","a":"김욱","tr":[],"pub":"비전코리아","y":"2014","isbn":"9788963220727","isbns":["9788963220727"],"cv":"https://image.yes24.com/goods/15158096/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788963220727.jpg","f":"문학","n":"한국","e":"현대","l":"쉽게","pg":"280","ot":"","intro":"사업 실패로 전 재산을 잃고 70세에 작가가 되어 15년 만에 200여 권의 번역서와 8권의 저서를 내놓은 85세 청년 김욱이 말하는 청춘 고백서. 흔들리는 2030대 청춘들에게 인생의 선배 자리에서 잔소리하기보다는 지금도 열심히 열정을 다하는 모습으로 동반 성장하는 친구가 되어주기 위해 저자는 이 책을 집필했다.\n\n청춘에게는 지금 이 순간을 잠깐 잊게 해주는 진통제가 아니라, 감기처럼 찾아오는 인생의 고민에 흔들리는 나를 꽉 잡아줄 든든한 보약이 필요하다. 저자 김욱은 50세라는 늦은 나이에 얻게 된, 이제 30대 중반인 하나밖에 없는 아들과 그의 친구들에게 든든한 등대가 되어주고자 이 책을 썼다. 기성세대의 잔소리가 아닌 뼈아픈 실패가 녹아든 경험으로 청춘들과 함께 아픔을 나누려 한다.","icut":false,"toc":"들어가는 말: 청춘, 그대는 무엇이 두려운가\nPart 1 친애하는 청춘에게\n가만히 앉아서 때를 잃지 마라\n상대의 바둑알이 더 커 보일지라도\n도표도 지도도 없는 세상에서\n내 인생의 창조주는 바로 나\n비타민보다 값진 햄버거\n잠든 청춘이여, 이제 잠에서 깨어나라\nPart 2 너희들 잘못이 아니야\n월급 이백만 원이 소원인 세상\n우리는 모두 목이 마르다\n누가 그들을 손가락질할 수 있을까?\n잠들지 않는 여성\n이 절망이 아름다운 이유\n프라이드가 낄 수 없는 사회\nPart 3 우리가 너희를 응원한다\n따라오는 건 미래가 아니다\n막다른 골목일지라도\n사랑은 꿈처럼 다가온다\n넘지 못할 담벼락은 없다\n이상해야 살아남으리라\n정상은 언제나 그 자리에 있다\nPart 4 도전이 너를 강하게 할지니\n미개발지역은 아프리카가 아닌 우리들 머릿속\n캔버스에서 뛰쳐나가라\n아들아, 너 자신을 포기하지 마라\n역경이 사람을 만든다\n성공의 끝에는 무엇이 있을까?\n경기에서 제대로 지는 법\nPart 5 청춘, 우리가 앞으로 걸어갈 길\n우리는 모두 똥차다\n내가 살아온 날들이 부끄럽지 않게\n인생에는 교통경찰이 없다\n청춘은 나이와 상관이 없다\n이왕지사 어려운 길을 택하라\n맺음말: 겨울을 나지 않은 푸른 봄은 없다","recs":[["munhak","2015"]],"shorts":["문학나눔"],"univ":[],"au":{"b":1992,"kw":"김욱","en":"Kim Wook"},"eb":[["YES24 eBook","https://www.yes24.com/product/goods/15172801"]],"full":{},"rel":[],"star":9.2,"y24":"https://www.yes24.com/product/goods/15158096","daum":"https://search.daum.net/search?w=bookpage&bookId=882064&q=%EC%B9%9C%EC%95%A0%ED%95%98%EB%8A%94+%EC%B2%AD%EC%B6%98%EC%97%90%EA%B2%8C","links":{"google":"https://www.google.com/search?q=%22%EC%B9%9C%EC%95%A0%ED%95%98%EB%8A%94%20%EC%B2%AD%EC%B6%98%EC%97%90%EA%B2%8C%22%20%EA%B9%80%EC%9A%B1","lib":"https://www.data4library.kr/srch?srchText=9788963220727","millie":"https://www.millie.co.kr/v3/search/result/%EC%B9%9C%EC%95%A0%ED%95%98%EB%8A%94%20%EC%B2%AD%EC%B6%98%EC%97%90%EA%B2%8C","ridi":"https://ridibooks.com/search?q=%EC%B9%9C%EC%95%A0%ED%95%98%EB%8A%94%20%EC%B2%AD%EC%B6%98%EC%97%90%EA%B2%8C","welaaa":"https://www.welaaa.com/search?keyword=%EC%B9%9C%EC%95%A0%ED%95%98%EB%8A%94%20%EC%B2%AD%EC%B6%98%EC%97%90%EA%B2%8C","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788963220727","yes24":"https://www.yes24.com/product/search?query=9788963220727","elib":"https://www.google.com/search?q=%EC%B9%9C%EC%95%A0%ED%95%98%EB%8A%94%20%EC%B2%AD%EC%B6%98%EC%97%90%EA%B2%8C%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfa01d0cbf":{"id":"bfa01d0cbf","t":"아름다움의 지성","a":"오길영","tr":[],"pub":"소명출판","y":"2020","isbn":"9791159055423","isbns":["9791159055423"],"cv":"https://image.yes24.com/goods/91125834/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9791159055423.jpg","f":"철학·사상","n":"한국","e":"미상","l":"어렵게","pg":"527","ot":"","intro":"오길영 평론가가 5년 만에 두 번째 평론집을 출간했다. 저자는 문학(비평)은 단지 감각이나 감성의 문제가 아니라 지성, 감각화된 지성의 표현이라고 본다. 그래서 이번 평론집의 키워드를 문학적 지성 혹은 감각적 지성으로 잡았다. 책 제목 『아름다움의 지성』은 그런 문제의식을 드러낸다. 『아름다움의 지성』은 4부로 구성되어 있다. 1부와 2부는 작품론, 작가론이다. 1부는 계간 『황해문화』에 써 온 문학평이다. 그때그때 주요하다고 여겨지는 작품과 쟁점을 다룬 글들이다. 2부는 계간문학 평과 별도로 쓴 작품론들을 묶었다. 3부는 문학 일반론으로 당시 제기됐던 문학적·문화적 쟁점들을 다뤘다. 4부는 이론비평, 문화론, 외국문학을 다룬 글들로 한국문학과의 접점을 찾고자 한 글들이다.","icut":false,"toc":"서문을 대신하여\n1부\n감각적 지성의 문학\n중견 작가에게 기대하는 것\n은희경 『빛의 과거』와 올가 토카르추크 『태고의 시간들』\n합당한 수상작인가?\n김세희 『가만한 나날』과 이소호 『캣콜링』\n비평과 사유의 훈련\n김종철 『대지의 상상력』과 황규관 『리얼리스트 김수영』\n견인주의자들의 세계\n최은영 『내게 무해한 사람』과 황정은 『디디의 우산』\n시와 감각적 지성\n김해자 『해자네 점집』, 이종형 『꽃보다 먼저 다녀간 이름들』, 쉼보르스카 『충분하다』\n에세이와 지성\n신영복 『감옥으로부터의 사색』\n페미니즘소설의 몇 가지 양상\n조남주 『82년생 김지영』, 강화길 『다른 사람』, 김혜진 『딸에 대하여』\n미투와 낭만적 정념\n변화의 기미, 남는 아쉬움\n무라카미 하루키 『기사단장 죽이기』\n세월호 문학의 (불)가능성\n김탁환 『거짓말이다』, 『아름다운 그이는 사람이어라』, 김영하 「아이를 찾습니다」\n한국문학의 경계\n김석범 『화산도』와 W.G. 제발트 『이민자들』, 『아우스터리츠』\n문학적 지성이란 무엇인가?\n이인휘 『폐허를 보다』, 백수린 『참담한 빛』, 최은영 『쇼코의 미소』\n2부\n소설과 영화의 시각\n‘삶의 생기’를 다루는 법\n오선영 『모두의 내력』\n영웅, 괴물, 그리고 시민들\n영화 [덩케르크], [군함도], [남한산성], [택시운전사], 황정은 『계속해보겠습니다』\n두 여성 작가의 시각\n조해진 『빛의 호위』와 황정은 『일곱시 삼십이분 코끼리열차』\n악을 장악할 수 있는가?\n정유정 『종의 기원』\n역사소설가의 외로움\n김탁환 『목격자들』\n비극적 삶의 기억\n정영진 『바람이여 전하라』\n3부 작가와 세계\n총체적 인격과 작품\n미당과 마광수의 사례\n‘광장 이후’를 상상한다\n김해자, 백무산의 시를 읽으며\n문학과 (상징)권력\n성추문, 블랙리스트 논란 등을 보면서\n(포스트)모던과 아방가르드의 가능성\n비평적 공론장과 SNS\n작가는 국가대표가 아니다\n한강의 ‘맨부커 인터내셔널상’ 수상\n국립한국문학관, 우리가 잊고 있는 것들\n한국문학의 아픈 징후들\n표절과 문학권력 논란에 대하여\n4부 근본을 사유하기\n근본을 사유하기\n김종철 『근대문명에서 생태문명으로』\n문학예술과 현실의 관계\n들뢰즈와 (포스트)미메시스\n문화는 정말 일상적인가?\n여건종 『일상적 삶의 상징적 생산』\n일상의 혁명과 상황주의\n라울 바네겜 『일상생활의 혁명』\n다시, 맑스를 위하여\n루이 알튀세르 『마르크스를 위하여』와 백승욱 『생각하는 마르크스』\n맑스주의 비평의 한 초상\n테리 이글턴 『비평가의 임무』\n텍스트란 무엇인가?\n제임슨, 이글턴, 사이드를 중심으로\n월트 휘트먼, 힘의 시인\n민족문화와 민족언어\n조이스를 중심으로\n시인이 읽은 프루스트\n이성복 『프루스트와 지드에서의 사랑이라는 환상』","recs":[["munhak","2020"]],"shorts":["문학나눔"],"univ":[],"au":{},"eb":[],"full":{},"rel":[],"star":0,"y24":"https://www.yes24.com/product/goods/91125834","daum":"https://search.daum.net/search?w=bookpage&bookId=5419623&q=%EC%95%84%EB%A6%84%EB%8B%A4%EC%9B%80%EC%9D%98+%EC%A7%80%EC%84%B1","links":{"google":"https://www.google.com/search?q=%22%EC%95%84%EB%A6%84%EB%8B%A4%EC%9B%80%EC%9D%98%20%EC%A7%80%EC%84%B1%22%20%EC%98%A4%EA%B8%B8%EC%98%81","lib":"https://www.data4library.kr/srch?srchText=9791159055423","millie":"https://www.millie.co.kr/v3/search/result/%EC%95%84%EB%A6%84%EB%8B%A4%EC%9B%80%EC%9D%98%20%EC%A7%80%EC%84%B1","ridi":"https://ridibooks.com/search?q=%EC%95%84%EB%A6%84%EB%8B%A4%EC%9B%80%EC%9D%98%20%EC%A7%80%EC%84%B1","welaaa":"https://www.welaaa.com/search?keyword=%EC%95%84%EB%A6%84%EB%8B%A4%EC%9B%80%EC%9D%98%20%EC%A7%80%EC%84%B1","kyobo":"https://search.kyobobook.co.kr/search?keyword=9791159055423","yes24":"https://www.yes24.com/product/search?query=9791159055423","elib":"https://www.google.com/search?q=%EC%95%84%EB%A6%84%EB%8B%A4%EC%9B%80%EC%9D%98%20%EC%A7%80%EC%84%B1%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfa4c6cae9":{"id":"bfa4c6cae9","t":"문학과 진보","a":"최원식","tr":[],"pub":"창비","y":"2018","isbn":"9788936463502","isbns":["9788936463502"],"cv":"https://image.yes24.com/goods/64094581/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788936463502.jpg","f":"철학·사상","n":"한국","e":"현대","l":"보통","pg":"424","ot":"","intro":"“문학성의 극진한 드러남이 최고의 정치성 그 자체로 되는 그런 문학이야말로\n다른 평화 또는 다른 세상을 여는 운하가 될지도 모릅니다.”\n\n다른 세상을 여는 우리 문학과 진보의 새길을 찾아서\n비평이력 46년, 여전히 뜨거운 쟁점과 예리한 통찰을 던진다!\n\n『문학과 진보』는 2001년 출간된 평론집 『문학의 귀환』 이후 2003년부터 2017년까지 발표한 글을 모은 것으로, 이 책에는 1990년대를 통과한 한국문학의 얼굴과, 새로운 2000년대를 맞은 변화의 현장이 담겨있다. 저자는 “읽을 것은 많고 시간은 많지 않다”며 『문학과 진보』를 마지막 평론집으로 내놓는다. “그동안 나의 허튼소리를 허용해준 모든 문인들께 최고의 경의”(책머리에)를 보낸다는 저자의 겸손과는 달리 오히려 그에게 한국문단이 진 빚이 적지 않다.\n\n새 시대, 새로운 문학을 기다리는 독자들에게 이 책은 한국과 한국문학의 과거가 담긴 소중한 기록으로 남을 것이다.","icut":false,"toc":"책머리에\n제1부/ 열쇳말들\n문학과 진보\n우리 시대 비평의 몫?\n다시 찾아온 토론의 시대-『해방전후사의 재인식』을 읽고\n친일문제에 접근하는 다른 길-용서를 위하여\n민(民)의 자치\n제2부/ 한국소설의 지평\n민족문학과 디아스포라-해외동포들의 작품을 읽고\n민주적 사회주의자의 길-『김학철 전집』 발간에 부쳐\n남과 북의 새로운 역사감각들-김영하의 『검은 꽃』과 홍석중의 『황진이』\n초원민주주의와 유목제국주의-김형수의 『조드-가난한 성자들』\n도시를 구할 묘약(妙藥)은?\n노동문학의 오늘-이인휘의 『폐허를 보다』\n리얼리즘의 임계점-『아들의 아버지-아버지의 시대, 아들의 유년』과 『밤의 눈』\n우리 시대 한국문학의 두 촉-한강과 권여선\n제3부/ 시와 정치\n자력갱생의 시학\n농업적 상상력의 골독한 산책-이시영 『하동』\n하산(下山)하는 마음-신대철 『누구인지 몰라도 그대를 사랑한다』\n시와 정치-도종환 『사월 바다』\n중(中)문자 시-김사인 『어린 당나귀 곁에서』\n바다가 가난한 나라의 시-이세기 『먹염바다』\n시를 기다리며\n제4부/ 동아시아문학이라는 퍼즐\n동아시아국제주의의 이상과 현실-국제(國際)와 민제(民際)\n다시 살아난 불씨\n동아시아문학의 현재/미래\n문자공화국의 꿈\n요산 김정한 문학과 동아시아\n중국 여성 작가의 눈에 비친 위안부-딩링의 「내가 안개마을에 있을 때」\n문학 이후의 문학\n발표지면 / 찾아보기","recs":[["munhak","2018"]],"shorts":["문학나눔"],"univ":[],"au":{"b":1963,"kw":"최원식 (1963년)","en":"Choe Wonsik"},"eb":[["YES24 eBook","https://www.yes24.com/product/goods/176968867"]],"full":{},"rel":[],"star":10,"y24":"https://www.yes24.com/product/goods/64094581","daum":"https://search.daum.net/search?w=bookpage&bookId=3750535&q=%EB%AC%B8%ED%95%99%EA%B3%BC+%EC%A7%84%EB%B3%B4","links":{"google":"https://www.google.com/search?q=%22%EB%AC%B8%ED%95%99%EA%B3%BC%20%EC%A7%84%EB%B3%B4%22%20%EC%B5%9C%EC%9B%90%EC%8B%9D","lib":"https://www.data4library.kr/srch?srchText=9788936463502","millie":"https://www.millie.co.kr/v3/search/result/%EB%AC%B8%ED%95%99%EA%B3%BC%20%EC%A7%84%EB%B3%B4","ridi":"https://ridibooks.com/search?q=%EB%AC%B8%ED%95%99%EA%B3%BC%20%EC%A7%84%EB%B3%B4","welaaa":"https://www.welaaa.com/search?keyword=%EB%AC%B8%ED%95%99%EA%B3%BC%20%EC%A7%84%EB%B3%B4","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788936463502","yes24":"https://www.yes24.com/product/search?query=9788936463502","elib":"https://www.google.com/search?q=%EB%AC%B8%ED%95%99%EA%B3%BC%20%EC%A7%84%EB%B3%B4%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfadc8011a":{"id":"bfadc8011a","t":"팡 터트리려고","a":"랄라","tr":[],"pub":"초록달팽이","y":"2025","isbn":"9791193400340","isbns":["9791193400340"],"cv":"https://image.yes24.com/goods/161975840/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9791193400340.jpg","f":"언어·교양","n":"영미","e":"현대","l":"쉽게","pg":"104","ot":"","intro":"시인 랄라와 함께 떠나는\n즐거움과 재미로 가득한 동심의 세계\n\n2022년 부산아동문학신인상과 혜암아동문학상, 2025년 한국안데르센 창작동시 우수상을 수상한 랄라 시인의 첫 동시집입니다. 아이들과 놀고 싶어서 동시를 쓴다는 시인의 말처럼 발랄하고 즐겁고 신나는 내용의 작품이 가득합니다. 해학과 익살 넘치는 그림으로 정평이 나 있는 김순영 작가의 삽화가 더해져 읽는 즐거움이 두 배가 됩니다.","icut":false,"toc":"1부 우리는 친구\n친구 계산법 16 | 화해 17 | 너는 어때? 18 | 좋아! 20 | 막춤 22 | 눈맞춤 25 |마스크 벗은 날 26 | 어머! 27 | 아님 말고 28 | 왜 하필 양말이니? 30 | 뛸까? 말까? 31\n2부 딴딴하게, 나답게\n딴 34 | 난 바다도 사랑하는 아이야 36| 난 빨강 38 | 난 빨강2 40 | 그게 나래요 41 | 웅덩이 42 | 잘했어 44 | 매듭 46 | 해야 안다 47 | 오답이 정답 48\n3부 사랑하는 방법? 사랑받는 방법\n내 동생 52 | 잘 찾는 법 53 | 사랑받는 방법 54 | 엄마는 청개구리 56 | 그랬으면 좋겠다 58 | 괜찮다 60 | 자기야 62 | 아빠 몰랐지? 64 | 할머니의 혼잣말 65 | 이유가 있어 66\n4부 팡 터트리려고\n산 위의 산 71 | 다 왔다 72 | 겨울 진달래 73 | 별똥별 74 | 호박벌 76 | 도라지꽃 77 | 모르나 보다 78 | 걱정이 걱정을 낳는 밤 80 | 단풍잎 81 | 달달한 달 82\n5부 뻥은 뻥 차버려!\n놀이터 학교 86 | 거짓말 88 | 보름달 90 | I can't 91 | 머리vs대가리 92 | 예쁜 눈 94 | 울어도 돼 (울면 안 돼 new version) 96 | 파이프후드 97 | 와! 98 | 양말은 숨기 대장 100","recs":[["munhak","2026"]],"shorts":["문학나눔"],"univ":[],"au":{"b":1951,"en":"Lalla Ward"},"eb":[],"full":{},"rel":[],"star":9.9,"y24":"https://www.yes24.com/product/goods/161975840","daum":"https://search.daum.net/search?w=bookpage&bookId=7060745&q=%ED%8C%A1+%ED%84%B0%ED%8A%B8%EB%A6%AC%EB%A0%A4%EA%B3%A0","links":{"google":"https://www.google.com/search?q=%22%ED%8C%A1%20%ED%84%B0%ED%8A%B8%EB%A6%AC%EB%A0%A4%EA%B3%A0%22%20%EB%9E%84%EB%9D%BC","lib":"https://www.data4library.kr/srch?srchText=9791193400340","millie":"https://www.millie.co.kr/v3/search/result/%ED%8C%A1%20%ED%84%B0%ED%8A%B8%EB%A6%AC%EB%A0%A4%EA%B3%A0","ridi":"https://ridibooks.com/search?q=%ED%8C%A1%20%ED%84%B0%ED%8A%B8%EB%A6%AC%EB%A0%A4%EA%B3%A0","welaaa":"https://www.welaaa.com/search?keyword=%ED%8C%A1%20%ED%84%B0%ED%8A%B8%EB%A6%AC%EB%A0%A4%EA%B3%A0","kyobo":"https://search.kyobobook.co.kr/search?keyword=9791193400340","yes24":"https://www.yes24.com/product/search?query=9791193400340","elib":"https://www.google.com/search?q=%ED%8C%A1%20%ED%84%B0%ED%8A%B8%EB%A6%AC%EB%A0%A4%EA%B3%A0%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfa983732c":{"id":"bfa983732c","t":"네보의 푸른 책","a":"마논 스테판 로스","tr":["강나은"],"pub":"다산책방","y":"2024","isbn":"9791130671062","isbns":["9791130671062"],"cv":"https://image.yes24.com/goods/140246104/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9791130671062.jpg","f":"언어·교양","n":"미상","e":"미상","l":"쉽게","pg":"200","ot":"The Blue Book of Nebo","intro":"2023 카네기메달 수상작 나민애 서울대 교수 강력 추천 『리버보이』 이후 다시 전 세계가 주목하는 성장소설의 탄생 세계에서 가장 권위 있는 청소년문학상인 카네기메달의 2023년 수상작 『네보의 푸른 책』이 출간되었다. 번역서가 수상작으로 선정된 것은 카네기메달 87년 역사상 최초이며, 수상 발표 즉시 12개국에 판권이 계약되면서 세계인의 주목을 받는 성장소설로 자리매김했다. 핵폭발이라는 대재앙적 사건 이후 웨일스의 외딴 마을 ‘네보’에 남겨진 엄마와 아들의 치열하고도 아름다운 생존기를 그린 작품으로, 절망과 희망 사이의 내밀한 감정선이 두 사람의 일기 형식으로 펼쳐진다. 살아가기 위한 고군분투뿐만 아니라 살아온 시간을 기록하는 모습을 통해 몸소 일구고 느끼며 기억하는 진정한 삶의 방식을 생각해 보게 하는 작품이다.","icut":false,"toc":"","recs":[["munhak","2025"]],"shorts":["문학나눔"],"univ":[],"au":{},"eb":[["YES24 eBook","https://www.yes24.com/product/goods/141219926"]],"full":{},"rel":[],"star":9.5,"y24":"https://www.yes24.com/product/goods/140246104","daum":"https://search.daum.net/search?w=bookpage&bookId=6800772&q=%EB%84%A4%EB%B3%B4%EC%9D%98+%ED%91%B8%EB%A5%B8+%EC%B1%85","links":{"google":"https://www.google.com/search?q=%22%EB%84%A4%EB%B3%B4%EC%9D%98%20%ED%91%B8%EB%A5%B8%20%EC%B1%85%22%20%EB%A7%88%EB%85%BC%20%EC%8A%A4%ED%85%8C%ED%8C%90%20%EB%A1%9C%EC%8A%A4","lib":"https://www.data4library.kr/srch?srchText=9791130671062","millie":"https://www.millie.co.kr/v3/search/result/%EB%84%A4%EB%B3%B4%EC%9D%98%20%ED%91%B8%EB%A5%B8%20%EC%B1%85","ridi":"https://ridibooks.com/search?q=%EB%84%A4%EB%B3%B4%EC%9D%98%20%ED%91%B8%EB%A5%B8%20%EC%B1%85","welaaa":"https://www.welaaa.com/search?keyword=%EB%84%A4%EB%B3%B4%EC%9D%98%20%ED%91%B8%EB%A5%B8%20%EC%B1%85","kyobo":"https://search.kyobobook.co.kr/search?keyword=9791130671062","yes24":"https://www.yes24.com/product/search?query=9791130671062","elib":"https://www.google.com/search?q=%EB%84%A4%EB%B3%B4%EC%9D%98%20%ED%91%B8%EB%A5%B8%20%EC%B1%85%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfa397346b":{"id":"bfa397346b","t":"아가미 소년","a":"우설리","tr":[],"pub":"이지북","y":"2024","isbn":"9791193914335","isbns":["9791193914335"],"cv":"https://image.yes24.com/goods/133818376/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9791193914335.jpg","f":"언어·교양","n":"한국","e":"미상","l":"쉽게","pg":"192","ot":"","intro":"예측할 수 없는 디스토피아 세계에서\n블루 패드 유일의 아가미족 카이가 생존을 위해 앞장선다!\n\n제2회 이지북 초록별 샤미 SF환경동화상 우수상을 받은 『아가미 소년』이 이지북 SFF 환경 동화 시리즈 〈초록별 샤미〉의 아홉 번째 장편 동화로 출간되었다. 김태호 작가, 최배은 평론가가 심사 위원으로 참여했고, 다양한 각도로 바라보며 고민한 끝에 『아가미 소년』을 우수작으로 선정했다. 『아가미 소년』은 그동안 어린이 논픽션을 출간해 온 우설리 작가의 첫 번째 동화 작품이다. 작가는 블루 패드와 펄 패드라는 살아남은 인공 섬에서 힘들게 살아가는 사람들의 미래 이야기를 아가미족이라는 변종인 주인공의 시각에서 흥미롭게 그려 냈다. 환경 및 기후 문제는 물론, 이해관계를 달리하며 서로 소통하기보다 싸움을 통해 상대를 제압하려는 어른들을, 아이들의 시선으로 바라보며 그들을 화해시킬 수 있는 방향으로 이끈다.","icut":false,"toc":"1. 조금 다른 아이\n2. 바다 블랙홀\n3. 새끼 고래\n4. 검은 그림자\n5. 억울한 누명\n6. 뗏목 사건\n7. 외톨이\n8. 또 다른 변종인\n9. 두근대는 심장\n10. 바다 폭풍\n11. 진짜 도둑\n12. 아빠의 지도\n13. 거대한 통조림\n14. 작전 준비\n15. 결전의 날\n16. 노란 드럼통의 실체\n17. 내게 필요한 것\n18. 모두 함께\n19. 그 누구보다 더\n20. 남은 숙제\n작가의 말","recs":[["munhak","2025"]],"shorts":["문학나눔"],"univ":[],"au":{},"eb":[],"full":{},"rel":[],"star":9.7,"y24":"https://www.yes24.com/product/goods/133818376","daum":"https://search.daum.net/search?w=bookpage&bookId=6732673&q=%EC%95%84%EA%B0%80%EB%AF%B8+%EC%86%8C%EB%85%84","links":{"google":"https://www.google.com/search?q=%22%EC%95%84%EA%B0%80%EB%AF%B8%20%EC%86%8C%EB%85%84%22%20%EC%9A%B0%EC%84%A4%EB%A6%AC","lib":"https://www.data4library.kr/srch?srchText=9791193914335","millie":"https://www.millie.co.kr/v3/search/result/%EC%95%84%EA%B0%80%EB%AF%B8%20%EC%86%8C%EB%85%84","ridi":"https://ridibooks.com/search?q=%EC%95%84%EA%B0%80%EB%AF%B8%20%EC%86%8C%EB%85%84","welaaa":"https://www.welaaa.com/search?keyword=%EC%95%84%EA%B0%80%EB%AF%B8%20%EC%86%8C%EB%85%84","kyobo":"https://search.kyobobook.co.kr/search?keyword=9791193914335","yes24":"https://www.yes24.com/product/search?query=9791193914335","elib":"https://www.google.com/search?q=%EC%95%84%EA%B0%80%EB%AF%B8%20%EC%86%8C%EB%85%84%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfa8eb885d":{"id":"bfa8eb885d","t":"아이가 여행 가","a":"김태호","tr":[],"pub":"마루비","y":"2023","isbn":"9791191917369","isbns":["9791191917369"],"cv":"https://image.yes24.com/goods/118218389/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9791191917369.jpg","f":"언어·교양","n":"한국","e":"현대","l":"쉽게","pg":"128","ot":"","intro":"“시간은 아이들이 원하는 곳까지 천천히 거꾸로 흘러갔다.”\n\n『네모 돼지』 『제후의 선택』 『신호등 특공대』에 이은\n김태호 작가의 또 다른 화제작, 『아이가 여행 가』 출간!\n\n폭력과 학대, 편견과 왕따 앞에서도\n존엄과 용기를 잃지 않는 이 땅의 어린이들에게 바치는\n김태호 작가의 날카롭고 따뜻한 위로와 포용의 메시지!\n\n단편동화 「기다려!」로 제5회 창비어린이 신인문학상을 수상하며 발표한 동화집 『네모 돼지』와 제17회 문학동네어린이문학상 대상 수상작 『제후의 선택』을 비롯하여 새 작품이 출간될 때마다 국내 어린이문학계에 신선하고 강렬한 메시지를 던져 온 김태호 작가의 신작 동화집 『아이가 여행 가』가 마루비 어린이문학 15번째 작품으로 출간되었습니다.","icut":false,"toc":"걸리버의 꿈 _ 9\n아이가 여행 가 _ 33\n집 짓는 아이 _ 57\n알도 _ 83\n자전거가 된 아이들 _ 107\n작가의 말 _ 126","recs":[["munhak","2023"]],"shorts":["문학나눔"],"univ":[],"au":{"b":1962,"kw":"김태호 (1962년)","en":"Kim Tae-ho"},"eb":[["YES24 eBook","https://www.yes24.com/product/goods/123705940"]],"full":{},"rel":[],"star":10,"y24":"https://www.yes24.com/product/goods/118218389","daum":"https://search.daum.net/search?w=bookpage&bookId=6322556&q=%EC%95%84%EC%9D%B4%EA%B0%80+%EC%97%AC%ED%96%89+%EA%B0%80","links":{"google":"https://www.google.com/search?q=%22%EC%95%84%EC%9D%B4%EA%B0%80%20%EC%97%AC%ED%96%89%20%EA%B0%80%22%20%EA%B9%80%ED%83%9C%ED%98%B8","lib":"https://www.data4library.kr/srch?srchText=9791191917369","millie":"https://www.millie.co.kr/v3/search/result/%EC%95%84%EC%9D%B4%EA%B0%80%20%EC%97%AC%ED%96%89%20%EA%B0%80","ridi":"https://ridibooks.com/search?q=%EC%95%84%EC%9D%B4%EA%B0%80%20%EC%97%AC%ED%96%89%20%EA%B0%80","welaaa":"https://www.welaaa.com/search?keyword=%EC%95%84%EC%9D%B4%EA%B0%80%20%EC%97%AC%ED%96%89%20%EA%B0%80","kyobo":"https://search.kyobobook.co.kr/search?keyword=9791191917369","yes24":"https://www.yes24.com/product/search?query=9791191917369","elib":"https://www.google.com/search?q=%EC%95%84%EC%9D%B4%EA%B0%80%20%EC%97%AC%ED%96%89%20%EA%B0%80%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfa8a95de2":{"id":"bfa8a95de2","t":"바람을 달리는 아이들","a":"신지영","tr":[],"pub":"서유재","y":"2021","isbn":"9791189034368","isbns":["9791189034368"],"cv":"https://image.yes24.com/goods/96836229/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9791189034368.jpg","f":"언어·교양","n":"한국","e":"현대","l":"쉽게","pg":"144","ot":"","intro":"“새로운 바람이 될 거야!”\n명성 황후 시해 사건과 아관 파천의 소용돌이 속,\n한 소년과 소녀의 꿈을 향한 도전과 우정\n\n소년 복남과 소녀 윤의 시선으로 개화기 조선을 그린 역사 동화. 복남은 비록 마을의 노비인 고지기의 자식으로 태어났지만 불평등한 신분제를 벗어나 자신의 삶을 주체적으로 살고자 노력한다. 어느 날, 황실과 관련한 중요한 서신을 전하는 심부름을 우연히 맡게 되면서 자신의 꿈을 향한 도전에 더욱 용기를 얻게 되고 마침내 수방도가의 물지게 대회에 참가하러 길을 떠난다. 한편 윤은 한양에서도 내로라하는 집안인 김 대감의 딸로 이화 학당에 다니고 싶지만 완고한 아버지는 허락하지 않는다. 어떻게 하든 공부가 하고 싶은 윤은 아버지와 대립하고 그런 윤을 뜻밖에도 어머니가 응원한다. 앞뒤로 뒤집어 읽으면서 복남과 윤이 어떻게 스치고 만나며 서로 영향을 주고받는지 찾아보는 재미까지 더한 신지영의 역사 동화.","icut":false,"toc":"[복남의 이야기]\n친구야, 나와 함께 달리자!\n동네에서 제일 빠른 아이\n하루면 됩니다!\n진짜 불쌍한 사람\n오늘부터 이복남!\n휘는 가지의 힘으로\n[윤의 이야기]\n새로운 바람이 될 거야!\n덕이네 사당패\n뜻밖의 심부름\n수방도가에서 만난 아이\n남의 힘은 남의 힘\n장옷을 벗고","recs":[["munhak","2021"]],"shorts":["문학나눔"],"univ":[],"au":{"b":1967,"kw":"신지영 (언어학자)","en":"Shin Ji-young"},"eb":[],"full":{},"rel":[],"star":10,"y24":"https://www.yes24.com/product/goods/96836229","daum":"https://search.daum.net/search?w=bookpage&bookId=5568335&q=%EB%B0%94%EB%9E%8C%EC%9D%84+%EB%8B%AC%EB%A6%AC%EB%8A%94+%EC%95%84%EC%9D%B4%EB%93%A4","links":{"google":"https://www.google.com/search?q=%22%EB%B0%94%EB%9E%8C%EC%9D%84%20%EB%8B%AC%EB%A6%AC%EB%8A%94%20%EC%95%84%EC%9D%B4%EB%93%A4%22%20%EC%8B%A0%EC%A7%80%EC%98%81","lib":"https://www.data4library.kr/srch?srchText=9791189034368","millie":"https://www.millie.co.kr/v3/search/result/%EB%B0%94%EB%9E%8C%EC%9D%84%20%EB%8B%AC%EB%A6%AC%EB%8A%94%20%EC%95%84%EC%9D%B4%EB%93%A4","ridi":"https://ridibooks.com/search?q=%EB%B0%94%EB%9E%8C%EC%9D%84%20%EB%8B%AC%EB%A6%AC%EB%8A%94%20%EC%95%84%EC%9D%B4%EB%93%A4","welaaa":"https://www.welaaa.com/search?keyword=%EB%B0%94%EB%9E%8C%EC%9D%84%20%EB%8B%AC%EB%A6%AC%EB%8A%94%20%EC%95%84%EC%9D%B4%EB%93%A4","kyobo":"https://search.kyobobook.co.kr/search?keyword=9791189034368","yes24":"https://www.yes24.com/product/search?query=9791189034368","elib":"https://www.google.com/search?q=%EB%B0%94%EB%9E%8C%EC%9D%84%20%EB%8B%AC%EB%A6%AC%EB%8A%94%20%EC%95%84%EC%9D%B4%EB%93%A4%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfaa9cf761":{"id":"bfaa9cf761","t":"귤의 맛","a":"조남주","tr":[],"pub":"문학동네","y":"2020","isbn":"9788954671989","isbns":["9788954671989"],"cv":"https://image.yes24.com/goods/90300486/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788954671989.jpg","f":"언어·교양","n":"한국","e":"현대","l":"쉽게","pg":"208","ot":"","intro":"우리 모두가 지나온 초록의 시간 버겁고 외롭지만 함께라서 가능했던 그날의 이야기들 『귤의 맛』은 『82년생 김지영』으로 차이와 차별의 담론을 폭발적으로 확장시키며 사회적 반향을 불러일으킨 조남주 작가의 신작 장편소설이다. ‘누가 내 얘기를 여기에 쓴 거지 ’라고 할 만큼 한 개인에게서 공감의 서사를 예민하게 끌어내는 그가 이번엔 미열과 고열을 오가며 초록의 시간을 지나는 한 알 한 알의 존재에게 시선을 맞춘다. 숱한 햇볕과 바람을 들이고 맞으며 맛과 향을 채워 나가는 귤 같은 너와 나의 이야기. 사춘기나 과도기로 명명되는 시기를 쉽게 규정하지 않고, “어차피 지나갈 일, 별것 아닌 일, 누구나 겪는 과정으로 폄하하지 않고 그 자체의 무게와 의미로 바라보고 싶어 한” 작가의 다정한 응시가 담겨 있다.","icut":false,"toc":"고등학교 입학식\n다윤의 이야기\n소란의 이야기\n해인의 이야기\n은지의 이야기\n우리가 가까워지는 동안]\n우리가 가장 친했을 때\n다시, 은지의 이야기\n다시, 해인의 이야기\n다시, 다윤의 이야기\n다시, 소란의 이야기\n에필로그\n작가의 말","recs":[["munhak","2020"]],"shorts":["문학나눔"],"univ":[],"au":{"b":1978,"kw":"조남주","en":"Cho Nam-joo"},"eb":[["YES24 eBook","https://www.yes24.com/product/goods/90451510"]],"full":{},"rel":[],"star":8.9,"y24":"https://www.yes24.com/product/goods/90300486","daum":"https://search.daum.net/search?w=bookpage&bookId=5372435&q=%EA%B7%A4%EC%9D%98+%EB%A7%9B","links":{"google":"https://www.google.com/search?q=%22%EA%B7%A4%EC%9D%98%20%EB%A7%9B%22%20%EC%A1%B0%EB%82%A8%EC%A3%BC","lib":"https://www.data4library.kr/srch?srchText=9788954671989","millie":"https://www.millie.co.kr/v3/search/result/%EA%B7%A4%EC%9D%98%20%EB%A7%9B","ridi":"https://ridibooks.com/search?q=%EA%B7%A4%EC%9D%98%20%EB%A7%9B","welaaa":"https://www.welaaa.com/search?keyword=%EA%B7%A4%EC%9D%98%20%EB%A7%9B","kyobo":"https://search.kyobobook.co.kr/search?keyword=9788954671989","yes24":"https://www.yes24.com/product/search?query=9788954671989","elib":"https://www.google.com/search?q=%EA%B7%A4%EC%9D%98%20%EB%A7%9B%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfaa08d404":{"id":"bfaa08d404","t":"집으로 가는 23가지 방법","a":"김혜진","tr":[],"pub":"서유재","y":"2020","isbn":"9791189034245","isbns":["9791189034245"],"cv":"https://image.yes24.com/goods/86188946/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9791189034245.jpg","f":"언어·교양","n":"한국","e":"현대","l":"쉽게","pg":"188","ot":"","intro":"“모두가 기대하고 살면 되지 않을까? 기대하는 만큼 서로 해 주면 되잖아.”\n소중한 사람들과 함께하는 시간으로 들어가는 23가지 방법\n\n불안정한 십 대의 마음을 섬세하게 그려내 온 김혜진 작가의 신작 장편소설. 가족 중에 아픈 사람이 있다는 것, 죽음의 그림자가 도사린 일상을 함께하는 것은 모두를 외롭게 한다. 언제나 서로의 기색을 살피고 배려하면서 정작 자신의 마음은 들여다볼 엄두를 내지 못하는 가족이 기꺼이 의기투합하는 순간은, 가족 모두의 취미생활이기도 한 ‘길’을 찾을 때와 언니를 병원에 입원시킬 때다. 구글 어스와 내비와 여행자안내소의 지도를 통해 미드와 영드의 배경 속으로 들어가 보고 주말 경조사의 좌표를 확인하는 동안 서로의 안녕에 눈을 맞추는 풍경이 작가 특유의 속삭이듯 담담한 문체와 어우러지면서 천천히, 그러나 깊게 마음을 흔든다.","icut":false,"toc":"집으로 가는 23가지 방법 7\n글쓴이의 말 185","recs":[["munhak","2020"]],"shorts":["문학나눔"],"univ":[],"au":{"b":1975,"kw":"김혜진 (1975년)","en":"Kim Li-won"},"eb":[["YES24 eBook","https://www.yes24.com/product/goods/128642870"]],"full":{},"rel":[],"star":9.3,"y24":"https://www.yes24.com/product/goods/86188946","daum":"https://search.daum.net/search?w=bookpage&bookId=5218028&q=%EC%A7%91%EC%9C%BC%EB%A1%9C+%EA%B0%80%EB%8A%94+23%EA%B0%80%EC%A7%80+%EB%B0%A9%EB%B2%95","links":{"google":"https://www.google.com/search?q=%22%EC%A7%91%EC%9C%BC%EB%A1%9C%20%EA%B0%80%EB%8A%94%2023%EA%B0%80%EC%A7%80%20%EB%B0%A9%EB%B2%95%22%20%EA%B9%80%ED%98%9C%EC%A7%84","lib":"https://www.data4library.kr/srch?srchText=9791189034245","millie":"https://www.millie.co.kr/v3/search/result/%EC%A7%91%EC%9C%BC%EB%A1%9C%20%EA%B0%80%EB%8A%94%2023%EA%B0%80%EC%A7%80%20%EB%B0%A9%EB%B2%95","ridi":"https://ridibooks.com/search?q=%EC%A7%91%EC%9C%BC%EB%A1%9C%20%EA%B0%80%EB%8A%94%2023%EA%B0%80%EC%A7%80%20%EB%B0%A9%EB%B2%95","welaaa":"https://www.welaaa.com/search?keyword=%EC%A7%91%EC%9C%BC%EB%A1%9C%20%EA%B0%80%EB%8A%94%2023%EA%B0%80%EC%A7%80%20%EB%B0%A9%EB%B2%95","kyobo":"https://search.kyobobook.co.kr/search?keyword=9791189034245","yes24":"https://www.yes24.com/product/search?query=9791189034245","elib":"https://www.google.com/search?q=%EC%A7%91%EC%9C%BC%EB%A1%9C%20%EA%B0%80%EB%8A%94%2023%EA%B0%80%EC%A7%80%20%EB%B0%A9%EB%B2%95%20%EC%A0%84%EC%9E%90%EC%B1%85%20%EB%8F%84%EC%84%9C%EA%B4%80"}},"bfaf263f1d":{"id":"bfaf263f1d","t":"노란 달이 뜰 거야","a":"전주영","tr":[],"pub":"이야기꽃","y":"2016","isbn":"9788998751159","isbns":["9788998751159"],"cv":"https://image.yes24.com/goods/25779469/L","cv2":"https://contents.kyobobook.co.kr/sih/fit-in/300x0/pdt/9788998751159.jpg","f":"언어·교양","n":"한국","e":"미상","l":"쉽게","pg":"32","ot":"","intro":"상실의 아픔을 겪고 있는 이들에게 조심스레 전하는 그 방식의 모색이며 작지만 간절한 위로의 메시지를 담은 그림책입니다. 책 속의 아이는 돌아오지 않는 아빠를 기다리고 있습니다. 아이는 그리움을 담아 나비를 그리는데, 어느 순간 나비는 그림 속에서 나와 날아오릅니다. 식구를 닮은 인형들, 소박한 책장, 가족사진, 거울과 우산… 집안 이곳 저곳에 잠시 머물던 나비는 이윽고 열린 창문 틈으로 날아가고 아이는 나비를 따라갑니다. 가난한 산동네 골목골목, 나비가 들르는 곳은 아이와 아빠가 함께했던 기억의 장소들 입니다. 별꽃이 핀 담장 아래, 엄마 몰래 아이스크림을 사 먹던 구멍가게 앞, 가위바위보 놀이를 하던 층계참, 서툰 낙서를 하던 담장 길… 머무는 곳마다 아이는 기억을 떠올립니다. 끝없는 언덕길, 아이가 지치면 아빠는 손을 잡아 주었습니다. “우리 동네가 얼마나 높은지, 한번 끝까지 올라가 보자.” 힘들어 할 땐 아빠가 업어 주었습니다.","icut":false,"toc":"","recs":[["munhak","2016"]],"shorts":["문학나눔"],"univ":[],"au":{"en":"Jeon Joo-young"},"eb":[["YES24 eBook","https://www.yes24.com/product/goods/128928782"]],"full":{},"rel":[],"star":9.3,"y24":"https://www.yes24.com/product/goods/25779469","daum":"https://search.daum.net/search?w=bookpage&bookId=1502832&q=%EB%85%B8%EB%9E%80+%EB%8B%AC%EC%9D%B4+%EB%9C%B0+%EA%B1%B0%EC%95%BC","links":{"google":"https://www.google.com/search?q=%22%EB%85%B8%EB%9E%80%20%EB%8B%AC%EC%9D%B4%20%EB%9C%B0%20%EA%B1%B0%EC%95%BC%22%20%EC%A0%84%EC%A3%BC%EC%